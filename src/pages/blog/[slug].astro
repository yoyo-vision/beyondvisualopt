---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { findCategory, GUIDE_TITLES } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.slug }, props: { post, allPosts: posts } }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await post.render();

// 文內目錄：取內文的 H2／H3（Astro 已自動替標題加 id，slug 與 headings 一致）
// H2 少於 3 個的短文不顯示，避免目錄比內文還顯眼
// 「常見問題」底下的 H3 問句不列進目錄，避免目錄被一串問句撐長
let inFaq = false;
const tocHeadings = headings.filter(h => {
  if (h.depth === 2) { inFaq = h.text.includes('常見問題'); return true; }
  return h.depth === 3 && !inFaq;
});
const showToc = headings.filter(h => h.depth === 2).length >= 3;

// 參考資料：內文提到這些關鍵字就自動列出對應的官方或期刊來源（網址皆已查證過原文）
// 新增來源時只加在這裡；只有單篇用到的來源，改寫在該篇 frontmatter 的 references
const REFERENCE_SOURCES = [
  { match: ['驗光人員法'], title: '驗光人員法（全國法規資料庫）', url: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?PCode=L0020190' },
  { match: ['施行細則'], title: '驗光人員法施行細則（全國法規資料庫）', url: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=L0020194' },
  { match: ['106 年'], title: '衛生福利部國民健康署：106 年兒童青少年視力監測調查', url: 'https://www.mohw.gov.tw/dl-45478-7f230403-7349-4faf-8493-510bc3527d23.html' },
  { match: ['國健署', '3010120'], title: '衛生福利部國民健康署：視力保健', url: 'https://www.hpa.gov.tw/Pages/List.aspx?nodeid=45' },
  { match: ['JAMA'], title: 'He M, et al. Effect of Time Spent Outdoors at School on the Development of Myopia Among Children in China. JAMA. 2015', url: 'https://jamanetwork.com/journals/jama/fullarticle/2441261' },
  { match: ['吳佩昌', 'Ophthalmology》'], title: 'Wu PC, et al. Outdoor Activity during Class Recess Reduces Myopia Onset and Progression in School Children. Ophthalmology. 2013', url: 'https://pubmed.ncbi.nlm.nih.gov/23462271/' },
  { match: ['PLoS ONE'], title: 'Huang HM, et al. The Association between Near Work Activities and Myopia in Children: A Systematic Review and Meta-Analysis. PLoS ONE. 2015', url: 'https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0140419' },
  { match: ['Ophthalmic and Physiological Optics', 'Lanca'], title: 'Lanca C, Saw SM. The association between digital screen time and myopia: A systematic review. Ophthalmic Physiol Opt. 2020', url: 'https://onlinelibrary.wiley.com/doi/abs/10.1111/opo.12657' },
  { match: ['道路交通安全規則'], title: '道路交通安全規則（全國法規資料庫）', url: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=K0040013' },
  { match: ['定期審驗'], title: '交通部公路局：職業駕照定期審驗', url: 'https://www.thb.gov.tw/cp.aspx?n=548' },
];
const references = [
  ...REFERENCE_SOURCES.filter(s => s.match.some(k => post.body.includes(k))),
  ...(post.data.references ?? []),
].filter((r, i, arr) => arr.findIndex(x => x.url === r.url) === i);

// 若有英文版（blog-en 同 slug），輸出 hreflang 對應
const enPosts = await getCollection('blog-en');
const hasEn = enPosts.some(p => p.slug === post.slug);

// 主題聚落：所屬分類與完整指南一律讀 src/data/categories.ts（2026-10-17 取代舊的 PILLAR_MAP）
// 回連順序：小分類的指南 → 大分類的指南 → 沒有指南就連回大分類頁
const found = findCategory(post.slug);
const pillarHref = found ? (found.sub.guide ?? found.cat.guide ?? `/topics/${found.cat.slug}/`) : null;
const pillar = pillarHref
  ? { href: pillarHref, title: GUIDE_TITLES[pillarHref] ?? `${found!.cat.name}主題文章` }
  : null;

// 台灣時區（UTC+8）日期格式化
const formatDate = (d: Date) => {
  return d.toLocaleDateString('zh-TW', {
    timeZone: 'Asia/Taipei',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
};

// Google 要求 ISO 8601 日期格式（YYYY-MM-DD）
const isoDate = post.data.date.toISOString().split('T')[0];
// 更新日：有填 updated 用之，否則同發布日（傳達內容新鮮度給 Google/AI）
const modifiedIso = (post.data.updated ?? post.data.date).toISOString().split('T')[0];

// ── 從文章內文的「常見問題」段落自動抽取 Q&A，產生 FAQPage schema ──
// 支援兩種格式：**Q：問題**＋「A：答案」或直接接答案段落
function extractFaq(body: string) {
  // 找到「## 常見問題」標題，取到下一個 H2 標題、分隔線或文末為止
  const start = body.search(/^##[^\n]*常見問題/m);
  if (start === -1) return [];
  let section = body.slice(start);
  section = section.slice(section.indexOf('\n') + 1);
  // 停在下一個 H2 或分隔線 ---（FAQ 後面接「--- 合段」時，合段不可被算進最後一題的答案）
  const nextBreak = section.search(/^(?:## |---\s*$)/m);
  if (nextBreak !== -1) section = section.slice(0, nextBreak);

  const faqs: { q: string; a: string }[] = [];
  // 問句兩種寫法都收：粗體「**Q1：…**」與 H3「### Q1：…」（2026-10-17 起 FAQ 問句改用 H3）；題號可有可無
  const qRegex = /(?:\*\*Q\d*[：:]\s*([^\n]+?)\*\*|(?:^|\n)###\s*Q\d*[：:]\s*([^\n]+))\s*\n+([\s\S]*?)(?=\n\s*(?:\*\*Q\d*[：:]|###\s*Q\d*[：:])|$)/g;
  let m;
  while ((m = qRegex.exec(section))) {
    const answer = m[3].trim()
      .replace(/^A[：:]\s*/, '')          // 去掉 A： 前綴
      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // markdown 連結只留文字
      .replace(/\*\*/g, '')                // 去掉粗體符號
      .replace(/\s*\n+\s*/g, ' ')          // 摺疊換行
      .trim();
    if (answer) faqs.push({ q: (m[1] ?? m[2]).trim(), a: answer });
  }
  return faqs;
}
const faqs = extractFaq(post.body);

// 同標籤優先，其次其他文章，排除自己，最多 6 篇
const related = allPosts
  .filter(p => p.slug !== post.slug)
  .sort((a, b) => {
    const sameTagA = a.data.tag === post.data.tag ? 1 : 0;
    const sameTagB = b.data.tag === post.data.tag ? 1 : 0;
    return sameTagB - sameTagA;
  })
  .slice(0, 6);

const canonicalUrl = `https://beyondvisualopt.com/blog/${post.slug}/`;
const articleSchema = {
  "@type": "Article",
  "@id": canonicalUrl,
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "url": canonicalUrl,
  "headline": post.data.title,
  "description": post.data.excerpt,
  "image": post.data.image || `https://beyondvisualopt.com/images/blog/og/${post.slug}.png`,
  "inLanguage": "zh-TW",
  "articleSection": post.data.tag,
  "datePublished": isoDate,
  "dateModified": modifiedIso,
  "author": {
    "@type": "Person",
    "@id": "https://beyondvisualopt.com/author/yoyo/#person",
    "name": "鄭家侑（YoYo）",
    "alternateName": "YoYo 驗光師",
    "url": "https://beyondvisualopt.com/author/yoyo/",
    "identifier": "驗師字第 003309 號",
    "worksFor": {
      "@type": "Organization",
      "@id": "https://beyondvisualopt.com/#organization",
      "name": "能見度視覺中心 × 比泱驗光所"
    }
  },
  "publisher": {
    "@type": "Organization",
    "@id": "https://beyondvisualopt.com/#organization",
    "name": "能見度視覺中心",
    "url": "https://beyondvisualopt.com",
    "logo": "https://beyondvisualopt.com/images/logo.png"
  },
  "keywords": "多焦點鏡片,蔡司鏡片,兒童近視追蹤,高度近視眼鏡,新莊驗光,板橋驗光,能見度視覺中心,比泱驗光所,YoYo驗光師"
};

// 文章內文若有「常見問題」段落，一併輸出 FAQPage schema（AI 搜尋引擎最愛引用的格式）
const faqSchema = faqs.length > 0 ? {
  "@type": "FAQPage",
  "@id": `${canonicalUrl}#faq`,
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
} : null;

// 文章有影片時輸出 VideoObject schema（Google 影片搜尋收錄）
// 兩種來源：YouTube 用 embedUrl，自架 mp4 用 contentUrl（縮圖取 image 欄位）
const videoSchema = post.data.youtube ? {
  "@type": "VideoObject",
  "name": post.data.title,
  "description": post.data.excerpt,
  "thumbnailUrl": `https://i.ytimg.com/vi/${post.data.youtube}/hqdefault.jpg`,
  "embedUrl": `https://www.youtube.com/embed/${post.data.youtube}`,
  "uploadDate": `${isoDate}T09:00:00+08:00`,
  "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
} : post.data.video ? {
  "@type": "VideoObject",
  "name": post.data.title,
  "description": post.data.excerpt,
  "thumbnailUrl": `https://beyondvisualopt.com${post.data.image}`,
  "contentUrl": `https://beyondvisualopt.com${post.data.video}`,
  "uploadDate": `${isoDate}T09:00:00+08:00`,
  ...(post.data.videoDuration ? { "duration": `PT${Math.round(post.data.videoDuration)}S` } : {}),
  "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
} : null;

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, faqSchema, videoSchema].filter(Boolean),
};
---
<Layout
  {/* 標題策略（2026-07-27 修 CTR）：
      填了 seoTitle 就整串照用；沒填才用「原標題＋短後綴」。
      舊版一律接 28 字長後綴（YoYo 驗光師｜能見度視覺中心 × 比泱驗光所 新莊板橋驗光），
      中文 Google 大約只顯示 30 字，等於把後綴連同標題尾巴一起截掉，
      有些文章的標題本身已含「能見度視覺中心」，接上去還會重複兩次。 */}
  title={post.data.seoTitle ?? `${post.data.title}｜能見度視覺中心 新莊板橋`}
  {/* 同 seoTitle：填了 seoDescription 就用它當 meta description，沒填才退回 excerpt */}
  description={post.data.seoDescription ?? post.data.excerpt}
  schema={pageSchema}
  enPath={hasEn ? `/en/blog/${post.slug}/` : undefined}
  ogType="article"
  publishedTime={isoDate}
  modifiedTime={modifiedIso}
  image={post.data.image || `/images/blog/og/${post.slug}.png`}
>
  <div class="max-w-7xl mx-auto px-4 py-12 lg:py-16">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-14 items-start">

      <!-- ── 主文區 ── -->
      <article class="w-full lg:flex-1 min-w-0">

        <!-- 文章 header -->
        <div class="mb-8 pb-8 border-b border-gray-100">
          <nav aria-label="麵包屑" class="font-sans text-gray-400 mb-4" style="font-size:13px">
            <a href="/" class="hover:text-brand-gold">首頁</a> › <a href="/blog/" class="hover:text-brand-gold">配鏡知識</a>
            {found && (<> › <a href={`/topics/${found.cat.slug}/`} class="hover:text-brand-gold">{found.cat.name}</a> › <a href={`/topics/${found.cat.slug}/#${found.sub.slug}`} class="hover:text-brand-gold">{found.sub.name}</a></>)}
          </nav>
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-brand-light text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">{found?.cat.name ?? post.data.tag}</span>
            <span class="text-gray-400 text-sm">{formatDate(post.data.date)} · <a href="/author/yoyo/" class="hover:text-brand-gold transition-colors underline decoration-dotted underline-offset-2">YoYo 驗光師</a></span>
          </div>
          <h1 class="font-serif text-brand-navy leading-tight mb-5" style="font-size:clamp(26px,4vw,38px);font-weight:700;line-height:1.3">{post.data.title}</h1>
          <p class="text-gray-500 leading-relaxed" style="font-size:17px;line-height:1.8">{post.data.excerpt}</p>
        </div>

        <!-- 封面圖（首屏 LCP 元素：eager + 高優先，並帶尺寸避免版面位移 CLS） -->
        {/* 2026-10-27 老闆指示：每篇文章都要有封面。沒有實拍封面的，用 OG 文字卡（1200×630）完整顯示不裁切 */}
        {post.data.image ? (
          <img src={post.data.image} alt={`${post.data.title}｜能見度視覺中心 YoYo 驗光師`}
            width="800" height="256" loading="eager" fetchpriority="high"
            class="w-full h-64 object-cover rounded-2xl mb-10" />
        ) : (
          <img src={`/images/blog/og/${post.slug}.png`} alt={`${post.data.title}｜能見度視覺中心 YoYo 驗光師`}
            width="1200" height="630" loading="eager" fetchpriority="high"
            class="w-full h-auto rounded-2xl mb-10" />
        )}

        <!-- YouTube（延遲載入，避免第三方 iframe 拖累 Core Web Vitals） -->
        {post.data.youtube && (
          <!-- 目前頻道影片皆為直式 Shorts（9:16），置中窄版呈現避免左右黑邊 -->
          <div class="mb-10 rounded-2xl overflow-hidden mx-auto max-w-[320px]" style="aspect-ratio:9/16">
            <iframe
              src={`https://www.youtube.com/embed/${post.data.youtube}`}
              title={post.data.title}
              class="w-full h-full"
              frameborder="0"
              {/* 2026-07-27：拿掉 loading="lazy"。GSC 回報 6 篇「影片不在觀賞頁面上」，
                  尺寸（320×569，符合 140–1080 寬／≥140 高）與位置（正文上方、無遮蓋）都合格，
                  延遲載入是唯一可疑的技術點——爬蟲若在 iframe 尚未載入時取頁面，就偵測不到影片。
                  影片只出現在 6 篇文章、且位於首屏，改為立即載入對效能影響有限。 */}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        )}

        <!-- 所屬完整指南（topic cluster 回鏈） -->
        {pillar && (
          <a href={pillar.href} class="flex items-center gap-3 bg-brand-light border border-brand-gold/30 rounded-2xl px-6 py-4 mb-10 hover:border-brand-gold transition-colors group">
            <span style="font-size:20px">📚</span>
            <span class="text-brand-navy" style="font-size:15px">本文屬於<strong class="group-hover:text-brand-gold transition-colors">《{pillar.title}》</strong>——一頁看懂全部重點 →</span>
          </a>
        )}

        <!-- 文內目錄：用 <p> 當標籤而不是 <h2>，避免多出一個與內容無關的標題干擾 H1～H6 結構 -->
        {showToc && (
          <nav aria-label="文章目錄" class="toc mb-10 rounded-2xl border border-gray-200 px-6 py-5">
            <p class="text-brand-navy font-bold mb-3" style="font-size:15px">目錄</p>
            <ol class="toc-list">
              {tocHeadings.map(h => (
                <li class={h.depth === 3 ? 'toc-sub' : 'toc-main'}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <!-- 文章內文 -->
        <div class="article-body">
          <Content />
        </div>

        <!-- 作者框（E-E-A-T）：資歷文字沿用作者頁已過法務的寫法 -->
        <div class="mt-12 flex gap-5 items-start rounded-2xl border border-gray-200 p-6">
          <img src="/images/yoyo-optometrist.webp" alt="鄭家侑 YoYo 驗光師"
            width="72" height="72" loading="lazy" class="w-18 h-18 rounded-full object-cover shrink-0" style="width:72px;height:72px" />
          <div>
            <p class="text-xs text-gray-400 mb-1">本文作者</p>
            <p class="text-brand-navy font-bold mb-1" style="font-size:17px">鄭家侑（YoYo）驗光師</p>
            <p class="text-gray-500 mb-2" style="font-size:13px">驗師字第 003309 號｜元培醫事科技大學畢業｜新北市驗光師公會講師</p>
            <p class="text-gray-600 mb-3" style="font-size:14px;line-height:1.75">能見度視覺中心 × 比泱驗光所主理驗光師，專精臨床驗光、雙眼視覺評估、多焦點鏡片驗配與兒童近視追蹤。本站文章皆由 YoYo 驗光師撰寫或審閱，內容依據臨床驗光實務與光學原理。</p>
            <a href="/author/yoyo/" class="text-brand-navy font-semibold hover:text-brand-gold transition-colors" style="font-size:14px">認識 YoYo 驗光師 →</a>
          </div>
        </div>

        <!-- 參考資料：內文有引用法規、官方調查或期刊才顯示 -->
        {references.length > 0 && (
          <div class="mt-8 rounded-2xl bg-gray-50 px-6 py-5">
            <p class="text-brand-navy font-bold mb-3" style="font-size:15px">參考資料</p>
            <ol class="list-decimal pl-5 space-y-2" style="font-size:13px;line-height:1.7">
              {references.map(r => (
                <li class="text-gray-600"><a href={r.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-gold underline decoration-dotted underline-offset-2">{r.title}</a></li>
              ))}
            </ol>
          </div>
        )}

        <!-- Instagram -->
        {post.data.instagram && (
          <div class="mt-10 p-6 bg-brand-light rounded-2xl text-center">
            <p class="text-sm text-gray-500 mb-3">📸 追蹤我們的 Instagram</p>
            <a href={post.data.instagram} target="_blank" rel="noopener noreferrer"
              class="text-brand-navy font-semibold hover:text-brand-gold transition-colors">
              查看 Instagram 貼文 →
            </a>
          </div>
        )}

        <!-- CTA -->
        <div class="mt-12 bg-brand-navy text-white rounded-2xl p-8 text-center">
          <h2 class="text-xl font-bold mb-3">還有問題？歡迎預約驗光人員</h2>
          <p class="text-gray-300 mb-6" style="font-size:15px">能見度視覺中心（新莊比泱驗光所 × 板橋能見度驗光所）｜新北市新莊・板橋驗光所，持照驗光人員完整驗光</p>
          <a href="/booking/" class="bg-brand-gold text-brand-navy font-bold px-6 py-3 rounded-full hover:bg-brand-gold/90 transition-colors inline-block">
            查看可約時段 →
          </a>
        </div>

        <div class="mt-10 text-center">
          <a href="/blog/" class="text-brand-navy font-semibold hover:underline text-sm">← 回到視覺小知識</a>
        </div>
      </article>

      <!-- ── 右側欄 ── -->
      <aside class="w-full lg:w-72 xl:w-80 shrink-0 lg:sticky lg:top-24">

        <!-- 相關話題 -->
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden mb-6">
          <div class="bg-brand-navy text-white px-5 py-3">
            <h3 class="font-bold text-sm tracking-wide">相關話題文章</h3>
          </div>
          <ul class="divide-y divide-gray-100">
            {related.map(p => (
              <li>
                <a href={`/blog/${p.slug}/`}
                  class="flex items-start gap-3 px-5 py-4 hover:bg-brand-light transition-colors group">
                  <span class="text-brand-gold mt-0.5 shrink-0 text-sm">▶</span>
                  <div class="min-w-0">
                    <p class="text-brand-navy text-sm font-medium leading-snug group-hover:text-brand-gold transition-colors line-clamp-2">{p.data.title}</p>
                    <span class="text-gray-400 text-xs mt-1 block">{p.data.tag}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 快速諮詢 -->
        <div class="bg-brand-light rounded-2xl p-5 mb-6">
          <p class="text-brand-navy font-bold text-sm mb-2">🔬 視覺諮詢</p>
