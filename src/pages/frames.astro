---
import Layout from '../layouts/Layout.astro';

// 2026-10-23 改版（規劃書 6-1）：H1 帶在地＋鏡框品牌；鏡框品牌放前面、鏡片品牌縮成一段放後面；
// 刪「不可取代」「正貨」「精通」「視野穩定…著稱」「高性價比」「確保…完整發揮」；選框表刪「-6.00D 配 1.74」與「≥ 28mm」；
// FAQ 收斂：「自帶精品框可以配嗎」「Lindberg 壞了可以修嗎」與 luxury-frame-lens-guide FAQ 同題、「鏡架多久調一次」與 /services/adjustment/ 同題，三題刪除改導連結；
// 經銷事實（老闆 10-23）：12 牌經銷，MINAMOTO 源只在新莊店，其他 11 牌兩店都有；產地只寫已確認的 MINAMOTO（鯖江製）、Polaris（台灣）、Sanjiaoti（深圳）

// 經銷鏡框品牌（分三組；不標未確認的產地）
const brandGroups = [
  {
    title: '國際品牌',
    stores: '新莊・板橋',
    names: ['Ray-Ban', 'OLIVER PEOPLES', 'EMPORIO ARMANI', 'BVLGARI', 'agnès b.'],
    desc: 'Ray-Ban 的經典款、OLIVER PEOPLES 的復古線條、EMPORIO ARMANI 與 BVLGARI 的俐落精緻，到 agnès b. 的法式簡約。五個品牌兩店都擺著。',
  },
  {
    title: 'MINAMOTO 源',
    stores: '新莊店',
    names: ['MINAMOTO 源'],
    desc: '日本鯖江製作的純鈦鏡框，鉸鏈不用螺絲。MINAMOTO 源只在新莊店，要摸實品得跑一趟新莊。',
    links: [
      { href: '/blog/minamoto-eyewear-brand/', t: 'MINAMOTO 源是什麼品牌？' },
      { href: '/blog/sabae-eyewear/', t: '鯖江眼鏡是什麼？' },
    ],
  },
  {
    title: '更多經銷品牌',
    stores: '新莊・板橋',
    names: ['MASAKI MATSUSHIMA', 'Polaris', 'Maji', 'Orient', 'STEEPER', 'Sanjiaoti'],
    desc: 'MASAKI MATSUSHIMA 帶著日本設計師的時尚語彙；Polaris 是台灣品牌，Sanjiaoti 是深圳品牌。這六個品牌兩店都有，輕量、商務、日常的款式都找得到。',
  },
];

// 依需求挑鏡框（刪「-6.00D 就配 1.74」#8、「≥ 28mm」#23；過敏列帶皮膚科提醒）
const selectionGuide = [
  { need: '度數深（高度近視）', recommendation: '寬度合臉的前提下，框選小一點', reason: '近視鏡片邊緣厚，框越寬，留在框裡的鏡片邊越厚' },
  { need: '鼻樑、耳朵容易被壓', recommendation: '純鈦或輕量鏡框，搭可調鼻托', reason: '框輕，落在鼻樑和耳朵上的重量就少；鼻托能依鼻型調' },
  { need: '想要辨識度高的造型', recommendation: 'OLIVER PEOPLES、EMPORIO ARMANI 等設計師款', reason: '款式和線條的選擇多' },
  { need: '配漸進多焦點', recommendation: '上下夠深的鏡框', reason: '看近的那一段在鏡片最下方，框太淺就被裁掉' },
  { need: '戴金屬框皮膚會有反應', recommendation: '純鈦或醋酸纖維板材', reason: '純鈦不含鎳，過敏風險較低；皮膚反應持續，請給皮膚科醫師看' },
  { need: '打球、跑步時戴', recommendation: '運動框、可調鼻托，需要時加運動綁帶', reason: '跑跳時框不能晃；弧度包得深的框，裝度數鏡片之前先評估' },
];

// FAQ：畫面與 schema 共用同一個陣列（#31）；原「蔡司鏡片一定要配蔡司鏡架嗎」撞 zeiss-individual-worth-it FAQ，國文編審 10-23 換成精品鏡架買不買得到；全站 FAQPage grep 過，不跟鏡框 13 篇、/guide/frames/、/services/adjustment/ 撞題
const faqs = [
  {
    q: '高度近視適合選哪種鏡框？',
    a: '寬度要先合臉，在這個前提下，挑小一點、鏡圈不要太寬的框。近視鏡片越往外越厚，鏡圈開得大，那一圈厚邊就整個留在框裡，重量也跟著上來。兩個鏡圈中心的距離（框心距）要是跟瞳距對不上，外側還會再多厚一點。框寬和折射率在實際度數下怎麼搭，〈高度近視要選蔡司還是 HOYA？〉那篇把厚度推算過一遍；到門市，度數和臉寬我們會擺在一起挑。',
  },
  {
    q: '新莊店和板橋店的鏡框品牌一樣嗎？',
    a: '12 個經銷品牌裡，有 11 個是新莊、板橋兩店都擺的。MINAMOTO 源只在新莊店。想看某個品牌的特定款式，出門前先打電話問那間店。',
  },
  {
    q: 'Lindberg、Cartier 這類精品鏡架，在能見度買得到嗎？',
    a: '買不到。Lindberg、ic! berlin、Götti、Cartier、Chrome Hearts、Linda Farrow 都不在經銷名單上，能見度不是這些品牌的代理門市。這類鏡架帶來，我們接調整、維修，也可以配上度數鏡片；能不能做，要看過框況才知道。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
    },
  ],
};
---
<Layout
  title="鏡框品牌｜Ray-Ban・OLIVER PEOPLES・BVLGARI・MINAMOTO 源｜能見度視覺中心｜新莊板橋"
  description="Ray-Ban、OLIVER PEOPLES、BVLGARI、agnès b.、MINAMOTO 源等 12 個鏡框品牌經銷；Lindberg、Cartier 等精品鏡架提供調整維修與自帶框配鏡（非代理）。能見度視覺中心新莊、板橋門市。"
  enPath="/en/frames/"
  schema={schema}
>
  <!-- Hero：H1 帶在地＋鏡框品牌（刪「不可取代」#7） -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-20 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="font-serif text-white leading-tight mb-6" style="font-size:clamp(28px,4.5vw,46px);font-weight:300">新莊、板橋可以試戴哪些鏡框品牌？</h1>
      <p class="text-white/70 mx-auto" style="font-size:17px;line-height:1.85">能見度經銷 12 個鏡框品牌，11 個兩店都有，MINAMOTO 源在新莊店。挑框時，尺寸和度數先過一輪，合適的幾副挑出來，風格再由你決定。</p>
      <p class="text-brand-gold mt-5" style="font-size:14px;letter-spacing:0.08em">蔡司 ZEISS 簽約認證經銷・HOYA 經銷｜能見度視覺中心 新莊 × 板橋</p>
    </div>
  </section>

  <!-- 經銷鏡框品牌（原兩張鏡框卡合成一節；刪「正貨」#7；產地依老闆 10-23 #3） -->
  <section class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">能見度經銷的鏡框品牌</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">除了下面這些經銷品牌，門市也擺了兒童鏡框、運動框，還有運動綁帶。</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {brandGroups.map(g => (
          <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
            <span class="font-sans text-brand-gold font-semibold tracking-widest mb-3" style="font-size:12px;letter-spacing:0.16em">{g.stores}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{g.title}</h3>
            <p class="text-brand-ink-3 mb-4 flex-1" style="font-size:15px;line-height:1.75">{g.desc}</p>
            {g.links && (
              <div class="mb-4 space-y-1">
                {g.links.map(l => <a href={l.href} class="block font-sans text-brand-gold hover:text-brand-navy transition-colors" style="font-size:14px">{l.t} →</a>)}
              </div>
            )}
            <div class="pt-4 border-t border-brand-ink/8 flex flex-wrap gap-2">
              {g.names.map(n => (
                <span class="text-xs bg-brand-paper border border-brand-ink/10 text-brand-ink-2 px-2 py-1 rounded-full">{n}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">兒童鏡框怎麼挑，見<a href="/blog/children-frames-guide/" class="text-brand-gold underline">兒童鏡架怎麼選？</a>；運動時戴的框，鼻托和綁帶怎麼挑，看<a href="/blog/sports-glasses/" class="text-brand-gold underline">運動眼鏡怎麼配？</a>。</p>
    </div>
  </section>

  <!-- 精品鏡架（非代理；刪「精通」#4；互搶 D：配鏡與維修細節歸 luxury-frame-lens-guide） -->
  <section class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">精品鏡架調整、維修與自帶框配鏡（非代理）</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>Lindberg、ic! berlin、Götti、Cartier、Chrome Hearts、Linda Farrow 不在我們的經銷名單裡。能見度不是這些品牌的代理門市，接的是這類鏡架的調整、維修，以及你自己帶框來配鏡片。</p>
        <p>無螺絲結構、彈片扣合，還有精品框各自的鎖點，動起工具來跟一般框是兩套做法。家裡收著的精品框能不能裝度數鏡片、壞了能不能修、動工前先看哪些框況，都在<a href="/blog/luxury-frame-lens-guide/" class="text-brand-gold underline">精品框配鏡與維修</a>裡。自帶框的加工費跟著框型走，動工前先報價；框是哪裡買的，不會讓同一種框型多收一筆。破損風險怎麼處理，<a href="/guide/byo-frame-lenses/" class="text-brand-gold underline">自帶鏡框配鏡片完整指南</a>也講到了。</p>
      </div>
    </div>
  </section>

  <!-- 鏡架調整（原「精密鏡架調整服務」卡縮一段；互搶 C：頻率與收費正主是 /services/adjustment/） -->
  <section class="px-6 md:px-16 py-20" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡架調整與維修</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>鼻托塌了、前傾角跑掉、腳架鬆了，眼鏡不管在哪裡配的，都可以拿來讓我們看看。在能見度配的眼鏡，取件後的鏡架調整不另外收費；零件與非本店配的眼鏡，費用個別討論。新莊、板橋任一間配的眼鏡，另一間也能調。</p>
        <p>什麼時候該回來調，<a href="/services/adjustment/" class="text-brand-gold underline">眼鏡調整與維修</a>列了五個訊號。鼻墊掉了、鏡腳斷了，先翻<a href="/blog/glasses-repair/" class="text-brand-gold underline">眼鏡壞了能修嗎？</a>。</p>
      </div>
    </div>
  </section>

  <!-- 搭配的鏡片品牌（原兩張鏡片卡縮成一段；刪「視野穩定…著稱」「高性價比」#5） -->
  <section class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">搭配的鏡片品牌：蔡司 ZEISS、HOYA</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>鏡片部分，能見度是蔡司 ZEISS 簽約認證經銷、HOYA 經銷，新莊、板橋兩店都能訂，個人化訂製鏡片也是。個人化訂製要用到頂點距離、前傾角、面彎角和配鏡高度，量的時候，你挑的那支框要戴在臉上。</p>
        <p>中文品名與折射率規格，以<a href="/lenses/" class="text-brand-gold underline">鏡片系列品名一覽</a>為準。設計等級、折射率、鍍膜和品牌哪個先定，去讀<a href="/guide/lens-brands/" class="text-brand-gold underline">鏡片怎麼選？</a>。</p>
      </div>
    </div>
  </section>

  <!-- 依需求挑鏡框 -->
  <section class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">依需求挑鏡框</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">從你的需求開始挑，品牌放後面。</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">你的需求</th>
              <th class="text-left px-5 py-4 font-semibold">建議方向</th>
              <th class="text-left px-5 py-4 font-semibold">原因</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2 bg-white">
            {selectionGuide.map(row => (
              <tr class="border-b border-brand-ink/8">
                <td class="px-5 py-4 align-top font-semibold text-brand-navy">{row.need}</td>
                <td class="px-5 py-4 align-top">{row.recommendation}</td>
                <td class="px-5 py-4 align-top text-brand-ink-3">{row.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">表格只抓得到方向。尺寸、臉型、材質一步一步怎麼挑，接著讀<a href="/guide/frames/" class="text-brand-gold underline">鏡框怎麼挑才戴得久？</a>。</p>
    </div>
  </section>

  <!-- FAQ（H3＋「Q：」；schema 由同一陣列產生 #31） -->
  <section class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-10" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡框品牌常見問題</h2>
      <div class="space-y-8">
        {faqs.map(f => (
          <div class="border-b border-brand-ink/8 pb-8">
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">Q：{f.q}</h3>
            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA（按鈕改「預約視覺諮詢」#30） -->
  <section class="px-6 py-20 text-center" style="background:#1a2f4e">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,34px);font-weight:300">看中的品牌，到門市戴上臉再決定</h2>
      <p class="text-white/60 mb-8" style="font-size:16px;line-height:1.8">驗光人員看過度數、量過臉寬，會拿幾副給你戴戴看。新莊、板橋兩店都接預約。</p>
      <a href="/booking/" class="inline-block bg-brand-gold text-brand-navy font-bold px-8 py-3.5 rounded-full hover:bg-brand-gold/90 transition-colors font-sans" style="font-size:15px">預約視覺諮詢 →</a>
    </div>
  </section>
</Layout>
