          ))}
          <a href="/en/guide/byo-frame-lenses/" class="rounded-2xl p-7 border border-brand-gold/40 hover:border-brand-gold transition-colors group" style="background:#eee8da">
            <span class="bg-brand-gold text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">Complete Guide</span>
