---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../data/categories';

// 2026-10-23 同步中文版改版（規劃書 5-1）：H1／title／schema／FAQ／E-E-A-T／聚落讀取；內文全文重譯另排
// 聚落：讀分類表「鏡片」4 個小分類，與中文版同序；英文版取 blog-en 集合，尚未翻譯的文章由 .filter(Boolean) 濾掉，空組不顯示
const SUB_NAMES_EN: Record<string, string> = {
  brands: 'Lens brands',
  index: 'Refractive index & thickness',
  coating: 'Lens design & coatings',
  buying: 'Buying & pricing',
};
const LENSES = CATEGORIES.find(c => c.slug === 'lenses')!;
const allPosts = await getCollection('blog-en');
const clusterGroups = LENSES.subs
  .map(s => ({
    name: SUB_NAMES_EN[s.slug] ?? s.slug,
    posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
  }))
  .filter(g => g.posts.length > 0);
// 分類外延伸卡（與中文版同；英文版只列 blog-en 已有的篇）
const EXTRA_SLUGS = ['zeiss-individual-worth-it', 'progressive-corridor-brands', 'high-myopia-lens-brand-choice'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/en/guide/lens-brands/';

// 指南頁 FAQ：與中文版同四題（原四題撞聚落文或含無出處門檻、垂直整合等句，已換）
const faqs = [
  {
    q: 'Should I choose the lens brand first, or the design tier?',
    a: 'The design tier first. Between standard, digitally optimized and personalized custom designs, the gap from one tier to the next is often larger than the gap between brands within the same tier. So we set the tier first, based on your prescription and the distances you use your eyes at through the day, and only then compare lenses of the same tier side by side. That is when a comparison tells you something about the brand. Beyond Visual carries ZEISS (as a contracted, certified dealer) and HOYA, so both brands can be compared within the same tier.',
  },
  {
    q: 'If I can only upgrade one of design, refractive index or coating, which should it be?',
    a: 'Start with whatever bothers you most. If the lens edges look thick or the glasses feel heavy, check first whether the frame is on the large side; only once the frame size is right does refractive index come in, and a higher index also reflects more light, so look at an anti-reflective coating at the same time. Distortion when you look to the side, or an intermediate zone on a progressive lens that feels too narrow for the computer, is a design matter. Reflections, smudges that won\'t wipe off and scratches are a coating matter. Upgrade the one that matches. If none of the three bothers you, staying at your current tier is fine too.',
  },
  {
    q: 'What should I think about before choosing lenses in store?',
    a: 'Think about the distances your eyes work at during a day: how long you drive, how long you are on a computer, how long you read or look at your phone, whether you drive at night, and whether you work outdoors. Bring the glasses you wear now and tell us what feels right and what doesn\'t. This tells our licensed optometry staff more about which lens suits you than deciding on a brand in advance.',
  },
  {
    q: 'Can I look at lens samples before deciding?',
    a: 'Yes. Our stores keep samples of blue-light filtering lenses and glass lenses, so you can hold them, check the tint, tilt them to see the reflection, and compare their weight with resin lenses. We do not currently carry anti-fog lenses. Differences between design tiers can\'t be seen by holding a lens; they show when you wear it and look through it, so our licensed optometry staff explain that part based on your prescription and viewing distances.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "How to Choose Eyeglass Lenses: Design Tier First, Then Refractive Index and Coatings, Brand Last",
      "dateModified": "2026-10-23",
      "description": "How to choose eyeglass lenses: settle the design tier first (standard, digitally optimized or personalized custom), choose the refractive index by prescription and coatings by daily habits, and compare brands last. Optometrist YoYo sets out the order. Beyond Visual is a contracted ZEISS dealer and a HOYA dealer, with stores in Xinzhuang and Banqiao.",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "en",
      "articleSection": "Complete Guides",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "Cheng Chia-Yu (YoYo)",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="How to Choose Eyeglass Lenses | ZEISS & HOYA Lenses, Refractive Index, Coatings | Xinzhuang & Banqiao"
  description="How to choose eyeglass lenses: design tier first, then refractive index and coatings, brand last. Optometrist YoYo explains standard, digitally optimized and personalized designs, and where 1.60, 1.67 and 1.74 fit. Contracted ZEISS dealer and HOYA dealer — Xinzhuang & Banqiao, Beyond Visual Optometry."
  lang="en"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">Complete Guide</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        How to Choose Eyeglass Lenses<br /><span class="text-brand-gold" style="font-size:0.6em">Design tier first, then refractive index and coatings, brand last</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        Within a single brand, lenses run from entry level to personalized custom, several tiers apart; the same refractive index can come in completely different designs. This page puts the four decisions in choosing a lens in order. Written by Optometrist YoYo.
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">Quick Takeaways</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Beyond Visual is a contracted, certified ZEISS dealer and a HOYA dealer. We do not carry or order NIKON or Essilor lenses, but we can help you compare them.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>The gap between design tiers within one brand is often larger than the gap between brands, so settle the tier first and compare brands after.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Refractive index governs lens thickness and weight; a higher number does not mean sharper vision.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Coatings govern reflections, how easily the lens cleans and how well it resists scratches.</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: 'Where Brands Differ', href: '#difference' },
        { label: 'Brands at Beyond Visual', href: '#compare' },
        { label: 'How to Choose by Need', href: '#choose' },
        { label: 'Tier Beats Brand', href: '#levels' },
        { label: 'The Frame Sets the Limits', href: '#frame' },
        { label: 'FAQ', href: '#faq' },
        { label: 'Author & Sources', href: '#author' },
        { label: 'Articles', href: '#cluster' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 品牌差在哪 -->
  <section id="difference" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">What differs between lens brands isn't the logo — it's these three things</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>Many people assume the difference between lens brands is just "how big the name is" or "where it's made." In reality, when two quotes for progressive lenses are far apart, the gap comes from three levels you can't see:</p>
        <p><strong>One: optical design capability.</strong> A progressive lens inevitably has aberration zones on either side of the corridor, where the view is distorted and blurry. Design tiers differ in how those zones are laid out and how the clear field is distributed. Each manufacturer takes its own optical approach to this.</p>
        <p><strong>Two: coating technology.</strong> Anti-reflective, scratch-resistant, anti-smudge, and blue-light filtering directly affect a lens's clarity and service life. This is the part most easily overlooked when choosing a lens, yet felt every day.</p>
        <p><strong>Three: personalized custom capability.</strong> Whether your vertex distance, pantoscopic tilt, face-form angle and fitting height are factored into the calculation, so the optical design is tailored to how the frame sits on your face. For someone facing a screen ten hours a day, it comes down to which zone of the lens the screen distance falls into, and how wide that zone is.</p>
      </div>
    </div>
  </section>

  <!-- 四大品牌比較 -->
  <section id="compare" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">ZEISS, HOYA, NIKON, Essilor: how to get them at Beyond Visual</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">We carry <a href="https://www.zeiss.com.tw/" target="_blank" rel="noopener noreferrer" class="text-brand-gold underline">ZEISS</a> and HOYA: ZEISS as a contracted, certified dealer, HOYA as a dealer. We do not carry or order NIKON or Essilor lenses; what we can do is help you compare them.</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">Brand</th>
              <th class="text-left px-5 py-4 font-semibold">Origins</th>
              <th class="text-left px-5 py-4 font-semibold">At Beyond Visual</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['ZEISS (Germany)', '1846; microscopes and precision optical instruments', 'Contracted, certified dealer; available at both Xinzhuang and Banqiao'],
              ['HOYA (Japan)', '1941; optical glass', 'Dealer; available at both stores'],
              ['NIKON (Japan)', 'Cameras and optics; the eyeglass-lens business is run by Nikon-Essilor, jointly owned by Nikon and Essilor (per the manufacturer\'s public information)', 'Not carried or ordered; comparison consultation only'],
              ['Essilor (France)', '1849; lenses as its core business', 'Not carried or ordered; comparison consultation only'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy whitespace-nowrap' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 怎麼依需求選 -->
  <section id="choose" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">How to choose by your needs? First see which box you fall into</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">The brand isn't the point — first confirm your viewing scenario, then match it back to a suitable series.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { need: 'Progressive / Presbyopia', desc: 'Need clarity at far, intermediate, and near without constantly swapping glasses. Progressive lenses also come in tiers from entry to personalized custom — confirm how your daily viewing distances are spread before choosing.' },
          { need: 'High Myopia / High Astigmatism', desc: 'The higher the prescription, the more the lens-to-eye distance and the forward tilt of the frame change the power your eye actually receives, so these fitting parameters are factored in when the lens is ordered. Refractive index is discussed at the same time.' },
          { need: 'All-Day Screen Use', desc: "On screens and phones all day, but no need for reading glasses yet. Consider single-vision lenses with a near-addition design: a small amount of plus power is added to the lower part of the lens, so your eyes work a little less up close, and the lens looks the same as a regular single-vision lens. The ZEISS and HOYA lines we carry both include this type of design." },
          { need: 'Limited Budget / Simple Prescription', desc: 'For a low prescription without much astigmatism, a standard-design single-vision lens corrects your vision well. Here the budget is better spent on a full vision exam and frame adjustment than on a higher tier.' },
        ].map(item => (
          <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
            <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">By Need</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{item.need}</h3>
            <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        Optometrist YoYo's principle: first analyze how your viewing distances are spread across a day (how many hours driving, how many on screens, how far your reading distance is), then decide on the tier and brand — not decide on a product first and then talk you into it.
      </blockquote>
    </div>
  </section>

  <!-- 等級比品牌更關鍵（深藍區段） -->
  <section id="levels" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">The lens "tier" matters more than the "brand"</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">The gap between different series within one brand is often larger than the gap between brands. What differs between tiers is how the power is distributed across the lens surface, and whether the calculation uses average values or your own measurements.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { level: 'Standard Design', desc: 'Designed around one set of average fitting parameters: how far the frame sits from the eye and how far it tilts forward are assumed to be the same for everyone. Enough for simple prescriptions and fairly constant viewing distances.', fit: 'Entry' },
          { level: 'Digitally Optimized Design', desc: 'The curvature at each point of the lens surface is calculated for your prescription, so the periphery of a single-vision lens, or the corridor and side zones of a progressive, are laid out for your power.', fit: 'Mainstream' },
          { level: 'Personalized Custom', desc: 'Beyond your prescription, four measurements taken with your chosen frame on are factored in: vertex distance, pantoscopic tilt, face-form angle and fitting height. Both stores take personalized custom orders; ZEISS Individual² belongs to this tier.', fit: 'Custom' },
        ].map(item => (
          <div class="bg-white/5 rounded-2xl p-7 border border-white/10 flex flex-col">
            <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">{item.fit}</span>
            <h3 class="font-serif text-white mb-3" style="font-size:19px;font-weight:600">{item.level}</h3>
            <p class="text-white/60" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-white/70 mt-8" style="font-size:16px;line-height:1.8">
        When personalized custom is worth it, and when it isn't: <a href="/en/blog/zeiss-individual-worth-it/" class="text-brand-gold underline">Are ZEISS Personalized Custom Lenses Worth It? A Full Analysis of Cost, Difference, and Who Benefits</a>
      </p>
    </div>
  </section>

  <!-- 轉：鏡框先決定了鏡片能做到哪（與中文版 #frame 同步；英文 blog 只有 progressive-corridor，其餘不連） -->
  <section id="frame" class="px-6 md:px-16 py-20" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">The frame decides what the lens can do</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>By this point the four decisions are in order: design, refractive index, coatings, brand. It is easy to think the lens is now chosen. But all four still have to fit into a frame. The moment a frame is picked, part of the outcome is already fixed: how thin the lens can get, how long a progressive corridor can be, which materials can be used. Whatever you choose for the other four, you are choosing within the room the frame leaves.</p>
        <ul class="space-y-3 pl-1">
          <li class="flex items-start gap-3"><span class="text-brand-gold mt-1 shrink-0" style="font-size:12px">●</span><span>A large frame means thick edges. A myopic lens is thin in the middle and thicker towards the edge, and the larger the frame, the more of that outer ring stays in the frame. At the same -7.00D, a 50 mm frame with a 1.67 lens may well look slimmer from the side than a 56 mm frame with a 1.74 lens; moving up one index step does not make up for the extra thickness of a frame one size larger.</span></li>
          <li class="flex items-start gap-3"><span class="text-brand-gold mt-1 shrink-0" style="font-size:12px">●</span><span>A shallow frame leaves no room for a long corridor. A progressive lens runs from distance at the top through intermediate to near at the bottom. If the frame is not tall enough, a shorter corridor has to be used, where the power changes more quickly and the blur at the sides is more noticeable. The trade-offs are set out in <a href="/en/blog/progressive-corridor/" class="text-brand-gold underline">What Is the 'Corridor' in Progressive Multifocal Lenses?</a></span></li>
          <li class="flex items-start gap-3"><span class="text-brand-gold mt-1 shrink-0" style="font-size:12px">●</span><span>Rimless and semi-rimless frames narrow the material choice. A rimless frame is drilled through the lens, so the lens itself holds the glasses together; a semi-rimless frame needs a groove cut into the lens edge. Tougher materials cope better with the stress around the drill holes, regular resin and high-index lenses leave less margin for error, and glass is not suited to drilling. A 1.74 lens in a rimless frame needs to be assessed before ordering.</span></li>
        </ul>
        <p>So when you actually sit down to order, the steps interleave. Settle the direction of the design first, such as whether this pair will be progressive, and take that into frame selection; once the frame is chosen, the refractive index falls within what it can hold, and the coatings follow how you use your glasses. Choose the frame with the lens already in mind.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-10" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Choosing lenses: frequently asked questions</h2>
      <div class="space-y-8">
        {faqs.map(f => (
          <div class="border-b border-brand-ink/8 pb-8">
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">Q: {f.q}</h3>
            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 關於作者與資料來源（E-E-A-T）：資歷文字沿用 /en/guide/byo-frame-lenses/ 已審版本，照片用現有門市實拍 -->
  <section id="author" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">About the author and sources</h2>
      <div class="flex gap-5 items-start bg-white rounded-2xl border border-brand-ink/10 p-6 mb-8">
        <img src="/images/yoyo-optometrist.webp" alt="Optometrist YoYo (Cheng Chia-Yu)" width="72" height="72" loading="lazy" class="rounded-full object-cover shrink-0" style="width:72px;height:72px" />
        <div>
          <p class="text-brand-navy font-bold mb-1" style="font-size:17px">YoYo (Cheng Chia-Yu), Optometrist</p>
          <p class="text-brand-ink-3 mb-2" style="font-size:13px">Optometrist License No. 003309 | Graduate of Yuanpei University of Medical Technology | Lecturer, New Taipei City Optometrists Association</p>
          <p class="text-brand-ink-2 mb-3" style="font-size:15px;line-height:1.75">Lead optometrist at Beyond Visual Optometry × BiYang Optometry Clinic, specializing in clinical vision exams, binocular vision assessment, progressive lens fitting and children's myopia tracking.</p>
          <a href="/en/author/yoyo/" class="text-brand-navy font-semibold hover:text-brand-gold transition-colors" style="font-size:14px">Meet Optometrist YoYo →</a>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
        <figure>
          <img src="/images/store-xinzhuang-exam-room.webp" alt="Exam room, Beyond Visual Xinzhuang store" width="1200" height="900" loading="lazy" class="w-full rounded-xl object-cover" style="aspect-ratio:4/3" />
          <figcaption class="text-brand-ink-3 mt-2" style="font-size:13px">Xinzhuang store exam room</figcaption>
        </figure>
        <figure>
          <img src="/images/instrument-phoropter.webp" alt="TOPCON phoropter, BiYang Optometry Clinic Xinzhuang" width="1200" height="900" loading="lazy" class="w-full rounded-xl object-cover" style="aspect-ratio:4/3" />
          <figcaption class="text-brand-ink-3 mt-2" style="font-size:13px">Phoropter: the prescription comes before the lens choice</figcaption>
        </figure>
        <figure>
          <img src="/images/yoyo-adjusting-glasses.webp" alt="Licensed optometry staff adjusting a frame before taking fitting measurements, Beyond Visual Xinzhuang" width="900" height="1200" loading="lazy" class="w-full rounded-xl object-cover" style="aspect-ratio:4/3" />
          <figcaption class="text-brand-ink-3 mt-2" style="font-size:13px">The frame is adjusted before personalized fitting measurements are taken</figcaption>
        </figure>
      </div>
      <p class="text-brand-navy font-bold mb-3" style="font-size:15px">Sources</p>
      <ol class="list-decimal pl-5 space-y-2 mb-6" style="font-size:14px;line-height:1.7">
        {[
          { t: 'ZEISS Vision Care Taiwan (official website, in Chinese)', u: 'https://www.zeiss.com.tw/vision-care/home.html' },
          { t: 'HOYA Vision Care Taiwan (official website, in Chinese)', u: 'https://www.hoyavision.com/tw/' },
          { t: 'Nikon-Essilor: officers and shareholders (in Japanese; shareholders and Essilor founding year)', u: 'https://www.nikon-essilor.co.jp/company/officers' },
          { t: 'Beyond Visual: ZEISS and HOYA lens series (2026 product names and refractive indices)', u: '/en/lenses/' },
          { t: 'Fresnel equations (surface reflectance and refractive index)', u: 'https://en.wikipedia.org/wiki/Fresnel_equations' },
          { t: 'Optometrists Act (Laws & Regulations Database of the ROC, in Chinese)', u: 'https://law.moj.gov.tw/LawClass/LawAll.aspx?PCode=L0020190' },
        ].map(r => (
          <li class="text-brand-ink-2"><a href={r.u} target={r.u.startsWith('http') ? '_blank' : undefined} rel={r.u.startsWith('http') ? 'noopener noreferrer' : undefined} class="hover:text-brand-gold underline decoration-dotted underline-offset-2">{r.t}</a></li>
        ))}
      </ol>
      <p class="text-brand-ink-2" style="font-size:15px;line-height:1.8">Brand founding years and series names follow the manufacturers' public information listed above; product names follow the 2026 version of our lens series page. That reflections increase with refractive index follows from the Fresnel equations. The four personalized fitting measurements and collection times come from how our Xinzhuang and Banqiao stores place orders and from their collection records. Last updated: October 23, 2026.</p>
    </div>
  </section>

  <!-- 聚落文章：讀分類表 lenses 全部小分類（blog-en 有的篇才列），依小分類分組；分組名用 <p>，不佔標題層級 -->
  <section id="cluster" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-10" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Articles on choosing lenses</h2>
      {clusterGroups.map(g => (
        <div class="mb-12">
          <p class="font-sans text-brand-ink-3 tracking-widest uppercase mb-5" style="font-size:12px;letter-spacing:0.18em">{g.name}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {g.posts.map(post => (
              <a href={`/en/blog/${post!.slug}/`} class="rounded-2xl p-7 border border-brand-ink/10 hover:border-brand-gold transition-colors group" style="background:#f7f3ec">
                <span class="bg-brand-light text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">{post!.data.tag}</span>
                <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">{post!.data.title}</h3>
                <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">{post!.data.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      {extraPosts.length > 0 && (
        <div>
          <p class="font-sans text-brand-ink-3 tracking-widest uppercase mb-5" style="font-size:12px;letter-spacing:0.18em">Further reading: progressive lenses and high myopia</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {extraPosts.map(post => (
              <a href={`/en/blog/${post!.slug}/`} class="rounded-2xl p-7 border border-brand-gold/40 hover:border-brand-gold transition-colors group" style="background:#eee8da">
                <span class="bg-brand-light text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">{post!.data.tag}</span>
                <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">{post!.data.title}</h3>
                <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">{post!.data.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-20" style="background:#1a2f4e">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,34px);font-weight:300">Not sure which lens suits you?</h2>
      <p class="text-white/60 mb-8" style="font-size:16px;line-height:1.8">Our licensed optometry staff first check your prescription and listen to how you use your eyes through the day, then help you choose a frame and work through the four lens decisions with that frame in mind. Bookings are available at both our Xinzhuang and Banqiao stores.</p>
      <a href="/en/booking/" class="inline-block bg-brand-gold text-brand-navy font-bold px-8 py-3.5 rounded-full hover:bg-brand-gold/90 transition-colors font-sans" style="font-size:15px">Book a Vision Consultation →</a>
    </div>
  </section>

  <!-- 延伸閱讀：指南聚落互連（法務 🟢 純導覽） -->
  <section class="px-6 md:px-16 py-14 border-t border-brand-ink/10" style="background:#eee8da">
    <div class="max-w-5xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-6" style="font-size:12px;letter-spacing:0.18em">Read More | Other Complete Guides</span>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { href: '/en/guide/progressive-lens/', t: 'The Complete Guide to Progressive Lenses' },
          { href: '/en/guide/high-myopia/', t: 'The Complete Guide to High-Myopia Eyewear' },
          { href: '/en/guide/optical-basics/', t: 'Optical Basics Encyclopedia' },
        ].map(g => (
          <a href={g.href} class="block bg-brand-paper border border-brand-ink/10 px-5 py-4 hover:border-brand-gold transition-colors font-serif text-brand-navy" style="font-size:16px;font-weight:400">{g.t} →</a>
        ))}
      </div>
      <a href="/en/guide/" class="inline-block mt-6 font-sans text-brand-gold hover:text-brand-navy transition-colors" style="font-size:14px">← Back to all guides</a>
    </div>
  </section>

</Layout>
