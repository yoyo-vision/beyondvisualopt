---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../data/categories';

// 本指南的主題聚落文章：讀分類表「配眼鏡」的 local＋discomfort＋buying（與中文版同源），英文版取 blog-en 集合
// 沒有英文版的文章由 filter(Boolean) 自動略過；byo-frame 小分類放英文指南卡
const GLASSES = CATEGORIES.find(c => c.slug === 'glasses')!;
const CLUSTER_SLUGS = GLASSES.subs.filter(s => s.slug !== 'byo-frame').flatMap(s => s.posts);
const allPosts = await getCollection('blog-en');
const clusterPosts = CLUSTER_SLUGS
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/en/guide/choose-optician/';

// 指南頁 FAQ（與中文版 2026-10-20 版同步；與聚落文章互補，不重複）
const faqs = [
  {
    q: 'What is the difference between an optometry clinic and an optical shop?',
    a: 'The difference lies in how the place is set up, not in the sign. Under Article 9 of Taiwan\'s Optometrists Act, optometry personnel may practise at registered locations that include optometry clinics and optical companies (shops); under Article 4 of the Enforcement Rules of the Optometrists Act, an optical shop that wants to perform vision exams must set up an optometry clinic in the store, staffed by licensed optometry personnel. So whichever kind of shop you walk into, first confirm that it has a registered optometry clinic and that the person examining you holds an optometry licence.',
  },
  {
    q: 'How do I choose an optical store I can trust in New Taipei?',
    a: 'Not by the size of the sign, but by four things: whether the exam is performed by licensed optometry personnel (licences can be checked on the Ministry of Health and Welfare\'s medical personnel search), whether the exam is complete (our full exam includes a binocular vision assessment and takes about 45–60 minutes), whether fitting measurements are taken with the frame you chose, and whether you can come back for adjustments after pickup and whether that costs extra. Whether glasses feel comfortable is often decided after pickup. The addresses and transport for our Xinzhuang and Banqiao stores are listed on this page under "Xinzhuang × Banqiao".',
  },
  {
    q: 'How do I choose an optometry clinic in Banqiao?',
    a: 'From Jiangzicui station to Banqiao station the shops are dense and the price and positioning vary widely. When choosing, look at: whether the person examining you is registered, licensed optometry personnel, whether presbyopia and progressives include a full add-power and fitting-height measurement, and whether high myopia gets vertex-distance compensation. Beyond Visual Optometry × Neng Jian Du Optometry Clinic (a Banqiao local established in 1992) is at No. 28, Ln. 47, Sec. 2, Shuangshi Rd., a 5-minute walk from Jiangzicui MRT station. Tel: 02-2253-1246.',
  },
  {
    q: 'If I got my glasses at Beyond Visual Optometry and the frame loosens or slips after pickup, is there a charge to adjust it?',
    a: 'No. For glasses fitted with us, frame adjustments after pickup carry no extra charge; if they feel loose, slide down or press behind your ears, bring them back to either the Xinzhuang or the Banqiao store. Within 2 weeks of pickup, the store will also contact you to check how they feel. If it turns out the lenses need replacing, that is discussed case by case.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "How to Choose an Optical Store in New Taipei: Check Licensing, the Eye Exam, Measurements and Aftercare",
      "dateModified": "2026-10-20",
      "description": "How to choose an optical store in New Taipei: check whether the shop has a registered optometry clinic, how much time the eye exam takes, how fitting measurements are taken, and whether you can come back for adjustments after pickup. Explained by Optometrist YoYo. Beyond Visual Optometry, Xinzhuang and Banqiao.",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "en",
      "articleSection": "Complete Guide",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "Cheng Chia-Yu (YoYo)",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="How to Choose an Optical Store in New Taipei | Xinzhuang Glasses · Banqiao Optometry | Complete Guide"
  description="How to choose an optical store in New Taipei: check whether the shop has a registered optometry clinic, how much time the eye exam takes, how fitting measurements are taken, and whether you can come back for adjustments after pickup. Explained by Optometrist YoYo. Beyond Visual Optometry, Xinzhuang and Banqiao."
  lang="en"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">Complete Guide</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        How to Choose an Optical Store in New Taipei<br /><span class="text-brand-gold" style="font-size:0.6em">Check four things: licensing, the eye exam, measurements and aftercare</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        Getting glasses in Xinzhuang or looking for an optometry clinic in Banqiao? Whether the shop has a registered optometry clinic, how much time the exam takes, how fitting measurements are taken, and whether you can come back for adjustments after pickup: this page goes through them in order. Written by Optometrist YoYo, based on fitting practice at our Xinzhuang and Banqiao stores.
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">Quick Takeaways</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>An optical shop that wants to perform vision exams must set up an optometry clinic in the store, staffed by licensed optometry personnel (Enforcement Rules of the Optometrists Act, Article 4).</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Our full eye exam takes about 45–60 minutes, and both the Xinzhuang and Banqiao stores include a binocular vision assessment every time.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Fitting measurements are taken with the frame you chose: monocular PD for each eye separately, plus fitting height and vertex distance on that same frame.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>For glasses fitted with us, frame adjustments after pickup carry no extra charge, and the store contacts you within 2 weeks of pickup.</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: 'Is There an Optometry Clinic?', href: '#difference' },
        { label: '5 Things to Check', href: '#howtochoose' },
        { label: 'Glasses Feel Wrong', href: '#discomfort' },
        { label: 'Bring Your Own Frame', href: '#byo' },
        { label: 'Eye Symptoms', href: '#ophthalmology' },
        { label: 'Xinzhuang × Banqiao', href: '#stores' },
        { label: 'FAQ', href: '#faq' },
        { label: 'Author & Sources', href: '#author' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 眼鏡行還是驗光所（比較表刪除，與中文版同步） -->
  <section id="difference" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-6" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Optical shop or optometry clinic: first check for a registered optometry clinic</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>Article 9 of <a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?PCode=L0020190" target="_blank" rel="noopener noreferrer" class="text-brand-gold underline">Taiwan's Optometrists Act</a> lists where optometry personnel may practise: registered medical institutions, optometry clinics, and optical companies (shops), so optical shops are on the list. Under Article 4 of the Enforcement Rules, however, an optical company that wants to perform vision exams must set up an optometry clinic in the store. Both of our stores are set up this way: Xinzhuang is Beyond Visual Optometry × BiYang Optometry Clinic, and Banqiao is Beyond Visual Optometry × Neng Jian Du Optometry Clinic.</p>
        <p>So whether the sign says "optical shop" or "optometry clinic" isn't the point; what matters is whether the store has a registered optometry clinic and whether the person examining you is licensed.</p>
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        The plain-language conclusion: first check whether the shop has a registered optometry clinic and who will do your exam. If you have dizziness, eye fatigue, presbyopia or a progressive-lens need, confirm one more thing: that the exam includes a binocular vision assessment, not just a check of your lens power.
      </blockquote>
    </div>
  </section>

  <!-- 挑店先確認 5 件事 -->
  <section id="howtochoose" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Choosing where to get glasses in New Taipei: check these 5 things first</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">Whether you're getting glasses in Xinzhuang or having an exam in Banqiao, keep these questions in mind before you walk in.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { n: '01', title: 'Is the person examining you licensed?', desc: 'Only licensed optometry personnel (optometrists or associate optometrists) can legally perform the exam. Look at the wall when you walk in: by law, an optometry clinic must display its practice licence and fee schedule in a prominent place. You can also check the personnel\'s licence numbers on the Ministry of Health and Welfare\'s medical personnel search.' },
          { n: '02', title: 'How much time is set aside for the exam?', desc: 'Our full eye exam takes about 45–60 minutes, with a 60–90 minute appointment slot, and both stores include a binocular vision assessment every time. The length itself isn\'t the point; when choosing a store, ask what happens during that time.', link: { href: '/en/blog/eye-exam-duration-difference/', text: 'A 10-minute eye exam vs. a 1-hour eye exam: what\'s the difference?' } },
          { n: '03', title: 'Are vertex distance and binocular vision measured?', desc: 'High myopia needs vertex distance compensation to keep the effective power correct; for people whose eyes find it harder to work together, glasses made on lens power alone are more likely to feel tiring or dizzying. Monocular PD should be measured for each eye separately, and fitting height measured with the frame you chose.' },
          { n: '04', title: 'Can they explain the lens source and manufacturer warranty?', desc: 'Ask the store to explain where the lenses come from and how the manufacturer\'s warranty works. This is especially worth asking for progressives and personalized custom lenses. We are a ZEISS contracted certified dealer and a HOYA dealer.' },
          { n: '05', title: 'Can you come back for adjustments after fitting, and is there a charge?', desc: 'Ask about both before you choose a store. For glasses fitted with us, frame adjustments after pickup carry no extra charge, and the store contacts you within 2 weeks of pickup. At collection you should try the glasses on the spot and confirm the far, intermediate and near fields and the frame fit.' },
        ].map(item => (
          <div class="border border-brand-ink/8 rounded-2xl p-7">
            <span class="font-sans text-brand-gold font-semibold tracking-widest mb-3 block" style="font-size:13px;letter-spacing:0.18em">{item.n}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{item.title}</h3>
            <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">{item.desc}</p>
            {item.link && <a href={item.link.href} class="inline-block mt-3 text-brand-gold underline" style="font-size:14px">{item.link.text}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 配完戴起來不對：聚落入口（取代原「常見配鏡地雷」，與中文版同步） -->
  <section id="discomfort" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">New glasses feel wrong: where to start with dizziness or discomfort</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">If your new glasses make you dizzy or tire you out, don't assume you just can't adapt. The cause may be the lens power, the measurements, a frame that has shifted, or how your two eyes work together, and it has to be checked item by item in store. Pick the article that matches what you're experiencing.</p>
      <div class="space-y-6">
        {[
          { title: 'Dizzy in new glasses', href: '/en/blog/glasses-dizzy/', text: 'Why do my new glasses make me dizzy?' },
          { title: 'The power is right, but they still feel uncomfortable', href: '/en/blog/glasses-uncomfortable-3-reasons/', text: 'Still uncomfortable after getting new glasses?' },
          { title: 'The step an eye exam can miss', href: '/en/blog/common-optometry-mistakes/', text: '5 common vision exam mistakes when getting glasses' },
        ].map(item => (
          <div class="bg-white border border-brand-ink/8 rounded-2xl p-7">
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">{item.title}</h3>
            <a href={item.href} class="text-brand-gold underline" style="font-size:15px">{item.text}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 框不是在店裡買的 -->
  <section id="byo" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-6" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Frame not bought in store: bringing your own frame</h2>
      <p class="text-brand-ink-2" style="font-size:17px;line-height:1.85">A frame bought online, an old frame from home, or a vintage frame you've kept for years: if you want new lenses fitted to it, we first check whether the frame's condition allows it. Whether it can be done, how measurement works and how it is priced are covered in the <a href="/en/guide/byo-frame-lenses/" class="text-brand-gold underline">bring-your-own-frame guide</a>.</p>
    </div>
  </section>

  <!-- 有眼睛症狀先看眼科（分流表刪除，與中文版同步） -->
  <section id="ophthalmology" class="px-6 md:px-16 py-20" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-6" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Eye symptoms? See an ophthalmologist first</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>Whether your eyes are healthy and whether they need treatment is for an ophthalmologist to judge; lens power, binocular vision and fitting measurements are what an optometry clinic does. If, during the exam, no change in lens power brings your vision up to normal, optometry personnel stop the fitting and refer you to an ophthalmologist under Article 12, Paragraph 3 of the Optometrists Act.</p>
        <p>Children follow a legal order: optometry personnel may not examine children under 6, so see an ophthalmologist first; for children aged 6–15, the first exam and glasses require a physician to first confirm it is not pseudomyopia, and exams up to age 15 are then done under an ophthalmologist's guidance. For which situations need a doctor first, see <a href="/en/guide/eye-doctor-or-optometrist/" class="text-brand-gold underline">eye doctor or optometry clinic? A symptom-based guide</a>.</p>
      </div>
    </div>
  </section>

  <!-- 新莊店 × 板橋店 -->
  <section id="stores" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">Xinzhuang × Banqiao</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">One store in Xinzhuang and one in Banqiao; ZEISS contracted certified dealer and HOYA dealer. A full eye exam takes about 45–60 minutes and always includes a binocular vision assessment; for glasses fitted with us, frame adjustments after pickup carry no extra charge. Stock lenses are ready in about 3–5 working days, custom lenses in about 7–10. See which is closer to you.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="border-t border-white/10 pt-6">
          <img src="/images/store-xinzhuang-exterior.webp" alt="Beyond Visual Optometry × BiYang Optometry Clinic storefront, No. 419-1 Zhongzheng Rd., Xinzhuang" width="1200" height="900" loading="lazy" class="w-full rounded-xl object-cover mb-5" style="aspect-ratio:4/3" />
          <p class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:12px;letter-spacing:0.18em">Xinzhuang</p>
          <h3 class="font-serif text-white mb-4" style="font-size:22px;font-weight:400">Beyond Visual Optometry × BiYang Optometry Clinic</h3>
          <div class="text-white/70 space-y-2" style="font-size:15px;line-height:1.7">
            <p>Address: No. 419-1, Zhongzheng Rd., Xinzhuang Dist., New Taipei City</p>
            <p>MRT: about an 8-minute walk from Xinzhuang station</p>
            <p>Tel: 02-2206-6700</p>
            <p>Lead optometrist: Cheng Chia-Yu (YoYo)</p>
            <p class="text-white/50">Clinical vision exams, power tracking for school-age children (ages 6–15 need a physician to first confirm it is not pseudomyopia), ZEISS Individual² personalized custom lenses</p>
          </div>
          <a href="/en/xinzhuang/" class="inline-block mt-5 text-brand-gold font-sans hover:underline" style="font-size:15px">See Xinzhuang store details →</a>
        </div>
        <div class="border-t border-white/10 pt-6">
          <img src="/images/store-banqiao.webp" alt="Beyond Visual Optometry × Neng Jian Du Optometry Clinic storefront, Shuangshi Rd., Banqiao" width="720" height="584" loading="lazy" class="w-full rounded-xl object-cover mb-5" style="aspect-ratio:4/3" />
          <p class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:12px;letter-spacing:0.18em">Banqiao</p>
          <h3 class="font-serif text-white mb-4" style="font-size:22px;font-weight:400">Beyond Visual Optometry × Neng Jian Du Optometry Clinic</h3>
          <div class="text-white/70 space-y-2" style="font-size:15px;line-height:1.7">
            <p>Address: No. 28, Ln. 47, Sec. 2, Shuangshi Rd., Banqiao Dist., New Taipei City</p>
            <p>MRT: about a 5-minute walk from Jiangzicui station</p>
            <p>Tel: 02-2253-1246</p>
            <p>Local since: established 1992, over 30 years</p>
            <p>Exams: performed by licensed optometry personnel</p>
            <p class="text-white/50">Presbyopia and progressive fitting, high-myopia fitting (vertex distance measured), power tracking for school-age children (ages 6–15 need a physician to first confirm it is not pseudomyopia)</p>
          </div>
          <a href="/en/banqiao/" class="inline-block mt-5 text-brand-gold font-sans hover:underline" style="font-size:15px">See Banqiao store details →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 聚落文章：讀分類表 glasses → local＋discomfort＋buying（只列有英文版的）；byo-frame 放指南卡 -->
  <section class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-10" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Articles on getting glasses in New Taipei</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {clusterPosts.map(post => (
          <a href={`/en/blog/${post.slug}/`} class="bg-white rounded-2xl p-7 border border-brand-ink/5 hover:border-brand-gold transition-colors group">
            <span class="bg-brand-light text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">{post.data.tag}</span>
            <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">{post.data.title}</h3>
            <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">{post.data.excerpt}</p>
          </a>
        ))}
        <a href="/en/guide/byo-frame-lenses/" class="rounded-2xl p-7 border border-brand-gold/40 hover:border-brand-gold transition-colors group" style="background:#eee8da">
          <span class="bg-brand-navy text-white text-xs font-semibold px-3 py-1 rounded-full">Complete Guide</span>
          <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">Bring Your Own Frame: Complete Guide</h3>
          <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">Frames bought online, new lenses for an old frame, vintage frames: everything about bringing your own frame is collected in this guide.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-10" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Getting glasses in New Taipei: FAQ</h2>
      <div class="space-y-8">
        {faqs.map(f => (
          <div class="border-b border-brand-ink/8 pb-8">
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">Q: {f.q}</h3>
            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 關於作者與資料來源（E-E-A-T）：資歷文字沿用英文作者頁，照片用現有門市實拍 -->
  <section id="author" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">About the author and sources</h2>
      <div class="flex gap-5 items-start bg-white rounded-2xl border border-brand-ink/10 p-6 mb-8">
        <img src="/images/yoyo-optometrist.webp" alt="Optometrist Cheng Chia-Yu (YoYo)" width="72" height="72" loading="lazy" class="rounded-full object-cover shrink-0" style="width:72px;height:72px" />
        <div>
          <p class="text-brand-navy font-bold mb-1" style="font-size:17px">Cheng Chia-Yu (YoYo), Optometrist</p>
