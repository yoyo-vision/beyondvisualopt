---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../data/categories';

// 2026-10-24 同步中文版改版（高度近視規劃書 5-1）：H1／title／schema／FAQ／E-E-A-T／聚落讀取＋事實衝突句；內文全文重譯另排
// 事實衝突句已修：度數區間對齊 lens-index-160（#22）、阿貝數講反、50mm 規則句與框心距用詞（#27）、「無角膜健康風險」「8–12 小時」（#28）、
// §12（#21）、「rushed exam」（#6）、「Regular in-store adjustment」（#7）、「救不回／白做」撞句（#34）、眼底段改依國健署與眼科醫學會
// 聚落：讀分類表「高度近視」3 個小分類，與中文版同序；英文版取 blog-en 集合，尚未翻譯的篇由 .filter(Boolean) 濾掉；小分類有自己的指南就出指南卡
const SUB_NAMES_EN: Record<string, string> = {
  fitting: 'Fitting glasses for high myopia',
  astigmatism: 'Astigmatism and distortion',
  anisometropia: 'A big difference between the two eyes',
};
const SELF = '/guide/high-myopia/';
const HM = CATEGORIES.find(c => c.slug === 'high-myopia')!;
const allPosts = await getCollection('blog-en');
const clusterGroups = HM.subs
  .map(s => ({
    name: SUB_NAMES_EN[s.slug] ?? s.slug,
    posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
    guide: s.guide && s.guide !== SELF ? `/en${s.guide}` : null,
  }))
  .filter(g => g.posts.length > 0 || g.guide);
// 分類外延伸卡（與中文版同；英文版只列 blog-en 已有的篇）
const EXTRA_SLUGS = ['vertex-distance', 'lens-index-160-vs-167-vs-174', 'glasses-dizzy', 'glasses-uncomfortable-3-reasons', 'contact-lens-vs-glasses'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/en/guide/high-myopia/';

// 指南頁 FAQ：與中文版同四題
const faqs = [
  {
    q: 'Can I get thin lenses at -10.00D?',
    a: "Yes. A myopic lens is thin in the middle, with its thickness piled up around the edge. To thin that edge at -10.00D, do three things together: choose a smaller frame, pick a frame whose center distance is close to your monocular PD, and go up to a 1.74 index. Among the brands we carry, resin lenses go up to an index of 1.74.",
  },
  {
    q: 'How strong does myopia have to be to count as high myopia?',
    a: "High myopia is generally defined as -6.00D or stronger; the International Myopia Institute (IMI) used -6.00D as the cut-off in its 2019 definitions. At this level, small errors in vertex distance, monocular PD and fitting height are all magnified by the power. As for eye health, according to public health-education materials from Taiwan's Health Promotion Administration and the American Academy of Ophthalmology's EyeWiki, high myopia carries a higher later risk of retinal disease, so please have regular check-ups with an ophthalmologist.",
  },
  {
    q: 'How often should someone with high myopia see an ophthalmologist?',
    a: "For high myopia, how often to be examined, and whether the fundus should be examined as well, is decided by your ophthalmologist based on your eyes. If floaters or flashes suddenly increase, don't wait for the next appointment — see a doctor the same day. A vision exam measures your prescription and binocular vision; it cannot replace an ophthalmologist's examination.",
  },
  {
    q: 'Where in Xinzhuang or Banqiao can I get high-myopia glasses?',
    a: "At either of our two stores: the Xinzhuang store, Beyond Visual Optometry (BiYang Optometry Clinic), No. 419-1, Zhongzheng Rd., Xinzhuang Dist., New Taipei City, 02-2206-6700, near Xinzhuang MRT station; and the Banqiao store, Beyond Visual Optometry × Neng Jian Du Optometry Clinic, No. 28, Ln. 47, Sec. 2, Shuangshi Rd., Banqiao Dist., 02-2253-1246, near Jiangzicui MRT station. Both stores measure vertex distance, monocular PD and fitting height, include a binocular vision assessment in every exam, and fit RGP rigid contact lenses. If glasses made elsewhere feel uncomfortable, bring them in and our optometry staff will look at them with you.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "What should you watch for when getting glasses for high myopia? Measurements, lens thickness, astigmatism, contact lenses and eye exams",
      "dateModified": "2026-10-24",
      "description": "What needs extra care when fitting glasses for high myopia? Above -6.00D, small errors in vertex distance, monocular PD and fitting height are magnified; lens thickness depends on the frame and PD first, the index second; high astigmatism and a big difference between the two eyes each need attention; how to choose between glasses, soft contacts and RGP; and why the fundus should be checked regularly by an ophthalmologist. By Optometrist YoYo, Xinzhuang and Banqiao stores.",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "en",
      "articleSection": "Complete Guides",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "YoYo Cheng",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="High Myopia Glasses | What to Measure Above -6.00D, Lens Thickness, Contacts & Eye Exams | Beyond Visual"
  description="What needs extra care when getting glasses for high myopia? Above -6.00D, small errors in vertex distance, monocular PD and fitting height are magnified; thickness depends on the frame and PD before the index; plus astigmatism, a big difference between the two eyes, contacts and RGP, and why to see an ophthalmologist regularly. Beyond Visual Optometry, Xinzhuang & Banqiao."
  lang="en"
  schema={schema}
>

  <!-- Hero：H1 帶副標（同中文版） -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">Complete Guide</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        What should you watch for when getting glasses for high myopia?<br /><span class="text-brand-gold" style="font-size:0.6em">Measurements, lens thickness, astigmatism, contact lenses and eye exams</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        Above -6.00D, the things that need extra care when getting glasses are only a handful, but each of them leaves less room for error. Optometrist YoYo wrote this for people with deep myopia who are about to get a new pair.
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first；#22 度數區間交給折射率文章） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">Quick Takeaways</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Above -6.00D, small errors in vertex distance, monocular PD and fitting height are magnified by the power.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>Lens thickness depends on the frame and your PD first, and the index second.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>High astigmatism and a big difference between the two eyes each need their own attention.</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>A fundus examination belongs to ophthalmology — please have regular check-ups with an ophthalmologist.</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: 'Why It\'s Different', href: '#vertex' },
        { label: 'Choosing an Index', href: '#index' },
        { label: 'Frame Choice', href: '#frame' },
        { label: 'Glasses · Contacts · RGP', href: '#options' },
        { label: 'The Extra Measurements', href: '#fitting' },
        { label: 'The Eye Behind the Number', href: '#retina' },
        { label: 'FAQ', href: '#faq' },
        { label: 'Author & Sources', href: '#author' },
        { label: 'Articles', href: '#cluster' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 為什麼高度數配鏡不一樣：頂點距離（表已在第 1 步修正） -->
  <section id="vertex" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Above -6.00D, why is fitting glasses different from usual?</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>The core reason is <strong>the amplification of optical error at high prescriptions</strong>. The same parameter error is barely felt at -2.00D but can become obvious visual distortion, dizziness, or discomfort at -8.00D. The parameter with the largest impact is <strong>vertex distance</strong>: the distance from the back surface of the lens to the apex of the cornea.</p>
        <p>During refraction, the phoropter's vertex distance is about 12–13mm; but the frame you actually wear lands anywhere from 8mm to 16mm depending on nose-pad height and face shape. The closer the lens sits to the eye, the stronger the actual correction; the farther, the weaker — and the higher the prescription, the more pronounced this difference:</p>
      </div>
      <div class="overflow-x-auto mt-8">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">Rx Power</th>
              <th class="text-left px-5 py-4 font-semibold">Vertex Distance 12mm</th>
              <th class="text-left px-5 py-4 font-semibold">Effective at 8mm</th>
              <th class="text-left px-5 py-4 font-semibold">Difference</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2 bg-white">
            {[
              ['-6.00D', '-6.00D', 'approx. -5.86D', 'approx. 0.14D'],
              ['-10.00D', '-10.00D', 'approx. -9.62D', 'approx. 0.38D'],
              ['-14.00D', '-14.00D', 'approx. -13.26D', 'approx. 0.74D'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy whitespace-nowrap' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-brand-ink-3 mt-4" style="font-size:14px;line-height:1.7">Formula: Fc = F ÷ (1 − dF), where F is the measured power and d is how far the lens moves toward the eye, in meters. For -6.00D: -6.00 ÷ [1 − 0.004 × (-6.00)] = -6.00 ÷ 1.024 ≈ -5.86D, a difference of about 0.14D. Moving the same 4mm at -14.00D changes it by about 0.74D.</p>
      <div class="space-y-5 text-brand-ink-2 mt-8" style="font-size:17px;line-height:1.85">
        <p>The same prescription gives different actual correction at different wearing positions. This is why "the prescription is clearly right, but distance vision is a bit foggy once fitted" is especially common in high myopia — <strong>a high-myopia prescription must have vertex-distance compensation calculated for the actual frame wearing position</strong>.</p>
        <p>Another amplification effect is the <strong>prism effect</strong>: the visual shift produced when the line of sight strays from the lens's optical center, with a magnitude equal to the power times the decentration (in centimeters). The same 3mm optical-center offset produces only 0.6Δ at -2.00D — imperceptible to most — but 2.4Δ at -8.00D, enough to make the two eyes work harder to fuse the image. So high-myopia fitting must precisely measure monocular PD and fitting height to align the optical center with your visual axis.</p>
      </div>
    </div>
  </section>

  <!-- 折射率選擇（#22 度數區間對齊 lens-index-160；刪「最佳平衡點」「價格最高」#26；阿貝數改正：1.67 在三級裡最低） -->
  <section id="index" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">How to choose a lens index: 1.60, 1.67, 1.74</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">Many people assume high myopia means going straight to 1.74, but the frame comes first: each step up in index trims roughly a tenth off the extra edge thickness.</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">Index</th>
              <th class="text-left px-5 py-4 font-semibold">Where it usually fits</th>
              <th class="text-left px-5 py-4 font-semibold">What to keep in mind</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['1.60', 'Up to about -4.00D, 1.60 is usually enough', 'Going one step higher at this power saves very little thickness'],
              ['1.67', 'From -4.00D to -6.00D, look at the frame first', 'Its Abbe number is the lowest of the three, so people sensitive to color fringing should say so'],
              ['1.74', 'Above -6.00D, provided the frame is already small', 'The highest index among the brands we carry'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy whitespace-nowrap' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="space-y-5 text-brand-ink-2 mt-8" style="font-size:17px;line-height:1.85">
        <p>For a -9.00D office worker in glasses more than 12 hours a day, the weight 1.74 shaves off is felt on the bridge of the nose all day; but for someone at -5.00D, the same budget put into a smaller frame plus 1.67 often yields a thinner, lighter result. <strong>Index should be judged by prescription, frame size, face shape, and visual needs together.</strong></p>
      </div>
    </div>
  </section>

  <!-- 鏡框選擇原則（刪 50mm 規則句、框心距用詞修正 #27；刪「救不回」#34） -->
  <section id="frame" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Frame choice: often more impactful on thickness than the index</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">A myopic lens is thin in the middle and thick at the edge; how thick that edge ends up depends first on frame size and your PD.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { level: 'Frame size and decentration', desc: "The wider the frame, the farther from the optical center the lens has to be cut, leaving exactly the thickest ring behind. As an example, the same power in a 48mm frame and a 54mm frame ends up with clearly different edge thickness, and a left-right symmetrical shape keeps the two lenses balanced.", fit: 'Size' },
          { level: 'Frame center distance vs. your PD', desc: "The frame center distance is the distance between the centers of the two lens openings. The further it is from your PD, the further the optical center has to be shifted, and the thicker the outer edge of a myopic lens becomes. Factor the PD in when choosing the frame.", fit: 'Optics' },
          { level: 'Thick acetate, stable fit', desc: "A thicker acetate rim can conceal part of the lens's edge thickness. The frame must also sit snug without sliding — once it slips, the vertex distance changes, and high myopia feels it directly. Adjustable nose pads help if your nose bridge is low.", fit: 'Fit' },
        ].map(item => (
          <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
            <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">{item.fit}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{item.level}</h3>
            <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">
        Still uncomfortable in your glasses? Sometimes the problem isn't the prescription but the frame and lens design: <a href="/en/blog/glasses-uncomfortable-3-reasons/" class="text-brand-gold underline">Still Uncomfortable in Your Glasses? The 3 Real Causes and Fixes</a>
      </p>
    </div>
  </section>

  <!-- 三種矯正方案比較（刪「no corneal-health risk」「8–12 hours」「1–3 month」#28；補 §12 #21） -->
  <section id="options" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">Glasses, soft contacts, RGP: three options for high myopia</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">None is always better — it depends on your eyes and how you spend your day.</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">Option</th>
              <th class="text-left px-5 py-4 font-semibold">For high myopia</th>
              <th class="text-left px-5 py-4 font-semibold">Keep in mind</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['Glasses', 'Easy to put on and take off; astigmatism correction stays stable', 'Thicker edges and more weight at high powers; the field is limited by the frame, and things look slightly smaller than they are'],
              ['Soft contact lenses', 'No frame in the way; vertex distance near zero, so the power is usually weaker than the glasses prescription', 'With high astigmatism a soft lens may rotate and the axis drifts; wearing time and dry eye are assessed in person'],
              ['RGP rigid contact lenses', 'Custom-made to the shape of the cornea; another option for high astigmatism', 'Needs an adaptation period; both stores fit RGP (Xinzhuang uses a TOPCON CA-800 corneal topographer, Banqiao assesses fit with a slit lamp)'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy whitespace-nowrap' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        An often-overlooked detail: from about -4.00D upward, contact-lens power needs to be converted via vertex distance and is usually weaker than the spectacle prescription — buying contacts straight from a glasses prescription may over-correct, so we recommend confirming it through professional fitting. Under Article 12 of Taiwan's Optometrists Act, contact lens fitting for those aged fifteen and under must be carried out under the guidance of an ophthalmologist, and no fitting is provided for children under six.
      </blockquote>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">
        A deeper comparison: <a href="/en/blog/contact-lens-vs-glasses/" class="text-brand-gold underline">Contact Lenses vs. Glasses: Which Is Better?</a> · RGP in detail: <a href="/en/guide/rgp-contact-lens/" class="text-brand-gold underline">The Complete Guide to RGP Rigid Contact Lenses</a>
      </p>
    </div>
  </section>

  <!-- 量測重點（刪「rushed exam」#6、「wasted」#34、「Regular in-store adjustment」#7） -->
  <section id="fitting" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">The extra measurements for high myopia</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">A high prescription magnifies every millimeter of error, so a few measurements get extra care. Both stores include a binocular vision assessment in every exam.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
        {[
          ['Vertex-distance measurement and compensation', "Converts effective power for the actual frame wearing position you chose, rather than copying the phoropter's numbers"],
          ['Monocular PD (MPD-L / MPD-R)', 'Each eye measured separately, not total PD divided by two — at high prescriptions, a 1–2mm offset is enough to produce a perceptible prism effect'],
          ['Fitting height', "Measured with the chosen frame on; if the frame changes, it's measured again"],
          ['Subjective confirmation of cylinder axis (JCC)', "The autorefractor's axis is only a starting value. A 10° axis error leaves about one third of the cylinder uncorrected, so the axis is confirmed subjectively when high myopia comes with astigmatism"],
          ['Your old glasses', "Bring them along: a lensmeter reads the old lenses' power and optical centers, so the old and new can be compared"],
          ['Follow-up within 2 weeks of pickup', 'Within 2 weeks of pickup, the store proactively follows up on how the glasses feel. For glasses made with us, frame adjustments after pickup carry no extra charge'],
        ].map(([title, desc]) => (
          <div class="border-t border-white/10 pt-5">
            <p class="font-sans text-brand-gold font-semibold mb-2" style="font-size:15px">{title}</p>
            <p class="text-white/60" style="font-size:14px;line-height:1.7">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 轉：600 度是數字也是拉長的眼球（10-24 同步中文國文編審版；原 #vertex blockquote 升上來；出處依國健署與中華民國眼科醫學會；
       高中生那段連 high-school-vision-stability，英文版尚無此篇，暫不放） -->
  <section id="retina" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">-6.00D is a number. It is also an eyeball that has been stretched.</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>Vertex-distance conversion, monocular PD, choosing a smaller frame: everything earlier on this page is about where light lands after it passes through the lens. It deals with the power, which is a number. But a power this strong usually means the eyeball has grown longer from front to back, and the retina has been stretched thinner along with it. A lens moves the light; the eye is still the same eye.</p>
        <p>According to public health-education materials from Taiwan's Health Promotion Administration and the American Academy of Ophthalmology's EyeWiki, people with high myopia carry a higher later risk of retinal detachment, macular degeneration and glaucoma than other people. These conditions often bring no obvious symptoms at first, so please have regular check-ups with an ophthalmologist.</p>
        <p>Some changes should not wait. If floaters or flashes suddenly increase, see a doctor the same day; if part of your field of vision suddenly goes missing, or your vision suddenly blurs, please see an ophthalmologist as soon as possible. For where to go first with other symptoms, <a href="/en/guide/eye-doctor-or-optometrist/" class="text-brand-gold underline">Eye Doctor or Optometrist? A Symptom Triage Guide</a> has a 30-second triage. If, during the exam, corrected vision will not come up however the lenses are changed, licensed optometry staff will refer you to an ophthalmologist under Article 12, Paragraph 3 of Taiwan's Optometrists Act.</p>
      </div>
    </div>
  </section>

