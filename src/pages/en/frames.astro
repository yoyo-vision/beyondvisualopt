---
import Layout from '../../layouts/Layout.astro';

const brands = [
  {
    name: 'ZEISS',
    origin: 'Germany',
    type: 'Optical Lenses',
    badge: 'Authorized ZEISS Dealer',
    badgeColor: 'bg-brand-navy text-white',
    highlight: true,
    desc: 'German precision optics. ZEISS Individual² personalized lenses are calculated from your vertex distance, pantoscopic tilt, face-form angle, and fitting height, measured with your chosen frame on before the order is placed. Beyond Visual is a certified ZEISS dealer, and both our Xinzhuang and Banqiao stores can order personalized lenses.',
    tags: ['Individual² personalized', 'Digital Lens', 'DuraVision anti-reflective', 'Ultra-thin series'],
  },
  {
    name: 'HOYA',
    origin: 'Japan',
    type: 'Optical Lenses',
    badge: 'HOYA Dealer',
    badgeColor: 'bg-brand-navy text-white',
    highlight: true,
    desc: 'Japanese optical manufacturer. Beyond Visual is a HOYA dealer, and both our Xinzhuang and Banqiao stores can order HOYA lenses, so ZEISS and HOYA can be compared side by side for your viewing needs.',
    tags: ['iD progressive series', 'Japanese optics'],
  },
  {
    name: 'International Fashion & Luxury Frames',
    origin: 'Both stores',
    type: 'Dealer Frame Brands',
    badge: 'In-Store Dealer',
    badgeColor: 'bg-brand-light text-brand-navy',
    highlight: false,
    desc: 'From the classics of Ray-Ban to the vintage, literary style of OLIVER PEOPLES, the premium feel of EMPORIO ARMANI and BVLGARI, and the French minimalism of agnès b. — both of our stores carry these as a dealer, and we use your exam data to help you balance style with optical needs.',
    tags: ['Ray-Ban', 'OLIVER PEOPLES', 'EMPORIO ARMANI', 'BVLGARI', 'agnès b.'],
  },
  {
    name: 'Craft & Functional Frames',
    origin: 'MINAMOTO: Xinzhuang store only · others at both stores',
    type: 'Dealer Frame Brands',
    badge: 'In-Store Dealer',
    badgeColor: 'bg-brand-light text-brand-navy',
    highlight: false,
    desc: 'MINAMOTO brings the refined craftsmanship of Japan\'s Sabae region, MASAKI MATSUSHIMA carries the fashion vocabulary of a Japanese designer, and Polaris is a Taiwanese brand — together with Maji, Orient, STEEPER, and Sanjiaoti (a Shenzhen brand), covering lightweight, business, and everyday styles. MINAMOTO is available at our Xinzhuang store only; the other brands are at both stores.',
    tags: ['MINAMOTO (Sabae)', 'MASAKI MATSUSHIMA', 'Polaris (Taiwan)', 'Maji · Orient · STEEPER'],
  },
  {
    name: 'High-End Frame Repair & Own-Frame Lens Fitting',
    origin: 'Lindberg · ic! berlin · Cartier · Chrome Hearts, etc.',
    type: 'Professional Repair Service',
    badge: 'Repair Specialty',
    badgeColor: 'bg-brand-light text-brand-navy',
    highlight: false,
    desc: 'From the screwless pure-titanium structure of Lindberg, the spring-clip of ic! berlin, and the precision titanium craft of Götti, to luxury frames like Cartier, Chrome Hearts, and Linda Farrow — while we are not an authorized dealer for these brands, we have long provided precision adjustment, repair, and lens fitting for such high-end frames. If you\'d like to fit prescription lenses into a luxury frame from your own collection, you\'re welcome to bring it in for assessment.',
    tags: ['Screwless structure repair', 'Luxury-frame lens fitting', 'Pure-titanium adjustment', 'Non-dealer · repair specialist'],
  },
  {
    name: 'Precision Frame Adjustment Service',
    origin: 'All brands',
    type: 'Professional Adjustment',
    badge: 'Both stores',
    badgeColor: 'bg-green-100 text-green-800',
    highlight: false,
    desc: 'Whatever the brand, our licensed optometry staff adjust nose-pad height, temple angle, and pantoscopic tilt so the optical centres sit in front of your pupils. For glasses fitted at Beyond Visual, frame adjustments after pickup are included at no extra charge; parts, and glasses fitted elsewhere, are discussed case by case. Each store can adjust glasses fitted at the other.',
    tags: ['Nose-pad height', 'Tilt correction', 'Temple tension', 'All brands'],
  },
];

const selectionGuide = [
  {
    need: 'Strong prescription (high myopia)',
    recommendation: 'A smaller frame, as long as the width suits your face',
    reason: 'Myopic lenses are thick at the edge; the wider the frame, the thicker the edge left in it',
  },
  {
    need: 'Sensitive to nose-bridge / ear pressure',
    recommendation: 'Titanium or other lightweight frames with adjustable nose pads',
    reason: 'A lighter frame puts less weight on the nose and ears; the pads can be set to your nose',
  },
  {
    need: 'Want a distinctive style / fashion sense',
    recommendation: 'Designer models like OLIVER PEOPLES, EMPORIO ARMANI',
    reason: 'High style recognition, many options',
  },
  {
    need: 'Progressive multifocal lens wearer',
    recommendation: 'A frame with enough depth',
    reason: 'Far, intermediate and near are stacked top to bottom; a shallow frame cuts off the near zone',
  },
  {
    need: 'Metal allergy / sensitive skin',
    recommendation: 'Pure titanium or acetate frame',
    reason: 'Pure titanium contains no nickel, so the allergy risk is lower; if a skin reaction persists, see a dermatologist',
  },
];

// 2026-10-23 同步中文版（規劃書 6-1）：FAQ 收斂成三題；schema 由同一陣列產生；事實衝突句已改，全文重譯另排
const faqs = [
  {
    q: 'Which frame type suits high myopia?',
    a: 'Get the width right for your face first; within that, choose a smaller frame without oversized rims. A myopic lens is thin in the middle and thick at the edge, so the larger the frame, the thicker and heavier the lens edge that ends up in it. If the distance between the two rim centres (lens width plus bridge) is far from your PD, the lens has to be cut off-centre and the outer edge gets thicker still. Our high myopia guide works through real prescriptions; in store, our licensed optometry staff choose with you based on your prescription and face width.',
  },
  {
    q: 'Do the Xinzhuang and Banqiao stores carry the same frame brands?',
    a: 'Of the 12 frame brands Beyond Visual carries as a dealer, 11 are at both the Xinzhuang and Banqiao stores. MINAMOTO is at the Xinzhuang store only, so please visit Xinzhuang to try it on. If you want to see a specific model from a brand, call that store before you go.',
  },
  {
    q: 'Can I buy designer frames like Lindberg or Cartier at Beyond Visual?',
    a: 'No. Lindberg, ic! berlin, Götti, Cartier, Chrome Hearts and Linda Farrow are not on our dealer list, and Beyond Visual is not an authorized agent for these brands. If you bring one of these frames in, we handle adjustment and repair, and we can fit prescription lenses; whether it can be done depends on the frame\'s condition once we have looked at it.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
    },
  ],
};
---
<Layout
  title="Frame Brands | Ray-Ban · OLIVER PEOPLES · BVLGARI · MINAMOTO | Beyond Visual Optometry | Xinzhuang & Banqiao"
  description="Dealer for 12 frame brands including Ray-Ban, OLIVER PEOPLES, BVLGARI, agnès b., and MINAMOTO; adjustment, repair and own-frame lens fitting for luxury frames such as Lindberg and Cartier (not an authorized dealer for these). Beyond Visual Optometry, Xinzhuang & Banqiao."
  lang="en"
  schema={schema}
>
  <!-- Hero -->
  <section class="bg-brand-navy text-white py-20 px-4 text-center">
    <h1 class="text-4xl font-bold mb-4">Which frame brands can you try on in Xinzhuang and Banqiao?</h1>
    <p class="text-gray-300 text-lg max-w-2xl mx-auto">Beyond Visual carries 12 frame brands as a dealer: 11 at both stores, with MINAMOTO at the Xinzhuang store. Our licensed optometry staff check the size and your prescription first, then help you choose a style from the frames that fit.</p>
    <p class="text-brand-gold text-sm mt-4 tracking-wider">Authorized ZEISS Dealer · HOYA Dealer | Beyond Visual Optometry — Xinzhuang × Banqiao</p>
  </section>

  <!-- Brand cards -->
  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {brands.map(brand => (
        <div class={`rounded-2xl p-7 hover:shadow-lg transition-shadow flex flex-col ${brand.highlight ? 'border-2 border-brand-gold bg-brand-light' : 'border border-gray-200'}`}>
          <div class="flex justify-between items-start mb-3">
            <div>
              <h2 class="text-xl font-bold text-brand-navy">{brand.name}</h2>
              <p class="text-gray-400 text-xs mt-0.5">{brand.origin} | {brand.type}</p>
            </div>
            <span class={`text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap ${brand.badgeColor}`}>{brand.badge}</span>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed flex-1">{brand.desc}</p>
          <div class="mt-4 pt-4 border-t border-gray-100 flex flex-wrap gap-2">
            {brand.tags.map(tag => (
              <span class="text-xs bg-white border border-gray-200 text-gray-500 px-2 py-1 rounded-full">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Selection guide -->
  <section class="bg-brand-light py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-brand-navy text-center mb-3">How to Choose the Frame That Suits You Best?</h2>
      <p class="text-gray-500 text-sm text-center mb-10">Start from your needs, not from the brand</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="px-4 py-3 text-left font-semibold rounded-tl-lg">Your Need</th>
              <th class="px-4 py-3 text-left font-semibold">Suggested Direction</th>
              <th class="px-4 py-3 text-left font-semibold rounded-tr-lg">Why</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            {selectionGuide.map(row => (
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3 font-medium text-brand-navy">{row.need}</td>
                <td class="px-4 py-3 text-gray-700">{row.recommendation}</td>
                <td class="px-4 py-3 text-gray-500 text-xs">{row.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 py-20">
    <h2 class="text-2xl font-bold text-brand-navy text-center mb-10">Frame FAQ</h2>
    <div class="space-y-6">
      {faqs.map(faq => (
        <div class="border border-gray-200 rounded-xl p-6">
          <h3 class="font-bold text-brand-navy mb-2">Q: {faq.q}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-navy py-16 px-4 text-center text-white">
    <h2 class="text-2xl font-bold mb-4">Not sure which frame suits you best?</h2>
    <p class="text-gray-300 mb-8 max-w-xl mx-auto">Our licensed optometry staff look at your prescription, face width and day-to-day eye use, and try frames on with you one by one.</p>
    <a href="/en/booking/" class="bg-brand-gold text-white font-bold px-8 py-4 rounded-full hover:bg-brand-gold/90 transition-colors inline-block">
      Book a Vision Consultation →
    </a>
  </section>
</Layout>
