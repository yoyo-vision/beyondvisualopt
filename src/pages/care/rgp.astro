---
import Layout from '../../layouts/Layout.astro';
// 顧客照護頁：RGP 配戴指南（配鏡完成後由門市 LINE 傳送連結，顧客手機直接觀看）
// 老闆定案（2026-08-08）：本頁進搜尋索引——條列操作手冊對準「RGP 怎麼戴/怎麼清潔」的 how-to 搜尋意圖，
// 與部落格敘事文（/blog/rgp-daily-wear-care/）分工互連，不互斥
// 設計依「顧客端頁面一律品牌版」：藏藍 #1a2f4e ＋金 #c9a84c，手機優先、單欄、大字級
// ⚠️ 待補（YoYo 店內標準）：沖洗鏡片／洗鏡盒的指定液體，目前寫「依驗光人員教的方式／仿單」

// 各區塊資料（條列操作手冊；粗體判準：只給禁止項與數字）
const SECTIONS = [
  {
    icon: '🧼', title: '配戴前',
    items: [
      '洗手，並把手**徹底擦乾**（別用含油脂、香精、乳液的洗手乳）',
      '把**指甲修短、磨平**，避免刮傷鏡片和角膜',
      '對著光檢查鏡片有沒有破損、缺角、刮痕、洗不掉的霧感',
      '**看到任何一項就先別戴**，把鏡片帶回店裡讓我們檢查',
      '**確認左右眼別**，養成固定順序（例如先右後左），才不會戴反',
      '眼睛紅、癢、痛，或分泌物變多，**當天就別戴**，讓眼睛休息；休息後還是沒好，照本頁最下面的警訊處理',
    ],
  },
  {
    icon: '👁', title: '戴上鏡片',
    items: [
      '把鏡片**凹面朝上**放在指腹，滴 1–2 滴潤濕液',
      '**在桌面上方操作**，桌面先鋪一條淺色毛巾；鏡片萬一滑掉才不會彈走或摔破',
      '撐開上下眼皮，**眼睛直視前方**，把鏡片輕輕放在角膜（黑眼珠）正中央',
      '剛戴會流淚是正常的，眨幾下眼睛等淚液穩定',
      '**一直刺痛就取下**，依驗光人員教的方式沖乾淨再戴一次（**絕對不能用自來水**）',
      '重戴後還是痛，**就別再戴**，打電話問我們',
    ],
  },
  {
    icon: '⏱', title: '配戴時數（適應期關鍵）',
    items: [
      '第 1 天大約戴 **4 小時**，之後每天多戴 1–2 小時（實際進度依驗光人員給你的安排）',
      '大約 **1–2 週**可以戴到全天',
      '每天最多戴 **10–12 小時**',
      '**絕對不要戴著睡覺**，午睡也不行',
      '中斷幾天沒戴，**從比較短的時數重新往上加**，不要一次戴回全天',
    ],
  },
  {
    icon: '🌙', title: '取下與清潔',
    items: [
      '取下後**馬上**用 RGP 專用清潔液，用指腹**單方向搓洗 20–30 秒**',
      '就算產品標示可以免搓洗，**這一步還是要做**（實際做法以仿單為準）',
      '依仿單沖洗乾淨，再泡進**當天新倒的保存液**',
      '**自來水、生水、口水都不能碰到鏡片**',
      '保存液**每天換新**：不重複使用，也不要在舊的裡面補加',
      '**每週去蛋白**一次（實際週期照產品指示）',
      '保存盒每天倒空、洗過、晾乾，大約**每 3 個月換一個新的**——它是最常被忽略的污染源',
    ],
  },
  {
    icon: '📅', title: '日常生活',
    items: [
      '**游泳、泡溫泉、三溫暖、淋浴前，先把鏡片取下**',
      '化妝：**先戴鏡片再上妝**；卸妝前先把鏡片取下',
      '**每 3–6 個月回店追蹤**一次',
      '鏡片壽命大約 **2–3 年**，實際看磨損程度和檢查結果',
      '覺得乾澀，點**硬式鏡片專用的潤濕液**（用哪一種、多久點一次，依仿單）',
      '一直乾澀，回店讓我們重新評估配適',
      '**重新驗光或做眼科角膜檢查之前**，先停戴幾天（停幾天依驗光人員或醫師指示），讓量測回到最準確的狀態',
      '鏡片和鏡盒**不要跟別人共用**',
      '隨身帶一副度數夠用的眼鏡',
    ],
  },
];

// 警訊區獨立呈現（醫療分流，白話化描述，視覺上要跳出來）
const WARNING_SIGNS = [
  '眼睛紅、痛，休息過還是沒好',
  '怕光、看到光就不舒服',
  '眼淚一直流，停不下來',
  '視力突然變模糊',
  '眼屎、分泌物明顯變多',
  '一直覺得眼睛裡有東西',
];

// 粗體標記 → <strong>（條列文字用 ** ** 標重點，渲染時轉換）
const bold = (s: string) => s.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-brand-navy" style="font-weight:600">$1</strong>');
---
<Layout
  title="RGP 硬式隱形眼鏡配戴照護指南｜配戴步驟・清潔・停戴警訊｜能見度視覺中心"
  description="RGP 硬式隱形眼鏡怎麼戴、怎麼清潔？配戴前準備、上鏡步驟、適應期時數（第 1 天 4 小時起）、每日清潔四步、每週去蛋白，以及該立即停戴就醫的警訊，一頁看完。能見度視覺中心 新莊・板橋。"
>
  <!-- 頁首：品牌藏藍，顧客一打開就知道是誰發的 -->
  <section class="bg-brand-navy text-white pt-14 pb-10 px-6 text-center">
    <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-4" style="font-size:12px;letter-spacing:0.22em">能見度視覺中心｜顧客照護指南</p>
    <h1 class="font-serif text-white mb-4" style="font-size:clamp(28px,6vw,40px);font-weight:300">RGP 硬式隱形眼鏡<br />配戴指南</h1>
    <p class="text-white/70 max-w-md mx-auto" style="font-size:15px;line-height:1.8">
      這份指南是通用原則。驗光人員當面教你的方式、你手上產品的仿單，優先於本頁內容。
    </p>
  </section>

  <!-- 操作區塊（順序：戴前→戴上→時數→取下清潔→日常生活，之後接警訊區與門市聯絡） -->
  <section class="px-5 py-10" style="background:#f7f3ec">
    <div class="max-w-lg mx-auto space-y-6">
      {SECTIONS.map(sec => (
        <div class="bg-white border border-brand-ink/8 rounded-2xl p-6">
          <h2 class="font-serif text-brand-navy mb-4 flex items-center gap-2.5" style="font-size:19px;font-weight:600">
            <span style="font-size:22px">{sec.icon}</span>{sec.title}
          </h2>
          <ul class="space-y-3">
            {sec.items.map(item => (
              <li class="flex items-start gap-2.5 text-brand-ink-2" style="font-size:15.5px;line-height:1.75">
                <span class="text-brand-gold mt-0.5 shrink-0">✦</span>
                <span set:html={bold(item)} />
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- 🚨 警訊區：金框強調 -->
      <div class="bg-brand-navy rounded-2xl p-6 text-white border-2 border-brand-gold">
        <h2 class="font-serif text-brand-gold mb-3 flex items-center gap-2.5" style="font-size:19px;font-weight:600">
          <span style="font-size:22px">🚨</span>立即停戴、盡快到眼科就診的警訊
        </h2>
        <ul class="space-y-2 mb-4">
          {WARNING_SIGNS.map(w => (
            <li class="text-white/90 flex items-start gap-2" style="font-size:15px;line-height:1.6">
              <span class="text-brand-gold shrink-0">•</span>{w}
            </li>
          ))}
        </ul>
        <p class="text-white/85 border-t border-white/20 pt-3" style="font-size:14.5px;line-height:1.8">
          出現<strong class="text-brand-gold">任何一項</strong>：先把鏡片取下，<strong class="text-brand-gold">不要硬撐，也不要再戴回去</strong>。<strong class="text-brand-gold">當天就去眼科</strong>，不要等下次回店；把鏡片和保存液一起帶去，幫醫師判斷。
        </p>
      </div>

      <!-- 頁尾：門市聯絡＋回店提醒（顧客照護頁的行動出口） -->
      <div class="bg-white border border-brand-ink/8 rounded-2xl p-6 text-center">
        <p class="font-sans text-brand-ink-3 tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.2em">有任何配戴問題，隨時找我們</p>
        <p class="text-brand-ink-2 mb-1" style="font-size:15px"><strong style="font-weight:600">新莊店</strong>｜新北市新莊區中正路419-1號｜<a href="tel:02-2206-6700" class="text-brand-navy underline underline-offset-2">02-2206-6700</a></p>
        <p class="text-brand-ink-2 mb-4" style="font-size:15px"><strong style="font-weight:600">板橋店</strong>｜新北市板橋區雙十路二段47巷28號｜<a href="tel:02-2253-1246" class="text-brand-navy underline underline-offset-2">02-2253-1246</a></p>
        <a href="https://lin.ee/SoWj9Ft" class="inline-block bg-brand-gold text-brand-navy font-bold px-7 py-3 rounded-full font-sans" style="font-size:14.5px">LINE 線上詢問 →</a>
        <p class="text-brand-ink-3 mt-4" style="font-size:13px;line-height:1.7">
          下次回店追蹤的時間，以取件時驗光人員跟你約好的為準；<br />想多了解 RGP，可以讀 <a href="/guide/rgp-contact-lens/" class="underline underline-offset-2 text-brand-navy">RGP 完整指南</a>。
        </p>
      </div>
    </div>
  </section>
</Layout>
