---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/categories';

// 本指南的主題聚落文章：直接讀分類表「驗光 → 眼科還是驗光所（triage）」小分類，順序＝分類頁閱讀順序
// child-vision-check-where 屬兒童分類，已移出聚落，改由「孩子依年齡」段內文連結
const CLUSTER_SLUGS = CATEGORIES.find(c => c.slug === 'eye-exam')!.subs.find(s => s.slug === 'triage')!.posts;
const allPosts = await getCollection('blog');
const clusterPosts = CLUSTER_SLUGS
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/guide/eye-doctor-or-optometrist/';

// 眼科 vs 驗光所 症狀分流指南：承接 GBP「眼科」搜尋流量（月千次級）的分流頁
// 合規基準：明確自稱驗光所非眼科；紅旗症狀一律「建議儘速至眼科就醫」；發現異常依第十二條第三項轉介。
const faqs = [
  {
    q: '能見度是眼科診所嗎？',
    a: '不是。我們是合法立案的驗光所（比泱驗光所・能見度驗光所），由持照驗光人員執行驗光與配鏡，不是醫療診所、沒有醫師駐診。眼睛疾病的診斷與治療請掛眼科；驗光配鏡過程中如發現視力無法矯正至正常，我們也會依法協助轉介眼科醫師。',
  },
  {
    q: '看不清楚，要先掛眼科還是先來驗光？',
    a: '要看是怎麼變模糊的。突然看不清楚、單眼視力驟降、視野缺損，建議儘速至眼科就醫，這可能是需要醫療處置的狀況。如果是慢慢變得看不清楚、眼鏡度數好像不夠了，多半是屈光問題，可以先來驗光所做完整驗光。自己分不出是哪一種，可以先透過 LINE 描述狀況；但突然發生的那一種，請先就醫，別在等訊息的時間裡耽擱。',
  },
  {
    q: '眼睛紅、痛、有分泌物，可以來驗光所處理嗎？',
    a: '不行。紅腫、疼痛、分泌物、畏光等屬於眼睛疾病的範疇，需要眼科醫師診斷治療，驗光所依法不能也不應處理，建議儘速至眼科就醫。等眼睛治療好、需要配眼鏡了，再來找我們。',
  },
  {
    q: '驗光時發現問題，驗光所會怎麼轉介？',
    a: '度數怎麼換，視力都補不到正常，或驗光過程中發現疑似異常，驗光人員會先停下配鏡，依《驗光人員法》第十二條第三項轉介眼科醫師，並依施行細則第六條第三項填具轉介單，把這次量到的度數與視力一併寫上，讓醫師手上多一份資料。驗光所與眼科醫師協同，各守各的專業：驗光人員不下診斷、不猜原因；醫師檢查完、確認可以配鏡，再回來把眼鏡配好。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "眼睛不舒服要掛眼科，還是去驗光所？依症狀分流一次看懂",
      "dateModified": "2026-10-19",
      "description": "眼睛不舒服要掛眼科還是去驗光所？突然模糊、紅痛怕光、閃光黑點、視野缺角請儘速就醫；慢慢看不清、看近吃力、用眼後痠累可先驗光；孩子依年齡有法定順序。新莊、板橋能見度視覺中心（驗光所，不是眼科）。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="眼睛不舒服掛眼科還是驗光所？依症狀分流指南｜新莊 板橋"
  description="眼睛不舒服要掛眼科還是去驗光所？突然模糊、紅痛怕光、閃光黑點、視野缺角請儘速就醫；慢慢看不清、看近吃力、用眼後痠累可先驗光；孩子依年齡有法定順序。新莊、板橋能見度視覺中心（驗光所，不是眼科）。"
  enPath="/en/guide/eye-doctor-or-optometrist/"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">先說清楚：我們不是眼科</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        眼睛不舒服要掛眼科，還是去驗光所？<br /><span class="text-brand-gold" style="font-size:0.6em">依症狀分流一次看懂</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:17px;line-height:1.85">
        很多人搜「眼科」找到我們。能見度是合法立案的驗光所，不是眼科診所。走錯門，最怕的不是白跑一趟，是把該給醫師看的狀況當成度數問題，拖了下去。
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first，不加標題） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>眼睛紅、痛、怕光，視力突然變差，閃光或黑點突然變多，視野缺了一角：請儘速至眼科就醫。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>慢慢看不清楚、看近吃力、眼鏡戴了不舒服、用眼後痠累：可以先到驗光所做完整驗光。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>孩子依年齡有法定順序：未滿 6 歲由眼科醫師檢查；6～15 歲第一次驗光配鏡，須先經醫師確診為非假性近視。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '30 秒分流', href: '#triage' },
        { label: '依症狀看', href: '#symptoms' },
        { label: '孩子依年齡', href: '#kids' },
        { label: '驗光人員做到哪裡', href: '#roles' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 分流表 -->
  <section id="triage" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-serif text-brand-ink" style="font-size:clamp(24px,3.5vw,38px);font-weight:300">30 秒分流：你的症狀該去哪</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white border-t-4 p-8" style="border-top-color:#b0413e">
          <h3 class="font-serif text-brand-ink mb-2" style="font-size:21px;font-weight:400">需要醫師診斷的症狀</h3>
          <p class="text-brand-ink-3 mb-5" style="font-size:13.5px">這些屬於眼睛疾病範疇，需要醫師診斷治療，請儘速就醫</p>
          <ul class="space-y-3">
            {[
              '眼睛紅、腫、痛、有分泌物、畏光',
              '視力突然變差、單眼看不見、視野缺損',
              '飛蚊突然大量增加、伴隨閃光',
              '眼睛外傷、異物入眼',
              '未滿 6 歲幼童要驗光配鏡（驗光人員依法不得驗光，請由眼科醫師檢查）',
              '6～15 歲學童第一次驗光配鏡（須先經醫師確診為非假性近視）',
              '糖尿病、高血壓等慢性病的定期眼底追蹤',
            ].map(item => (
              <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:15px;line-height:1.7">
                <span class="flex-shrink-0 mt-1" style="color:#b0413e;font-size:12px">●</span>{item}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white border-t-4 border-brand-gold p-8">
          <h3 class="font-serif text-brand-ink mb-2" style="font-size:21px;font-weight:400">驗光所可以處理的狀況</h3>
          <p class="text-brand-ink-3 mb-5" style="font-size:13.5px">屈光與配鏡問題不需要掛號，由持照驗光人員完整評估</p>
          <ul class="space-y-3">
            {[
              '慢慢覺得看不清楚，想確認度數有沒有變',
              '眼鏡戴了頭暈、疲勞、怎麼調都不舒服',
              '想配新眼鏡、多焦點鏡片、自帶框配鏡片',
              '長時間看螢幕眼睛痠，想做視覺評估',
              '已經配過眼鏡的 6～15 歲學童：度數追蹤與配鏡評估（依法於眼科醫師指導下進行）',
              '超過 15 歲：可直接驗光配鏡',
              '一般隱形眼鏡驗配（15 歲以下於眼科醫師指導下進行，未滿 6 歲不得為之）',
              '鏡架調整維修',
            ].map(item => (
              <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:15px;line-height:1.7">
                <span class="text-brand-gold flex-shrink-0 mt-1" style="font-size:12px">●</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-brand-ink-3 mt-8 text-center max-w-2xl mx-auto" style="font-size:14px;line-height:1.8">
        拿不準的狀況，可以先透過 LINE 描述症狀。<strong class="text-brand-ink">紅、痛或突然看不清楚的，不必等回覆，請儘速至眼科就醫。</strong>
      </p>
    </div>
  </section>

  <!-- 依症狀看：聚落文章的入口 -->
  <section id="symptoms" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">依症狀看：模糊、痠痛疲勞、配眼鏡前</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <h3 class="font-serif text-brand-navy" style="font-size:20px;font-weight:600">眼睛突然模糊</h3>
        <p>幾小時、幾天之內變模糊的，請儘速至眼科就醫；同時有紅痛怕光、閃光或黑點突然變多、視野缺了一角，更不要等，換一副眼鏡處理不了這些，要先由醫師找出原因。幾個月、一兩年裡慢慢看不清楚，看遠要瞇眼、看書看手機得把手伸長，多半跟度數有關，可以先到驗光所做完整驗光。分不出是哪一種，可以拿<a href="/blog/blurry-vision-see-doctor/" class="text-brand-gold underline">眼睛突然模糊要馬上看眼科嗎？</a>裡的對照表逐項比。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">眼睛痠痛疲勞</h3>
        <p>眼睛紅、腫、痛、有分泌物、怕光，請儘速就醫。痠累只在盯螢幕或看書一段時間後才出現、看遠看近切換吃力的，可以先驗光，度數、用眼距離、兩眼一起用的狀況，驗光人員都量得到。量完都正常，眼睛還是不舒服，就去看眼科醫師。我們把這三種狀況拆開寫成一篇：<a href="/blog/eye-strain-see-doctor/" class="text-brand-gold underline">眼睛痠痛疲勞要掛眼科嗎？</a>。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">配眼鏡前要不要先看眼科</h3>
        <p>只是度數變了想換眼鏡，年紀又超過 15 歲，直接來驗光所就好，不用先掛號。下面幾種先看眼科再來配：近期剛治療過眼睛或動過眼睛手術、以前配眼鏡就始終矯正不上來、有糖尿病等慢性病卻還沒做過眼底檢查；孩子另有法定順序，見下一段。為什麼偏偏是這幾種，<a href="/blog/eye-exam-before-glasses/" class="text-brand-gold underline">配眼鏡前要先看眼科嗎？</a>逐項說了理由。</p>
      </div>
    </div>
  </section>

  <!-- 孩子依年齡的法定順序：一段摘要，細節連 child-vision-check-where -->
  <section id="kids" class="px-6 md:px-16 py-20" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">孩子的眼睛：依年齡有法定順序</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>孩子要先看眼科還是先驗光，答案不在家長方不方便，在孩子幾歲。《驗光人員法》第十二條與施行細則第六條，已經按年齡把順序定好。我們另外寫了一篇<a href="/blog/child-vision-check-where/" class="text-brand-gold underline">小孩視力不好，先看眼科還是先配眼鏡？</a>，每個年齡會碰到的狀況都放在裡面。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">未滿 6 歲：驗光人員依法不得驗光</h3>
        <p>依《驗光人員法》第十二條，未滿 6 歲的孩子，驗光人員不得為其驗光。這個年紀的視力與屈光檢查，請由眼科醫師進行。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">6～15 歲：第一次須經醫師確診為非假性近視</h3>
        <p>依《驗光人員法施行細則》第六條第二項，6 歲以上、15 歲以下的孩子第一次驗光及配鏡，須先經醫師確診為非假性近視；之後再驗光，15 歲以下仍於眼科醫師指導下進行。第一次到驗光所，請帶著眼科醫師的確診結果。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">超過 15 歲：可以直接找驗光人員</h3>
        <p>法條的「15 歲以下」包含 15 歲，滿 16 歲才可以直接驗光配鏡。不分年齡，眼睛紅、痛、怕光或突然看不清楚，都先給眼科醫師檢查。</p>
      </div>
    </div>
  </section>

  <!-- 眼科醫師和驗光人員各自做什麼（原「是分工不是競爭」） -->
  <section id="roles" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">驗光人員做到哪裡為止</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:16.5px;line-height:1.9">
        <p><strong>眼科醫師</strong>負責眼睛的「健康」：疾病診斷、治療、用藥、手術，散瞳檢查也屬醫療行為。<strong>驗光人員</strong>負責眼睛的「視覺品質」：依《驗光人員法》第十二條執行驗光與配鏡，量度數、評估兩眼一起用的狀況、量配鏡參數、調整鏡架。</p>
        <p>能見度新莊、板橋兩間門市，每次驗光都做雙眼視覺評估，一次驗光約 45–60 分鐘。門市沒有眼壓計和視野計，不量眼軸、不做乾眼檢查、不散瞳，這些請由眼科安排。</p>
        <p>驗光過程中，鏡片一組一組換過去，視力始終到不了正常，驗光人員就停在這裡，不往配鏡走。依《驗光人員法》第十二條第三項，視力不能矯正至正常者，應轉介醫療機構診治。兩種執照、業務範圍與健保怎麼不同，是<a href="/blog/optometry-vs-ophthalmology/" class="text-brand-gold underline">眼科和驗光所差在哪？</a>這篇的主題。</p>
        <p>搜「眼科」找到這裡的人，真的需要就醫，請別耽誤；其實是配鏡問題的，那你來對地方了。</p>
      </div>
      <div class="mt-10 text-center">
        <a href="/booking/"
          class="font-sans inline-block bg-brand-navy text-brand-paper px-8 py-4 hover:bg-brand-ink transition-colors"
          style="font-size:15px;letter-spacing:0.08em">查看可約時段</a>
