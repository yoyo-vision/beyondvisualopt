            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">{f.a}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-3 mt-10 text-center" style="font-size:13px;line-height:1.8">
        新莊店 02-2206-6700・板橋店 02-2253-1246
      </p>
