      </div>
      <a href="/topics/lenses/" class="inline-block mt-8 font-sans text-brand-gold hover:text-brand-navy transition-colors" style="font-size:15px">依主題看鏡片全部文章 →</a>
    </div>
  </section>

  <!-- CTA（按鈕改「預約視覺諮詢」#34） -->
  <section class="px-6 py-20" style="background:#1a2f4e">
