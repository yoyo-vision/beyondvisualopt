---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/categories';

// 2026-10-23 改版（規劃書 5-1）：範圍從「品牌」擴大到整個鏡片分類，網址不變（避免 301 與外部連結失效）
// 本指南的主題聚落文章：直接讀分類表「鏡片」4 個小分類，依小分類分組呈現，順序＝分類頁閱讀順序
const LENSES = CATEGORIES.find(c => c.slug === 'lenses')!;
const allPosts = await getCollection('blog');
const clusterGroups = LENSES.subs.map(s => ({
  name: s.name,
  posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
}));
// 分類外的延伸卡（findCategory 一篇只能屬一個小分類，這三篇留在老花／高度近視分類）
const EXTRA_SLUGS = ['zeiss-individual-worth-it', 'progressive-corridor-brands', 'high-myopia-lens-brand-choice'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/guide/lens-brands/';

// 指南頁 FAQ：全站 FAQPage（src/content＋src/pages）grep 過，不跟 17 篇聚落文與服務頁撞題
// 原「蔡司和 HOYA 哪個好」撞 hoya Q3、原「鏡片品牌差在哪」撞 1-1 主意圖、規劃書擬的「折射率越高越好嗎」撞 lens-refractive-index Q1、
// 「新莊、板橋可以配哪些品牌」撞 zeiss-hoya-nikon Q2，四題全換成只有這份指南答得出來的題目
const faqs = [
  {
    q: '選鏡片要先挑品牌，還是先挑設計等級？',
    a: '先挑設計等級。標準設計、數位優化、個人化訂製，這幾級之間的落差，往往比同一級裡換個品牌還大。等級照你的度數和平常最常看的距離定好，再拿同一級的鏡片互相比，這時候看到的差別才算是品牌的。能見度經銷蔡司 ZEISS（簽約認證經銷）與 HOYA，兩家都能拉到同一級來比。',
  },
  {
    q: '設計、折射率、鍍膜，只能升級一項的話，先升哪一項？',
    a: '看你現在最受不了的是哪一件。嫌鏡片邊緣厚、整副戴著重，先看鏡框是不是偏大；框不大，才輪到折射率。折射率往上換，反光也會跟著變多，抗反射鍍膜最好一起看。鏡片周邊看東西不夠清楚，或是多焦點看電腦那一區太窄，要從設計下手。反光多、指紋怎麼擦都還在、沒多久就刮花，就升鍍膜。三件都還好的話，維持原本的等級也可以。',
  },
  {
    q: '到門市挑鏡片之前，要先想好哪些事？',
    a: '先算算眼睛一天花在哪些距離：開車多久、電腦前坐多久、手機和書又看多久，晚上會不會開車，工作是不是常待在戶外。手上那副舊眼鏡別忘了戴著出門，哪裡戴得順、哪裡老是卡，到店裡一起講。帶著這些來，比先想好要哪個品牌，更能幫驗光人員找到適合你的鏡片。',
  },
  {
    q: '鏡片可以先看樣片再決定嗎？',
    a: '可以。能見度門市有藍光過濾鏡片和玻璃鏡片的樣片，顏色、斜著看的反光，都能當場看，玻璃那片也可以跟樹脂的比比哪片重。門市目前沒有防霧鏡片。設計等級就不一樣了，樣片捏在手上看不出差別，要戴上去往外看才分得出來，這一段會由驗光人員照你的度數和平常看的距離來說明。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "鏡片怎麼選？先看設計等級，再看折射率、鍍膜，最後才比品牌",
      "dateModified": "2026-10-23",
      "description": "鏡片怎麼選？先看設計等級（標準、數位優化、個人化訂製），再依度數挑折射率、依生活習慣選鍍膜，最後才比品牌。YoYo 驗光師整理選鏡片的順序與 17 篇專文。能見度是蔡司 ZEISS 簽約認證經銷、HOYA 經銷，新莊、板橋兩店。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="鏡片怎麼選｜蔡司 ZEISS・HOYA 鏡片品牌、折射率、鍍膜完整指南｜新莊板橋"
  description="鏡片怎麼選？先看設計等級，再依度數挑折射率、依生活習慣選鍍膜，最後才比品牌。YoYo 驗光師整理選鏡片的順序：標準、數位優化、個人化訂製怎麼分，1.60、1.67、1.74 怎麼落點。蔡司 ZEISS 簽約認證經銷、HOYA 經銷，新莊、板橋能見度視覺中心。"
  enPath="/en/guide/lens-brands/"
  schema={schema}
>

  <!-- Hero：H1 帶副標（範圍從品牌擴大到整個鏡片分類） -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        鏡片怎麼選？<br /><span class="text-brand-gold" style="font-size:0.6em">先看設計等級，再看折射率、鍍膜，最後才比品牌</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto mb-8" style="font-size:17px;line-height:1.85">
        同一個品牌的鏡片，戴起來也可能差很遠，差在哪一級設計、多高的折射率、鍍了哪幾層膜。連同品牌在內，哪一件先談、哪一件留到最後，YoYo 驗光師都寫在這一頁，每一件都接得到專文。
      </p>
      <a href="/booking/"
        class="font-sans inline-block bg-brand-gold text-brand-navy font-bold px-8 py-4 hover:bg-brand-gold/90 transition-colors"
        style="font-size:15px;letter-spacing:0.08em">預約視覺諮詢</a>
      <p class="text-white/50 mt-4" style="font-size:13px;letter-spacing:0.05em">諮詢不代表要消費・全程不推銷・可隨時改期</p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first，不加標題） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>能見度是蔡司 ZEISS 簽約認證經銷、HOYA 經銷；NIKON、依視路不經銷也不代訂，可以做比較諮詢。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>設計等級先定，品牌後比：同一個牌子上下等級的落差，常常比換一個牌子還大。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>折射率影響的是鏡片厚薄和重量，數字往上加，看出去並不會因此比較清楚。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>反光、好不好擦、耐不耐刮，看的是鍍膜。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '選鏡片的順序', href: '#order' },
        { label: '設計等級', href: '#design' },
        { label: '折射率與厚薄', href: '#index' },
        { label: '設計與鍍膜', href: '#coating' },
        { label: '品牌與取得方式', href: '#brands' },
        { label: '依用眼習慣選', href: '#habits' },
        { label: '門市與預約', href: '#stores' },
        { label: '鏡框先定上限', href: '#frame' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 起：選鏡片的順序（原「品牌差的不是 logo」改寫，刪「眼睛脹不脹、脖子痠不痠」#7） -->
  <section id="order" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">選鏡片的順序：設計、折射率、鍍膜、品牌</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>配一副鏡片，下單前要定下來的事有四件。四件都會改變你戴起來的感覺，只是份量不一樣。我們排的順序是：設計等級先定，折射率看度數和鏡框來挑，鍍膜接在後面，品牌留到最後才比。</p>
        <p>設計排第一，因為它決定你看出去的範圍怎麼分配：遠、中、近要不要接在同一片上，看近的時候有沒有額外的支援，視線往旁邊移的時候，邊緣的影像怎麼處理。對每天盯螢幕十小時的人，這幾件事最後會收成一個很實際的問題：看螢幕的時候，視線穿過的是鏡片哪一區？那一區又有多寬？</p>
        <p>折射率和鍍膜夾在中間。折射率跟著度數走，決定鏡片多厚多重。鍍膜要看的是生活習慣，像是你一天要摘戴、擦拭幾次，平常多待在室內還是戶外。</p>
        <p>品牌放最後，倒不是它不重要。前三件沒定，根本不知道該拿哪一級去跟哪一級比。等級沒對齊就比品牌，比出來的其實是等級，不是牌子。</p>
      </div>
    </div>
  </section>

  <!-- 承 1：設計等級（原深藍「等級比品牌更關鍵」移上來；刪 SeeMax #4、刪「處方」「從源頭訂製」；參數依 Q3，不量頭部轉動） -->
  <section id="design" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">鏡片設計等級：標準、數位優化、個人化</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">一個品牌底下分好幾級，差在兩件事：度數怎麼鋪到整片鏡面上，還有計算時套的是大家的平均值，還是你本人量出來的數字。</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { level: '標準設計', desc: '用一組平均的配戴參數來設計：鏡框離眼睛多遠、往前傾幾度，大家共用同一組假設。度數單純、平常用眼距離變化不大的人，從這一級開始就夠用。', fit: '入門' },
          { level: '數位優化設計', desc: '依你的度數去計算鏡片表面每一點的弧度。單光鏡片的周邊、多焦點的走廊和兩側的過渡，都照你的度數重新排過一次。', fit: '主流' },
          { level: '個人化訂製', desc: '度數之外，再把你戴上選好的那支框之後量到的四個數字算進去：頂點距離、前傾角、面彎角、配鏡高度。新莊、板橋兩店都接個人化訂製，蔡司 Individual² 屬於這一級。', fit: '訂製' },
        ].map(item => (
          <div class="bg-white/5 rounded-2xl p-7 border border-white/10 flex flex-col">
            <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">{item.fit}</span>
            <h3 class="font-serif text-white mb-3" style="font-size:19px;font-weight:600">{item.level}</h3>
            <p class="text-white/60" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-white/70 mt-8" style="font-size:16px;line-height:1.8">
        個人化這一級，什麼情況值得、什麼情況可以省？想自己先判斷一下，可以從<a href="/blog/zeiss-individual-worth-it/" class="text-brand-gold underline">頂規多焦點鏡片值得嗎？個人化訂製和一般多焦點差在哪</a>開始。
      </p>
    </div>
  </section>

  <!-- 承 2：折射率與厚薄（新增，聚落入口；阿貝數定義不重抄，連 2-1；厚薄公式歸 2-2） -->
  <section id="index" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">折射率與厚薄：1.60、1.67、1.74 怎麼落點</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <h3 class="font-serif text-brand-navy" style="font-size:20px;font-weight:600">折射率是什麼</h3>
        <p>折射率講的是鏡片材料能把光折多彎。數字越高，同樣的度數，鏡片就能做得越薄越輕。可是有一樣東西得讓出去，那就是色散：折射率一拉高，從鏡片邊緣看亮的東西，輪廓旁邊容易泛出顏色。厚薄和色散一升一降的關係，<a href="/blog/lens-refractive-index/" class="text-brand-gold underline">鏡片折射率是什麼？</a>用一張表就看得懂。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">依度數選折射率</h3>
        <p>度數淺的人，1.60 跟 1.67 擺在一起，厚薄其實差不了多少。要等度數深了，往上換一級才開始看得出差別。到底幾度該換哪一級，鏡框大一號邊緣又會厚多少，<a href="/blog/lens-index-160-vs-167-vs-174/" class="text-brand-gold underline">1.60、1.67、1.74 怎麼選？</a>是直接拿公式算的。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">玻璃還是樹脂</h3>
        <p>現在門市配出去的，大多是樹脂鏡片。還會指定玻璃的人，在意的是表面耐刮，不過鏡片會重一些，掉到地上也可能就碎了。重量、安全、加工，兩種材質一共有六個地方不同，想逐項比，看<a href="/blog/glass-vs-resin-lens/" class="text-brand-gold underline">玻璃鏡片和樹脂鏡片差在哪？</a>。</p>
      </div>
    </div>
  </section>

  <!-- 承 3：設計與鍍膜（新增，聚落入口；抗藍光原理歸 3-4，不接效益） -->
  <section id="coating" class="px-6 md:px-16 py-20" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡片設計與鍍膜：非球面、鍍膜、藍光過濾</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <h3 class="font-serif text-brand-navy" style="font-size:20px;font-weight:600">非球面</h3>
        <p>非球面改的是鏡片中間到外圍那一路的弧度。從鏡片外圍看出去的影像正不正，跟它有關，鏡片看起來也會扁平一點。度數越深，邊緣的差別越容易被你察覺。差到幾度才換得出感覺，<a href="/blog/aspheric-vs-spherical-lens/" class="text-brand-gold underline">非球面鏡片是什麼？</a>有一段度數區間，找你自己落在哪一格。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">鍍膜怎麼選</h3>
        <p>鍍膜處理的是鏡片表面那幾件事：反光多不多、指紋擦不擦得掉、刮痕來得快不快。一片鏡片上常常疊好幾層膜，該要哪幾層，得看你每天怎麼用這副眼鏡，<a href="/blog/lens-coating-guide/" class="text-brand-gold underline">鏡片鍍膜有哪些？</a>是照生活習慣一種一種配的。至於抗反射為什麼鍍一層膜就不反光？這跟光的波長有關，有興趣可以讀<a href="/blog/anti-reflective-coating-principle/" class="text-brand-gold underline">抗反射鍍膜是什麼？</a>。</p>
        <h3 class="font-serif text-brand-navy pt-4" style="font-size:20px;font-weight:600">藍光過濾在濾什麼</h3>
        <p>藍光過濾鏡片有兩種做法：讓鏡片材料自己吸收，或是靠表面鍍膜反射掉，兩種從外觀就分得出來。濾掉的到底是哪一段波長，兩種做法又差在哪，<a href="/blog/blue-light-filter-what/" class="text-brand-gold underline">藍光過濾鏡片在濾什麼？</a>都有交代。</p>
