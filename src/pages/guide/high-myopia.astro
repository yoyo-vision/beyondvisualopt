---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, GUIDE_TITLES } from '../../data/categories';

// 2026-10-24 改版（高度近視規劃書 5-1）：指南改做入口，細節讓給聚落文（互搶 A/B/C/D/H/L）；補散光、兩眼度數差很多兩個入口；眼底衛教升為轉；網址不變
// 聚落：直接讀分類表「高度近視」3 個小分類，依小分類分組，順序＝分類頁閱讀順序
// 小分類有自己的指南（兩眼度數差很多 → /guide/aniseikonia/）就出指南卡，兩份指南從聚落互連
const SELF = '/guide/high-myopia/';
const HM = CATEGORIES.find(c => c.slug === 'high-myopia')!;
const allPosts = await getCollection('blog');
const clusterGroups = HM.subs.map(s => ({
  name: s.name,
  posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
  guide: s.guide && s.guide !== SELF ? s.guide : null,
}));
// 分類外延伸卡（#36）：頂點距離、折射率、頭暈、不舒服、隱形眼鏡各有正主，不搬進本分類
const EXTRA_SLUGS = ['vertex-distance', 'lens-index-160-vs-167-vs-174', 'glasses-dizzy', 'glasses-uncomfortable-3-reasons', 'contact-lens-vs-glasses'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);
const ANISO_GUIDE = '/guide/aniseikonia/';
const RGP_GUIDE = '/guide/rgp-contact-lens/';

const canonicalUrl = 'https://beyondvisualopt.com/guide/high-myopia/';

// 指南頁 FAQ：全站 FAQPage grep 過，不跟聚落文、/services/ 撞題
// 原 Q2「為什麼邊緣特別厚」歸 brand-choice（互搶 D）；規劃書擬的「高度近視可以做無框或半框嗎」撞 rimless-glasses-guide FAQ「高度近視適合無框眼鏡嗎？」，改「幾度算高度近視」
// 原 Q3「1.74 值得加價嗎」撞 lens-index-160 FAQ（互搶 C），改眼科檢查頻率（7-3 動筆時 FAQ Q1 要換題，避開本題）
const faqs = [
  {
    q: '近視 1000 度可以配薄鏡片嗎？',
    a: '可以。近視鏡片中間薄、厚度堆在外圈，1000 度要讓外圈薄下來，框挑小一點、框心距貼近你的單眼瞳距、折射率用到 1.74，三件一起做。本店經銷品牌的樹脂鏡片，折射率最高到 1.74。',
  },
  {
    q: '近視幾度算高度近視？',
    a: '一般以近視 600 度（-6.00D）以上算高度近視，國際近視研究學會（IMI）2019 年發表的定義，就是用 -6.00D 當分界。到了這個度數，頂點距離、單眼瞳距、配鏡高度只要差一點，戴起來就有感；眼睛健康方面，依國健署與中華民國眼科醫學會公開衛教資料，高度近視日後發生視網膜病變的風險也比較高，請定期給眼科醫師檢查。',
  },
  {
    q: '高度近視多久要給眼科檢查一次？',
    a: '國健署「護眼 123」建議每年檢查視力 1 到 2 次；高度近視的人，眼底要不要一併檢查、多久檢查一次，由眼科醫師依你的眼睛狀況決定。飛蚊或閃光突然變多，不必等到下次回診，請當天就醫。度數和雙眼視覺是驗光的範圍，眼科這一趟省不掉。',
  },
  {
    q: '新莊、板橋哪裡可以配高度近視眼鏡？',
    a: '能見度兩間店都可以：新莊店是能見度視覺中心（比泱驗光所），新北市新莊區中正路 419-1 號，02-2206-6700，捷運新莊站；板橋店是能見度眼鏡行（能見度驗光所），新北市板橋區雙十路二段 47 巷 28 號，02-2253-1246，捷運江子翠站。量測照同一套（頂點距離、單眼瞳距、配鏡高度），驗光一定包含雙眼視覺評估，RGP 硬式隱形眼鏡兩邊也都能驗配。別家配的眼鏡戴得不舒服，一樣可以拿來給驗光人員看。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "高度近視配眼鏡要多顧哪幾件事？量測、厚薄、散光、隱形眼鏡和眼底檢查",
      "dateModified": "2026-10-24",
      "description": "高度近視配眼鏡要多顧哪幾件事？600 度以上，頂點距離、單眼瞳距、配鏡高度的小誤差會被度數放大；鏡片厚薄先看鏡框和瞳距，再看折射率；散光高、兩眼度數差很多各有要注意的地方；框架、軟式隱形眼鏡、RGP 怎麼選；眼底檢查屬眼科，請定期給眼科醫師檢查。YoYo 驗光師整理，新莊、板橋兩店。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="高度近視配眼鏡｜600度以上要量什麼・鏡片厚薄・隱形眼鏡・眼底檢查｜新莊板橋 能見度視覺中心"
  description="高度近視配眼鏡要多顧哪幾件事？600 度以上，頂點距離、單眼瞳距、配鏡高度的小誤差會被放大；鏡片厚薄先看鏡框和瞳距再看折射率；散光、兩眼度數差很多、隱形眼鏡與 RGP 怎麼選，以及為什麼要定期給眼科醫師檢查。新莊、板橋能見度視覺中心。"
  enPath="/en/guide/high-myopia/"
  schema={schema}
>

  <!-- Hero：H1 帶副標；四個名詞對應下面的量測、厚薄、隱形眼鏡、眼底四段（#32 刪「一頁講透」「不是產品型錄」） -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        高度近視配眼鏡要多顧哪幾件事？<br /><span class="text-brand-gold" style="font-size:0.6em">量測、厚薄、散光、隱形眼鏡和眼底檢查</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto mb-8" style="font-size:17px;line-height:1.85">
        600 度以上的人配眼鏡，要多顧的就那幾件，只是每一件都比較容不下誤差。YoYo 驗光師寫給度數深、正要配新眼鏡的人。
      </p>
      <a href="/booking/"
        class="font-sans inline-block bg-brand-gold text-brand-navy font-bold px-8 py-4 hover:bg-brand-gold/90 transition-colors"
        style="font-size:15px;letter-spacing:0.08em">預約視覺諮詢</a>
      <p class="text-white/50 mt-4" style="font-size:13px;letter-spacing:0.05em">諮詢不代表要消費・全程不推銷・可隨時改期</p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first，不加標題；#22 度數區間不放這裡，交給 lens-index-160） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>600 度以上，頂點距離、單眼瞳距、配鏡高度的小誤差，會被度數放大。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>鏡片厚薄先看鏡框和瞳距，再看折射率。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>散光高，多一個軸向要對；兩眼度數差很多，左右看到的大小會不同。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>眼底檢查屬於眼科，請定期給眼科醫師檢查。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽（含起 #why、轉 #retina 錨點） -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '為什麼不一樣', href: '#why' },
        { label: '要多量的幾項', href: '#measure' },
        { label: '鏡片厚薄', href: '#thickness' },
        { label: '散光高', href: '#astigmatism' },
        { label: '兩眼度數差很多', href: '#anisometropia' },
        { label: '框架・隱形眼鏡・RGP', href: '#options' },
        { label: '門市與預約', href: '#stores' },
        { label: '數字背後的眼球', href: '#retina' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
        { label: '主題文章', href: '#cluster' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 起：600 度以上為什麼不一樣（#1 頂點距離表已在第 1 步修正；互搶 B：換算表正主是 vertex-distance，這裡只留一個例子＋連結） -->
  <section id="why" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">600 度以上配眼鏡，為什麼跟一般人不一樣</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>200 度和 800 度的人走進驗光室，要做的檢查大致一樣，差別在數字禁不禁得起一點偏差。量的時候差個一兩毫米，200 度的人大概沒感覺；到了 600 度以上，同樣的偏差就可能變成看遠有點霧、戴久了頭暈，或是走路時覺得地板斜了一點。</p>
        <p>最常見的是<strong>頂點距離</strong>，也就是鏡片後表面到角膜的距離。驗光時，鏡片離眼睛大約 12mm；真正戴上鏡框，會因為鼻托高低和臉型，落在不一樣的位置。套進 Fc＝F ÷（1 − dF） 算一下：-6.00D 的鏡片從 12mm 移到 8mm，有效度數約差 0.14D，也就是約 14 度；同樣移近 4mm，換成 -14.00D，就差到約 74 度。想查自己的度數會差多少，去翻<a href="/blog/vertex-distance/" class="text-brand-gold underline">頂點距離是什麼？</a>的換算表，隱形眼鏡的度數換算也在同一篇。</p>
        <p>另一個會被度數放大的，是<strong>稜鏡效應</strong>。視線沒有穿過鏡片的光學中心，影像就會被偏開一點，偏多少，看偏心量（公分）跟度數相乘的結果。同樣偏 3mm，-2.00D 是 0.6△，幾乎沒人察覺；-8.00D 是 2.4△，兩眼就得多出點力，才疊得起同一張影像。</p>
      </div>
    </div>
  </section>

  <!-- 承 1：要多量的幾項（原深藍「這些量測不能省」縮成一段連 1-1，互搶 A；刪「快速驗光」#6、「定期回店…不是售後客套」#7） -->
  <section id="measure" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">高度近視要多量的幾項</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>所以到了 600 度以上，量測要多顧<strong>四項</strong>。頂點距離要跟著你挑的那支框重算；瞳距分成左右兩個數字量，不拿總瞳距除以二；配鏡高度只能在你戴上那支框之後量，框一換就重來。第四項最常被忘掉：現在戴的舊眼鏡也帶來，鏡片驗度儀會把舊鏡片的度數跟光學中心位置讀一遍，新舊兩副才對得起來。</p>
        <p>每一項怎麼量、量歪一點會怎樣，<a href="/blog/high-myopia-glasses-guide/" class="text-brand-gold underline">高度近視配眼鏡要量哪幾項？</a>拿 -8.00D 的鏡片當例子，每一項都有數字。住中和、還在猶豫要不要乾脆跑去台北配的，那篇講門市的地方也順便交代了。</p>
      </div>
    </div>
  </section>

  <!-- 承 2：鏡片厚薄（原「折射率怎麼選」「鏡框選擇原則」兩個 H2 合併；刪折射率表、阿貝數段，度數區間對齊 lens-index-160 #22 互搶 C；
       刪 50mm 規則句、框心距用詞修正 #27；刪「最佳平衡點」「價格最高」#26；刪「框選錯了，最貴的鏡片也救不回來」#34） -->
  <section id="thickness" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡片厚薄：先看鏡框和瞳距，再看折射率</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">近視鏡片的厚度都堆在外圈，度數越高，堆得越多。下面三張卡，削得掉最多的排在最前面。</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
          <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">尺寸</span>
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">鏡框大小與偏心量</h3>
          <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">框越寬，鏡片得從離光學中心越遠的地方裁，留下來的正是最厚的那一圈。框心距指的是左右鏡框中心點的距離，它跟你的瞳距相差越多，光學中心偏得越遠，鏡片外側也越厚。48 跟 54 的框各裝同一個度數會各厚多少，去看<a href="/blog/high-myopia-lens-brand-choice/" class="text-brand-gold underline">高度近視要選蔡司還是 HOYA？</a>裡的公式和表。</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
          <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">折射率</span>
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">1.60、1.67、1.74 怎麼選</h3>
          <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">每往上升一級折射率，邊緣多出來的那段厚度，大約削掉一成。400 度以下多半停在 1.60；400 到 600 度先看框，再決定要不要換 1.67；600 度以上要用 1.74，框得先選小。店裡的樹脂鏡片，最高就到 1.74。三級各薄多少、阿貝數差在哪，見<a href="/blog/lens-index-160-vs-167-vs-174/" class="text-brand-gold underline">1.60、1.67、1.74 怎麼選？</a>。</p>
        </div>
        <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
          <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">配戴</span>
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">板材框緣與鼻托</h3>
          <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">粗一點的板材框緣，能把鏡片側邊的厚度遮掉一部分；鏡片邊緣也可以做倒角、拋光或霧面。框還得坐得穩，一路往鼻頭滑，鏡片離眼睛的距離就一路在變，度數高的人馬上有感。鼻樑低、框容易滑的，挑有可調鼻托的款式，或請驗光人員把鼻托跟鏡腳調好。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 承 3：散光高（新增聚落入口，接住「散光與變形」2 篇的回連；JCC 卡縮成一句連 astig，互搶 L） -->
  <section id="astigmatism" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">散光高的人：軸向和變形感</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">度數深的人，驗光單上 CYL 那一欄常常也不是空的。散光鏡片橫的、直的度數不同，多出一個角度要對，剛戴上也比較容易覺得東西歪掉。</p>
      <div class="space-y-8">
        <div class="border-t border-brand-ink/10 pt-6">
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">散光眼鏡為什麼會變形</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">橫的、直的放大得不一樣，剛戴上時地板像往一邊傾、門框有點彎，多數是大腦還沒跟上這副鏡片。軸向也得量準。電腦驗光給的軸向是初始值，驗光人員會再用交叉圓柱鏡（JCC）請你比一比，主觀確認。偏 10 度，散光就有大約三分之一沒矯正到。<a href="/blog/astigmatism-glasses-distortion/" class="text-brand-gold underline">散光眼鏡戴起來地板斜、直線彎，是正常的嗎？</a>裡有這個數字的算式，也講了適應期多長還算正常。</p>
        </div>
        <div class="border-t border-brand-ink/10 pt-6">
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">近視和散光差在哪</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">近視的光，焦點停在視網膜前方；散光的光，根本聚不成一個點。兩件事可以同時出現在一隻眼睛上，所以驗光單才分成 SPH 一欄、CYL 和 AXIS 兩欄。常被問的兩題，散光是不是近視太深變的、會不會跟著越來越深，<a href="/blog/myopia-vs-astigmatism/" class="text-brand-gold underline">近視和散光差在哪？</a>都回答了。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 承 4：兩眼度數差很多（新增，兩份指南互連；白內障單眼一句帶過，第 4 步另寫專文） -->
  <section id="anisometropia" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">兩眼度數差很多</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>左右眼度數差得多，兩片鏡片就一厚一薄，透過它們看出去的東西也不一樣大；一低頭看書，兩片鏡片下緣把影像偏開的量也對不上。遇到這種度數，左右影像大小差了多少，驗光人員會先把它量出來，再決定要不要在度數正確的前提下，指定兩片鏡片的基弧與中心厚度。一眼剛做完白內障手術、另一眼還沒做的人，碰到的也是同一件事；手術怎麼排、術後多久能配眼鏡，都聽眼科醫師的。</p>
        <p>放大率跟哪幾件事有關、戴起來會有哪些感覺、小孩為什麼要先看眼科，另外有一份<a href={ANISO_GUIDE} class="text-brand-gold underline">{GUIDE_TITLES[ANISO_GUIDE]}</a>專門處理。</p>
      </div>
    </div>
  </section>

  <!-- 承 5：框架、軟式隱形眼鏡、RGP（原表縮成 H3 ×3；補 §12 #21；刪「無角膜健康風險」「8–12 小時」「1–3 個月」#28；RGP 店別依 9e14b27） -->
  <section id="options" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">框架、軟式隱形眼鏡、RGP 怎麼選</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">三種各有要讓步的地方。挑哪一種，先看眼睛本身的條件，再看你一天裡眼睛都花在哪。</p>
      <div class="space-y-8">
        <div class="border-t border-brand-ink/10 pt-6">
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">框架眼鏡</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">戴脫方便，散光度數也比較穩。度數高的人要接受幾件事：鏡片邊緣比較厚、整副比較重，鏡框外圍的視野有限，看出去的東西也會比實際小一點。</p>
        </div>
        <div class="border-t border-brand-ink/10 pt-6">
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">軟式隱形眼鏡</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">貼在角膜上，沒有鏡框擋住視野。高度近視的隱形眼鏡度數要經過頂點距離換算，通常比眼鏡淺，直接拿眼鏡度數去買，容易配得過深。散光高的人，軟式鏡片在眼睛上可能轉動，軸向跟著跑掉。能戴多久、會不會乾，得等驗光人員查過角膜、看過淚液，才給得出建議。依驗光人員法第十二條，十五歲以下者的隱形眼鏡驗配須在眼科醫師指導下為之，未滿六歲者不予驗配。框架和隱形眼鏡怎麼取捨，見<a href="/blog/contact-lens-vs-glasses/" class="text-brand-gold underline">隱形眼鏡 vs 眼鏡，哪個比較好？</a>。</p>
        </div>
        <div class="border-t border-brand-ink/10 pt-6">
          <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">RGP 硬式隱形眼鏡</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.85">RGP 是依角膜形狀訂製的硬式鏡片，散光高的人可以多一個選項，剛開始戴需要一段適應期。兩店都驗配 RGP：新莊店以 TOPCON CA-800 角膜地形圖暨像差儀了解角膜形狀，板橋店以裂隙燈評估鏡片配適。適不適合、要怎麼開始，先看<a href={RGP_GUIDE} class="text-brand-gold underline">{GUIDE_TITLES[RGP_GUIDE]}</a>。</p>
        </div>
      </div>
    </div>
  </section>

