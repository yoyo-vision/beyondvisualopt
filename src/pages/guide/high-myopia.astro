      <h2 class="font-serif text-brand-ink mb-10" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">高度近視主題文章</h2>
      {clusterGroups.map(g => (
        <div class="mb-12">
          <p class="font-sans text-brand-ink-3 tracking-widest uppercase mb-5" style="font-size:12px;letter-spacing:0.18em">{g.name}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {g.guide && (
              <a href={g.guide} class="rounded-2xl p-7 border border-brand-gold/40 hover:border-brand-gold transition-colors group" style="background:#eee8da">
                <span class="bg-brand-gold text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">完整指南</span>
                <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">{GUIDE_TITLES[g.guide]}</h3>
                <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">左右眼度數差好幾百度，新眼鏡反而戴得更暈：影像大小對不上、低頭看書的稜鏡差，還有小孩為什麼先看眼科。</p>
              </a>
            )}
            {g.posts.map(post => (
              <a href={`/blog/${post!.slug}/`} class="rounded-2xl p-7 border border-brand-ink/10 hover:border-brand-gold transition-colors group" style="background:#f7f3ec">
                <span class="bg-brand-light text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">{post!.data.tag}</span>
                <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">{post!.data.title}</h3>
                <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">{post!.data.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div>
        <p class="font-sans text-brand-ink-3 tracking-widest uppercase mb-5" style="font-size:12px;letter-spacing:0.18em">頂點距離、折射率、頭暈與隱形眼鏡</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {extraPosts.map(post => (
            <a href={`/blog/${post!.slug}/`} class="rounded-2xl p-7 border border-brand-gold/40 hover:border-brand-gold transition-colors group" style="background:#eee8da">
              <span class="bg-brand-light text-brand-navy text-xs font-semibold px-3 py-1 rounded-full">{post!.data.tag}</span>
              <h3 class="font-serif text-brand-navy mt-4 mb-3 group-hover:text-brand-gold transition-colors" style="font-size:18px;font-weight:600;line-height:1.5">{post!.data.title}</h3>
              <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">{post!.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
      <a href="/topics/high-myopia/" class="inline-block mt-8 font-sans text-brand-gold hover:text-brand-navy transition-colors" style="font-size:15px">依主題看高度近視全部文章 →</a>
    </div>
  </section>

  <!-- CTA（按鈕改「預約視覺諮詢」#33；刪「不該只是選個 1.74 然後回家」#34） -->
  <section class="px-6 py-20" style="background:#1a2f4e">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,34px);font-weight:300">差一兩毫米就可能有感，量的時候別趕</h2>
      <p class="text-white/60 mb-8" style="font-size:16px;line-height:1.8">框跟鏡片同一天挑，量測才能照著那支框來，預約請留 60–90 分鐘。新莊、板橋都能約；舊的那副別留在家裡。</p>
      <a href="/booking/" class="inline-block bg-brand-gold text-brand-navy font-bold px-8 py-3.5 rounded-full hover:bg-brand-gold/90 transition-colors font-sans" style="font-size:15px">預約視覺諮詢 →</a>
    </div>
  </section>

  <!-- 延伸閱讀：指南聚落互連（法務 🟢 純導覽；規劃書 5-1 加不等像、RGP 兩份） -->
  <section class="px-6 md:px-16 py-14 border-t border-brand-ink/10" style="background:#eee8da">
    <div class="max-w-5xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-6" style="font-size:12px;letter-spacing:0.18em">延伸閱讀｜其他完整指南</span>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { href: ANISO_GUIDE, t: GUIDE_TITLES[ANISO_GUIDE] },
          { href: RGP_GUIDE, t: GUIDE_TITLES[RGP_GUIDE] },
          { href: '/guide/lens-brands/', t: '鏡片選購完整指南' },
          { href: '/guide/frames/', t: '鏡框選購完整指南' },
          { href: '/guide/optical-basics/', t: '視光小百科' },
        ].map(g => (
          <a href={g.href} class="block bg-brand-paper border border-brand-ink/10 px-5 py-4 hover:border-brand-gold transition-colors font-serif text-brand-navy" style="font-size:16px;font-weight:400">{g.t} →</a>
        ))}
      </div>
      <a href="/blog/" class="inline-block mt-6 font-sans text-brand-gold hover:text-brand-navy transition-colors" style="font-size:14px">← 回配鏡知識</a>
    </div>
  </section>

</Layout>
