---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, GUIDE_TITLES } from '../../data/categories';

// 2026-10-26 改版（隱形眼鏡規劃書 5-1）：指南改做入口，補軟式聚落入口、驗配 6 步驟（老闆 10-25 Q4）、就醫段、門市段、轉、E-E-A-T；網址不變
// 聚落：直接讀分類表「隱形眼鏡」全部小分類，依小分類分組，順序＝分類頁閱讀順序
// 門市事實（10-25 老闆＋法務第 2 步）：CA-800 只新莊、每位都照；板橋只寫「有裂隙燈」（不寫用裂隙燈評估配適）；15 歲以下不驗配；淚液與眼表檢查屬眼科
const CL = CATEGORIES.find(c => c.slug === 'contact-lenses')!;
const allPosts = await getCollection('blog');
const clusterGroups = CL.subs.map(s => ({
  name: s.name,
  posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
}));
// 分類外延伸卡（規劃書 #21）：度數換算、散光變形、兩眼度數差、高中生戴隱眼各有正主，不搬進本分類
const EXTRA_SLUGS = ['vertex-distance', 'astigmatism-glasses-distortion', 'anisometropia-glasses', 'high-school-vision-stability'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);
const TRIAGE_GUIDE = '/guide/eye-doctor-or-optometrist/';

const canonicalUrl = 'https://beyondvisualopt.com/guide/rgp-contact-lens/';

// 指南頁 FAQ：6 題，不跟本分類 5 篇文章的 FAQ 撞題（文章已有：散光片換 RGP、高度散光一定要戴、撐不過換回軟式、自來水、掉了、進沙子、霧霧的）
// 刪原「是什麼」「誰適合」「流程」三題：論點已升 H2；原「安全嗎」拆進就醫段與新 Q4、Q5
// Q5 保留法務第 1 步的免責句（角膜疾病或手術後的隱形眼鏡屬醫療用途，請眼科醫師評估）
const faqs = [
  {
    q: 'RGP 是不是就是角膜塑形片（OK 鏡）？',
    a: '不是同一種，兩個也最常被搞混。這頁講的 RGP 是日戴型的一般硬式隱形眼鏡，白天戴著矯正當下的視力，晚上拿下來。角膜塑形片（俗稱 OK 鏡）是晚上睡覺時戴，靠壓迫改變角膜的形狀，屬於另一類醫療處置，適用的人也不一樣。能見度只做日戴型 RGP 的驗配，角膜塑形不提供。',
  },
  {
    q: 'RGP 需要適應期嗎？剛戴會不會有異物感？',
    a: '會。硬式鏡片的邊緣比軟式明顯，剛開始那幾天，每次眨眼都感覺得到它。時數不能一口氣拉滿，進度由驗光人員排，一天加一點；每天戴幾小時，就照取片時拿到的 RGP 配戴照護指南（操作版）走。取片後大概第 1 週、第 1 個月、第 3 個月要回店看配適，鏡片不服貼，就在那時候微調參數。',
  },
  {
    q: 'RGP 和框架眼鏡、軟式隱形眼鏡，我到底該選哪個？',
    a: '先看散光。散光偏高、軟式散光片一眨眼就轉開、畫面跟著飄，這種人 RGP 值得拿試戴片試一次；散光不高、只是出門不想掛著框，軟式通常就夠用。再來是一天戴多久：每天戴超過十小時、作息又抓不定的人，平常以眼鏡為主比較穩，真要戴就走日拋。最後怎麼配，要驗光人員看過你的角膜、問過你怎麼用眼才定。硬式和軟式、日拋和月拋、隱形眼鏡和眼鏡，能見度官網各有一篇專文逐項比較。',
  },
  {
    q: '驗光生可以幫我配 RGP 嗎？',
    a: '可以。《驗光人員法》第十二條在驗光師（第一項）和驗光生（第二項）的業務範圍裡，都列了「為一般隱形眼鏡配鏡所為之驗光」和「一般隱形眼鏡之配鏡」，年齡限制也一樣。兩種執照的條文還有別的差異，例如驗光那一款寫法不同、低視力者輔助器具的教導使用只列在驗光師，但都不影響一般隱形眼鏡這一項。日戴型 RGP 屬一般隱形眼鏡，由持照驗光人員驗配。要確認幫你驗光的是不是持照的人，到衛福部醫事查詢系統輸入姓名就行。',
  },
  {
    q: '角膜有疾病或動過手術，可以配 RGP 嗎？',
    a: '角膜本身有疾病或動過手術（例如圓錐角膜、角膜移植後）所需的隱形眼鏡，屬醫療用途，請由眼科醫師評估，不在門市一般隱形眼鏡驗配範圍。驗配時如果發現角膜或屈光數據異常，驗光人員一樣會依《驗光人員法》請你先去給眼科醫師診斷，驗光端不接手處理。',
  },
  {
    q: '新莊、板橋哪裡可以做 RGP 驗配？',
    a: '能見度兩間店都驗配日戴型 RGP：新莊店是能見度視覺中心（比泱驗光所），新北市新莊區中正路 419-1 號，02-2206-6700，捷運新莊站；板橋店是能見度眼鏡行（能見度驗光所），新北市板橋區雙十路二段 47 巷 28 號，02-2253-1246，捷運江子翠站。走哪一間，流程都一樣：試戴片現場試，參數當天定、當天下訂；鏡片到了回店學戴取和清潔；取片後約 1 週、1 個月、3 個月各回來看一次，之後每半年一次。兩店不同的是儀器：新莊店有 TOPCON CA-800 角膜地形圖暨像差儀，每個人的角膜都會照；板橋店有裂隙燈。本項為日戴型 RGP 驗配，非角膜塑形（OK 鏡）。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "高度散光、軟式戴不住，可以試 RGP 嗎？硬式隱形眼鏡誰適合、怎麼驗配",
      "dateModified": "2026-10-26",
      "description": "RGP 硬式透氧隱形眼鏡是什麼？和軟式、和角膜塑形（OK 鏡）差在哪、誰可能適合、驗配 6 個步驟（驗光、看角膜、試戴片試戴、當天訂片、到片教戴取、約 1 週／1 個月／3 個月回診）、什麼情況停戴就醫。能見度視覺中心新莊、板橋兩店都驗配日戴型 RGP。YoYo 驗光師整理。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="RGP 硬式隱形眼鏡誰適合？和軟式差在哪・怎麼驗配｜新莊板橋 能見度視覺中心"
  description="RGP 硬式透氧隱形眼鏡是什麼？和軟式、和角膜塑形（OK 鏡）差在哪、誰可能適合、驗配 6 個步驟與回診時間、什麼情況停戴就醫。能見度視覺中心新莊、板橋兩店都驗配日戴型 RGP，現場用試戴片試戴。"
  enPath="/en/guide/rgp-contact-lens/"
  schema={schema}
>

  <!-- Hero：H1 改問句（避開高度近視指南「要多顧哪幾件事」）；「完整指南」留眉標；刪「一次講清楚」#18 -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        高度散光、軟式戴不住，可以試 RGP 嗎？<br /><span class="text-brand-gold" style="font-size:0.6em">硬式隱形眼鏡誰適合、怎麼驗配</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:17px;line-height:1.85">
        軟式散光片眨個眼，畫面就跟著飄；戴久了，總會有人建議你試試硬的。硬的那種叫 RGP，跟晚上戴的角膜塑形（OK 鏡）是兩回事。下面的驗配步驟和回診時間，是新莊、板橋兩店現在實際的做法，寫這頁的是 YoYo 驗光師。
      </p>
    </div>
  </section>

  <!-- 3 秒重點（GEO：answer-first） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        {[
          'RGP 是硬式透氧隱形眼鏡，形狀穩定，散光高的人看得比較穩，代價是一段適應期。',
          'RGP 不是角膜塑形（OK 鏡）：RGP 白天戴、矯正當下視力；OK 鏡晚上戴、改變角膜形狀，屬另一類醫療處置。能見度提供日戴型 RGP，不提供角膜塑形。',
          '驗光師、驗光生都可以驗配一般隱形眼鏡；依驗光人員法第十二條，十五歲以下者應於眼科醫師指導下為之、未滿六歲不得為之。十五歲以下的孩子，能見度目前不驗配隱形眼鏡。',
          '戴著出現紅、痛、畏光、視力突然下降，停戴並儘速至眼科就醫。',
        ].map(t => (
          <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>{t}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: 'RGP 是什麼', href: '#what' },
        { label: '和軟式、OK 鏡的差別', href: '#compare' },
        { label: '誰可能適合', href: '#who' },
        { label: '還在比較軟式與眼鏡', href: '#soft' },
        { label: '驗配 6 個步驟', href: '#fitting' },
        { label: '戴上之後', href: '#after' },
        { label: '停戴就醫', href: '#safety' },
        { label: '門市與預約', href: '#stores' },
        { label: '換硬式就不乾？', href: '#dry' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
        { label: '主題文章', href: '#cluster' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 起承 1：RGP 是什麼（刪「那杯茶」#18） -->
  <section id="what" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">RGP：一片會站穩的硬式透氧鏡片</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>RGP 是 <strong>Rigid Gas Permeable</strong> 的縮寫，中文叫硬式透氧隱形眼鏡。和大家熟悉的軟式鏡片比起來，它比較硬、直徑比較小，只覆蓋角膜中央區域，材質本身透氧。</p>
        <p>它最關鍵的特性是<strong>形狀穩定</strong>。軟式鏡片會服貼在角膜上、跟著角膜的起伏走；RGP 則維持自己的形狀，配戴時鏡片與角膜之間會形成一層淚液。對散光度數高的人來說，這層淚液加上鏡片本身穩定的光學面，看出去往往比較穩、也比較清楚。</p>
        <p>也因為是硬的，剛戴的異物感比較明顯，要適應比較久。適合它的是某幾種眼睛，是不是你的，要評估過、試戴過才知道。</p>
      </div>
    </div>
  </section>

  <!-- 承 2：三者差別（② 免責句必須保留） -->
  <section id="compare" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">RGP、軟式、角膜塑形是三件不同的事</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">一聽到「硬式隱形眼鏡」，不少人想到的是晚上戴的角膜塑形片（OK 鏡）。這兩種差很遠，軟式也一起擺進來比：</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">類型</th>
              <th class="text-left px-5 py-4 font-semibold">配戴方式</th>
              <th class="text-left px-5 py-4 font-semibold">目的</th>
              <th class="text-left px-5 py-4 font-semibold">能見度是否提供</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['RGP 硬式隱形眼鏡（日戴）', '白天配戴、晚上取下', '矯正當下視力，形狀穩定、視覺品質穩定', '✅ 兩店都驗配日戴型 RGP'],
              ['軟式隱形眼鏡', '白天配戴、晚上取下（日拋／雙週拋／月拋）', '矯正當下視力，初期舒適、適應快', '✅ 兩店都驗配'],
              ['角膜塑形片（OK 鏡）', '夜間睡覺配戴', '透過壓迫改變角膜形狀，屬醫療處置', '❌ 不提供'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        本頁的 RGP 是「白天戴、矯正當下視力」的日戴型硬式鏡片，和「晚上戴、改變角膜形狀」的角膜塑形（OK 鏡）是兩回事。能見度視覺中心提供的是一般 RGP 日戴驗配，不提供角膜塑形。
      </blockquote>
    </div>
  </section>

  <!-- 承 3：誰可能適合（4 卡改 H3；「軟式散光片軸向不穩」照法務第 1 步；乾的那一卡不接效果，由轉段接住 #12；刪「也是一部分」「不是缺點…用心」#18） -->
  <section id="who" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">誰可能適合考慮 RGP</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">下面這四種情況，最常被建議來評估看看。可能適合不等於適合，驗光、看角膜、用試戴片試過一輪，才算數。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="bg-white border border-brand-ink/8 rounded-2xl p-6">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:17px;font-weight:600">高度散光，軟式或眼鏡矯正後還是不夠穩</h3>
          <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">散光大約 200 度以上，實際門檻仍依個別評估。兩種鏡片擺在一起比，看<a href="/blog/rgp-vs-soft-contacts/" class="text-brand-gold underline">RGP 硬式和軟式隱形眼鏡差在哪？</a></p>
        </div>
        <div class="bg-white border border-brand-ink/8 rounded-2xl p-6">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:17px;font-weight:600">軟式散光片軸向不穩</h3>
          <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">散光矯正有方向性。軟式散光片眨眼後容易轉動、畫面跟著浮動的人，可以評估形狀穩定的硬式鏡片。</p>
        </div>
        <div class="bg-white border border-brand-ink/8 rounded-2xl p-6">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:17px;font-weight:600">軟式戴了容易乾、容易累</h3>
          <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">想換個選項，可以來評估。軟式本身為什麼會乾、會累，先看<a href="/blog/contact-lens-fatigue/" class="text-brand-gold underline">戴隱形眼鏡一到下午就乾、就累</a>。</p>
        </div>
        <div class="bg-white border border-brand-ink/8 rounded-2xl p-6">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:17px;font-weight:600">願意花一段時間適應</h3>
          <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">前幾週要照進度一點一點拉長配戴時數，回診也得照時間回來。很在意看得穩不穩、也肯花這幾週的人，比較撐得過去。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 承 4：軟式聚落入口（接住「怎麼選」「戴上之後」兩個小分類的軟式文章） -->
  <section id="soft" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">還在比較軟式、日拋月拋和眼鏡</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">多數人不是一開始就考慮 RGP。軟式的日拋、雙週拋、月拋，兩店一樣驗配：先驗光、試戴，戴上和拿下練到你自己來得了，才讓你帶走。散光軟式跟多焦點隱形眼鏡不一樣，門市沒有這兩種的試戴片，怎麼配，得等驗光人員評估完才定。</p>
      <div class="space-y-8">
        <div class="border-l-2 border-brand-gold pl-5">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:19px;font-weight:600">日拋、雙週拋、月拋</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.8">拋棄週期從開封那天算，不是從戴過幾次算，一週戴幾天決定哪一種划得來。→ <a href="/blog/daily-vs-monthly-contacts/" class="text-brand-gold underline">日拋、雙週拋、月拋怎麼選</a></p>
        </div>
        <div class="border-l-2 border-brand-gold pl-5">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:19px;font-weight:600">隱形眼鏡和眼鏡</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.8">近視的人戴隱形眼鏡，看出去的東西比戴眼鏡大一些、視野也寬一些，看近卻要多出一點力，四十歲以後會比戴眼鏡的人先覺得吃力。→ <a href="/blog/contact-lens-vs-glasses/" class="text-brand-gold underline">隱形眼鏡和眼鏡哪個好？</a></p>
        </div>
        <div class="border-l-2 border-brand-gold pl-5">
          <h3 class="font-serif text-brand-navy mb-2" style="font-size:19px;font-weight:600">戴了乾、戴了累</h3>
          <p class="text-brand-ink-2" style="font-size:16px;line-height:1.8">原因常見的有五個：鏡片吸水、戴太久、表面卡了沉積、度數沒跟上，還有兩眼度數差太多。→ <a href="/blog/contact-lens-fatigue/" class="text-brand-gold underline">戴隱形眼鏡一到下午就乾、就累</a>；每天的操作看<a href="/care/soft/" class="text-brand-gold underline">軟式隱形眼鏡照護指南</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 承 5：驗配 6 個步驟（老闆 10-25 Q4；深藍 6 卡改 H3；板橋只寫「有裂隙燈」） -->
  <section id="fitting" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">RGP 驗配的 6 個步驟</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">RGP 沒有現成的可以直接戴走，鏡片參數是在你眼睛上試出來的。兩間店照同一套流程。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
        {[
          ['1. 驗光：先把度數和散光驗準', '完整驗光要 45–60 分鐘。第一次配 RGP 還要看角膜、試戴，從進門到試完，大概 60–90 分鐘。'],
          ['2. 看角膜的形狀', '這一步在新莊店是用 TOPCON CA-800 角膜地形圖暨像差儀，每位顧客都拍；板橋店有裂隙燈。淚液分泌得夠不夠、角膜本身健不健康，要到眼科才查得到，門市不做這兩項。'],
          ['3. 試戴片現場試戴', '試戴片直接戴上去，看鏡片停在角膜的哪個位置、眨眼時怎麼跑、你戴著的感覺；這片不對，就換下一片。'],
          ['4. 當天定參數、訂片', '試到合適的那片，參數當天就定下來，直接訂片。'],
          ['5. 到片：學戴上、拿下和清潔', '鏡片到了，回店由驗光人員教你戴上、拿下和每天的清潔，配戴時數從短的開始排。'],
          ['6. 回診：約 1 週、1 個月、3 個月，之後每半年', '回來讓驗光人員看鏡片戴在角膜上服不服貼，需要就微調參數；鏡片也會拿下來，檢查有沒有刮痕、變形。'],
        ].map(([title, desc]) => (
          <div class="border-t border-white/10 pt-5">
            <h3 class="font-sans text-brand-gold font-semibold mb-2" style="font-size:15px">{title}</h3>
            <p class="text-white/60" style="font-size:14px;line-height:1.7">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 承 6：戴上之後（時數數字讓給照護頁，互搶 B） -->
  <section id="after" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">戴上之後：適應期和每天照護</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>前幾天那種卡卡的感覺，是鏡片邊緣造成的：眼瞼每眨一次，就從它上面掃過一次。這很正常。時數怎麼往上加，驗光人員會排好進度；第一天戴幾小時、哪一天可以戴滿，<a href="/care/rgp/" class="text-brand-gold underline">RGP 配戴照護指南（操作版）</a>逐條列了，取片時也會把這頁傳給你。</p>
        <p>清潔四步通常不會忘，容易漏的是另外三件：保養液用一天就換、去蛋白照仿單的週期做、鏡盒天天倒空晾乾。這三件為什麼省不得，<a href="/blog/rgp-daily-wear-care/" class="text-brand-gold underline">RGP 硬式隱形眼鏡怎麼洗？</a>講了原因。</p>
      </div>
    </div>
  </section>

  <!-- 承 7：就醫段（原「安全與法規」改寫；統一就醫句＋連分流指南；§12 驗光師、驗光生；15 歲以下不驗配；異常轉介主詞是眼科醫師） -->
  <section id="safety" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">這些情況，停戴並儘速至眼科就醫</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>隱形眼鏡屬醫療器材。戴著的時候，只要眼睛紅、痛、畏光，分泌物變多、眼淚流不停，或視力突然下降，鏡片先拿下來別再戴回去，停戴並儘速至眼科就醫。鏡片、鏡盒、保養液也一起帶上。症狀要多急著看醫師，<a href={TRIAGE_GUIDE} class="text-brand-gold underline">{GUIDE_TITLES[TRIAGE_GUIDE]}</a>裡有一張分流表可以對。</p>
        <p>驗配過程中若發現角膜或屈光數據異常（例如懷疑圓錐角膜），驗光人員會請你轉給眼科醫師診斷，不在驗光端處理。角膜本身有疾病或動過手術所需的隱形眼鏡，屬醫療用途，請由眼科醫師評估。</p>
        <p>依《驗光人員法》第十二條，驗光師和驗光生都可以做一般隱形眼鏡的驗光與配鏡（兩種執照的分別，看<a href="/blog/optometrist-license-check/" class="text-brand-gold underline">驗光師和驗光生差在哪？</a>）；十五歲以下者（含 15 歲）的隱形眼鏡驗光應於眼科醫師指導下為之，未滿六歲不得為之。能見度目前不為十五歲以下的孩子驗配隱形眼鏡，請家長先帶去給眼科醫師評估；各個年紀怎麼安排，可以對照<a href="/guide/children-myopia/" class="text-brand-gold underline">兒童近視追蹤完整指南</a>。</p>
      </div>
    </div>
  </section>

