---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, GUIDE_TITLES } from '../../data/categories';

// 2026-10-23 改版（規劃書 5-1）：範圍擴大到無框、精品框、運動框與經銷品牌，網址不變
// 聚落：直接讀分類表「鏡框」3 個小分類（13 篇），依小分類分組呈現，順序＝分類頁閱讀順序
const FRAMES = CATEGORIES.find(c => c.slug === 'frames')!;
const allPosts = await getCollection('blog');
const clusterGroups = FRAMES.subs.map(s => ({
  name: s.name,
  posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
}));
// 分類外的延伸卡：兒童鏡框留在兒童分類、舊框換片留在配眼鏡分類（findCategory 一篇只能屬一個小分類）
const EXTRA_SLUGS = ['children-frames-guide', 'old-frame-relens'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);
const BYO_GUIDE = '/guide/byo-frame-lenses/';

const canonicalUrl = 'https://beyondvisualopt.com/guide/frames/';

// 指南頁 FAQ：全站 FAQPage grep 過，不跟鏡框 13 篇聚落文、/services/adjustment/、/frames/ 撞題
// 原「先看好看還是合適」升為起段；原「網購框」歸 byo 指南（互搶 F）；原「高度近視或多焦點選框」併入「鏡框裝不裝得下你的鏡片」段；
// 規劃書擬的「小孩鏡框跟大人差在哪」撞 children-frames-guide 主意圖、「鏡框壞了可以修嗎」撞 glasses-repair H1，兩題都換
// more：畫面上附在答案後的延伸連結，不進 schema
const faqs = [
  {
    q: '一副好的鏡框可以用多久？',
    a: '沒有固定的年限，看材質、戴法和平常怎麼收。比年限更準的是框自己發出的訊號：鉸鏈的螺絲鎖了又鬆，螺絲孔已經咬不住；金屬框表面的鍍層開始剝落，或板材框發白、摸起來變脆；框變形之後，怎麼調都回不到原本的位置。出現這幾種，就該考慮換框。度數變了，框倒不見得要跟著退休。',
    more: { href: '/blog/old-frame-relens/', t: '舊眼鏡換鏡片划算嗎？哪些情況只換片、哪些該連框換' },
  },
  {
    q: '鏡框顏色怎麼挑？跟膚色、髮色有關係嗎？',
    a: '有關係，不過沒有標準答案。膚色偏暖、帶點黃調的人，玳瑁、琥珀、金色這類暖色框通常比較順眼；膚色偏冷、帶粉調的，黑、灰、銀、透明或藍色系比較好搭。髮色和眉色也要算進去：頭髮眉毛都深的人，戴深色粗框，對比強、存在感也強；髮色淺的人，淺色或半透明的框比較不搶。度數深的人可以多想一步，粗一點的深色板材框，能把鏡片側邊的厚度遮掉一部分。挑到最後，拿到窗邊，在自然光底下照一次鏡子。',
  },
  {
    q: '鼻樑比較低，挑鏡框要注意什麼？',
    a: '先看這副框靠什麼撐在鼻子上。金屬框大多有可調的鼻托，托葉的高低、左右間距都能調，鼻樑低的人比較好處理。板材框多半是框身直接做出鼻墊，鼻樑一低，框就往下坐，鏡片下緣貼到臉頰，一笑眼鏡就被頂上去。這種情況，可以挑鼻墊做得比較高的款式，或鼻樑處另外裝了金屬鼻托的板材框。睫毛也要留意：框坐得太低、鏡片離眼睛太近，眨眼時睫毛會刷到鏡片。試戴時笑一下、眨幾下眼睛，這兩件事一做就知道。',
  },
  {
    q: '想配兩副眼鏡輪流戴，鏡框可以挑不一樣的嗎？',
    a: '可以，只是每一支框都要分開量。同一份度數裝進兩支不同的框，鏡片離眼睛多遠、往前傾幾度、配鏡高度落在哪，都會跟著框改變，所以兩支框要各自戴上去量，鏡片照各自的數字做。兩副如果都要配多焦點，兩支框的上下高度都得夠。量好之後，兩副戴起來仍可能有一點不同；差到其中一副戴不住，就帶回來檢查。',
    more: { href: '/blog/same-prescription-different-feel/', t: '度數一樣，為什麼兩副眼鏡戴起來差這麼多？' },
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "鏡框怎麼挑才戴得久？尺寸、臉型、材質，和你的度數一起看",
      "dateModified": "2026-10-23",
      "description": "鏡框怎麼挑才戴得久？先看尺寸合不合臉，再看臉型與材質，也要確認框裝得下你的鏡片。YoYo 驗光師整理 52□18-140 怎麼看、臉型配框對照表、板材純鈦 TR90 的差別、無框與精品框，以及能見度經銷的 12 個鏡框品牌。新莊、板橋兩店。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="鏡框推薦怎麼挑｜尺寸・臉型・材質・無框與精品框｜新莊板橋 能見度視覺中心"
  description="鏡框怎麼挑才戴得久？先看尺寸合不合臉，再看臉型、材質，和你的度數、多焦點需求一起想。YoYo 驗光師整理 52□18-140 怎麼看、臉型配框對照表、板材純鈦 TR90 差在哪，以及能見度經銷的 12 個鏡框品牌。新莊、板橋能見度視覺中心。"
  enPath="/en/guide/frames/"
  schema={schema}
>

  <!-- Hero：H1 帶副標（避開鏡片指南「先看…再看…最後才…」的殼） -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        鏡框怎麼挑才戴得久？<br /><span class="text-brand-gold" style="font-size:0.6em">尺寸、臉型、材質，和你的度數一起看</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto mb-8" style="font-size:17px;line-height:1.85">
        一副框戴不戴得久，要看它合不合臉、襯不襯你的臉型、用什麼材質、裝不裝得下你的鏡片。無框、精品框、運動框，還有兩店經銷的鏡框品牌，YoYo 驗光師也一併整理在這裡。
      </p>
      <a href="/booking/"
        class="font-sans inline-block bg-brand-gold text-brand-navy font-bold px-8 py-4 hover:bg-brand-gold/90 transition-colors"
        style="font-size:15px;letter-spacing:0.08em">預約視覺諮詢</a>
      <p class="text-white/50 mt-4" style="font-size:13px;letter-spacing:0.05em">諮詢不代表要消費・全程不推銷・可隨時改期</p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first，不加標題） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>先把尺寸不合臉的框拿掉，好看的那副，從剩下的裡面挑。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>臉型配框看線條的對比：圓臉找有角度的框，方臉找圓潤的框。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>重量、皮膚碰到的金屬成分、日後好不好調，都看材質。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>度數深的人框挑小一點；要配多焦點，框的上下得夠高。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽（含起 #fit-first、轉 #years 錨點） -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '先合臉再挑樣式', href: '#fit-first' },
        { label: '尺寸', href: '#size' },
        { label: '臉型', href: '#shape' },
        { label: '材質', href: '#material' },
        { label: '框和鏡片', href: '#lens' },
        { label: '無框・精品框・運動框', href: '#styles' },
        { label: '經銷品牌', href: '#brands' },
        { label: '門市與預約', href: '#stores' },
        { label: '往後幾年', href: '#years' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
        { label: '主題文章', href: '#cluster' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 起：鏡框先合臉，再談好不好看（原 FAQ Q1 論點升上來） -->
  <section id="fit-first" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡框先合臉，再談好不好看</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>站到鏡框牆前，多數人的第一個動作，是伸手拿眼睛先看上的那一副。戴上、側過臉再看一眼，喜歡就握在手上不放。這樣挑很自然，只是常常挑到一副照鏡子時很好看，戴到下午就開始壓鼻樑的框。</p>
        <p>在門市，喜好排到最後。尺寸不合的先拿掉，鼻樑撐不住的拿掉，裝不下你這次鏡片的也拿掉，剩下那一排，再照你的喜好挑。留下來的通常還有好幾副，好看這件事沒有被犧牲，挑的範圍先縮小了而已。</p>
      </div>
    </div>
  </section>

  <!-- 承 1：尺寸（互搶 I：數字正主是 frame-fit-size，這裡只留三個判準＋連結） -->
  <section id="size" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡框尺寸：52□18-140 與合臉的 3 個判準</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>鏡腳內側那串數字，例如 <strong>52□18-140</strong>，是照 ISO 8624 方框法標的，單位是毫米：52 是單邊鏡片寬，18 是兩片鏡片之間的鼻樑寬，140 是鏡腳長。數字只能先篩一輪，合不合，還是得戴上臉看三個地方：</p>
        <ul class="space-y-3 pl-1">
          <li class="flex items-start gap-3"><span class="text-brand-gold mt-1 shrink-0" style="font-size:12px">●</span><span><strong>寬度：</strong>框的外緣大約跟臉頰兩側齊平，從正面看，不會凸出太陽穴外面。</span></li>
          <li class="flex items-start gap-3"><span class="text-brand-gold mt-1 shrink-0" style="font-size:12px">●</span><span><strong>鼻樑：</strong>板材框的鼻樑寬，要剛好卡在你的鼻樑上；金屬框有鼻托可以微調，但撐住的位置要對。</span></li>
          <li class="flex items-start gap-3"><span class="text-brand-gold mt-1 shrink-0" style="font-size:12px">●</span><span><strong>鏡腳：</strong>在耳朵後方那道凹處往下彎，眼鏡是勾住的，不是靠兩側夾住。</span></li>
        </ul>
        <p><a href="/blog/frame-fit-size/" class="text-brand-gold underline">鏡框尺寸怎麼看？</a>把判斷拆成五條：寬度分成臉寬和太陽穴兩條，另外多一條鏡框高度。眼鏡老是往下滑的人，先讀它講「會滑、會夾」的那一段。</p>
      </div>
    </div>
  </section>

  <!-- 承 2：臉型（互搶 A：表格與 frame-face-shape 1-1 同一版，#22 已對齊） -->
  <section id="shape" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">臉型怎麼配鏡框</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">臉型配框，看的是線條的對比。圓潤的臉找帶角度的框，把輪廓收一點；方正的臉找圓一點的框，把下顎線條放軟。</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">臉型</th>
              <th class="text-left px-5 py-4 font-semibold">推薦框型</th>
              <th class="text-left px-5 py-4 font-semibold">避開</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['圓臉', '方框、飛行框、多邊形框——用直線收斂圓潤感', '大圓框、無框圓形（強化圓潤感）'],
              ['方臉', '圓框、橢圓框、貓眼框——柔化下顎線條', '硬邊粗方框（放大稜角）'],
              ['長臉', '有厚度、上下較深的框、深色框——橫向拉寬視覺', '窄長細框（拉長臉型）'],
              ['心形臉（額寬下巴尖）', '下緣較圓的框、細框、無框、貓眼——平衡上寬下窄', '上重下輕的粗框、飛行框（額頭更顯寬）'],
              ['鵝蛋臉', '多數框型都適合，依五官比例挑', '過大或過小失衡的框'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy whitespace-nowrap' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">
        這張表跟<a href="/blog/frame-face-shape/" class="text-brand-gold underline">臉型怎麼挑眼鏡框？</a>用的是同一版。線條、大小、寬度、上緣四個配框原則，點進去一條一條對。
      </p>
    </div>
  </section>

  <!-- 承 3：材質（刪「高端首選」「價格親民」#28；過敏句帶皮膚科提醒；材料學正主是 frame-material-guide） -->
  <section id="material" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">鏡框材質：板材、金屬、純鈦、TR90</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">同樣的框型，換一種材質，戴在臉上就是另一回事。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { name: '醋酸纖維板材', desc: '顏色和紋路的選擇多，加熱後可以調弧度。框身有厚度，戴在臉上存在感明顯，重量通常比細金屬框重一些。', tag: '色彩・紋理' },
          { name: '純鈦／β 鈦', desc: '鈦的密度低、耐腐蝕。純鈦不含鎳，過敏風險較低；β 鈦是加了其他金屬的鈦合金，彈性比純鈦好。戴了皮膚還是有反應、而且一直沒退，請給皮膚科醫師看。', tag: '輕・不含鎳' },
          { name: '不鏽鋼／蒙耐爾', desc: '能做得很細，線條俐落，也好調整。蒙耐爾是鎳銅合金，不鏽鋼也常含鎳，皮膚容易對金屬起反應的人，挑之前先問清楚成分。', tag: '細框・好調' },
          { name: 'TR90', desc: '輕、有彈性，受力會彎，不容易摔斷，運動框和兒童框常用。加熱也很難重新塑形，鏡腳鬆了不太調得回來。', tag: '彈性' },
        ].map(item => (
          <div class="bg-brand-paper rounded-2xl p-7 border border-brand-ink/5">
            <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3 block" style="font-size:11px;letter-spacing:0.16em">{item.tag}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">{item.name}</h3>
            <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">
        想把六種材質的重量、過敏、能不能調一次對齊，讀<a href="/blog/frame-material-guide/" class="text-brand-gold underline">眼鏡框材質怎麼選？</a>，TR90 的限制也在那篇。
      </p>
    </div>
  </section>

  <!-- 承 4：鏡框裝不裝得下你的鏡片（原深藍「選框的隱形關鍵」；刪「眼鏡行不一定會告訴你」#13；卡片升 H3；框心距用詞修正 #21；互搶 B 厚薄數字歸 high-myopia-lens-brand-choice） -->
  <section id="lens" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">鏡框裝不裝得下你的鏡片</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">鏡片要裝進框裡才能用。挑框時，驗光人員會先看你的度數、這次要配哪一種鏡片，再回頭篩框。</p>
      <div class="space-y-8">
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">度數深：框小一點，鏡片側邊薄一點</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">近視鏡片的厚度堆在邊緣。框一寬，鏡片就得從更外面裁，側面看到的那條邊跟著變厚，整副也更重。框寬、瞳距和折射率怎麼一起決定邊緣厚度，<a href="/blog/high-myopia-lens-brand-choice/" class="text-brand-gold underline">高度近視要選蔡司還是 HOYA？</a>用實際度數算過一次；整套配鏡的考量在<a href="/guide/high-myopia/" class="text-brand-gold underline">高度近視配鏡完整指南</a>。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">多焦點：框的上下要夠高</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">多焦點鏡片把看遠、看中、看近由上往下排在同一片上。框太扁，下方看近的那一段會被裁掉，看手機時只好把下巴抬高去找。配多焦點之前要知道的事，從<a href="/guide/progressive-lens/" class="text-brand-gold underline">老花眼鏡完整指南</a>開始。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">個人化鏡片：參數跟著框走</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">個人化訂製鏡片會把頂點距離、前傾角、面彎角、配鏡高度算進設計。量的是你戴著那支框的樣子，框一換，就得重新量過。鏡片這一側從設計等級到品牌怎麼排先後，<a href="/guide/lens-brands/" class="text-brand-gold underline">鏡片怎麼選？</a>有完整的順序。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">框戴正，鏡片中心才對得上瞳孔</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">兩片鏡片的光學中心，要分別對準左右眼的瞳孔。拿 52□18 來說，52 加 18，就是兩個鏡圈中心隔多遠，這叫框心距；它跟你的瞳距差得多，鏡片的光學中心只能偏著裁進鏡圈，近視的人鏡片外側會因此再厚一些。框戴歪了、鼻托塌了，中心也會跑開；鼻托到腳架的調法，照<a href="/blog/frame-adjustment-handcraft/" class="text-brand-gold underline">鏡架調整在調什麼？</a>的八個步驟。</p>
        </div>
      </div>
    </div>
  </section>

