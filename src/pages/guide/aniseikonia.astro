---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, GUIDE_TITLES } from '../../data/categories';

// 2026-10-24 改版（高度近視規劃書 5-2）：H1 換顧客說法；補低頭看書（稜鏡差）、小孩（§12、弱視斜視歸眼科）兩段；FAQ 8 題收成 5 題；網址不變
// 鏡片參數、量兩眼影像大小差、處理低頭看近的稜鏡差：老闆 10-24 確認門市做得到；寫法照法務 10-24 建議句（結果只寫「拉近」「比較好融合」）
// 聚落：讀分類表 high-myopia 的「兩眼度數差很多」小分類（7-1、7-2 上線後自動出現）；回連高度近視指南；分類外延伸卡（#36）
const SELF = '/guide/aniseikonia/';
const HM_GUIDE = '/guide/high-myopia/';
const HM = CATEGORIES.find(c => c.slug === 'high-myopia')!;
const ANISO = HM.subs.find(s => s.guide === SELF)!;
const allPosts = await getCollection('blog');
const clusterPosts = ANISO.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);
const EXTRA_SLUGS = ['binocular-vision', 'glasses-dizzy', 'high-myopia-lens-brand-choice'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/guide/aniseikonia/';

// 指南頁 FAQ：全站 FAQPage grep 過，不跟聚落文、/services/ 撞題
// 刪原 Q2（不等像和不等視）、Q3（放大率跟什麼有關）、Q7（怎麼知道是不是不等像）：論點已升 H2；原 Q3 的法務建議句移到「放大率」H2 開頭
const faqs = [
  {
    q: '兩眼度數差很多，為什麼看久了會頭暈、字會跳？',
    a: '兩眼度數差很多，就算每一眼都各自矯正清楚了，左右眼透過鏡片看到的東西還是可能大小不一；低頭看書時，兩片鏡片下半部把影像偏開的量也不一樣。大腦得一直把兩張大小、位置都有點落差的影像合起來，撐久了，就容易頭暈、眼睛累、字會跳或跳行。這是眼鏡放大率和稜鏡效應造成的光學現象。不過度數、散光軸向、瞳距沒配好，也會出現差不多的感覺，哪一個才是原因，要實際量才分得出來。',
  },
  {
    q: '為什麼頂點距離對兩眼度數差很多的人特別重要？',
    a: '頂點距離是鏡片後表面到角膜的距離。它一動，有效度數和影像放大率都會動：拿 Fc＝F ÷（1 − dF） 算，-6.00D 的鏡片每差 1mm，有效度數約差 0.04D，-10.00D 就約差 0.10D。兩眼度數差很多的人，兩邊鏡片只要離眼睛不一樣遠，或是鏡框戴歪了，左右的差距會再大一截，所以頂點距離要量，兩邊鏡架也要調到對稱。',
  },
  {
    q: '隱形眼鏡會不會比較不容易有不等像？',
    a: '要看兩眼的度數差是從哪裡來的。依 Knapp 定律，理論上，度數差主要來自角膜或水晶體的人，戴隱形眼鏡時兩眼影像大小比較接近；度數差主要來自眼球長短的人，戴框架眼鏡反而可能比較接近。低頭看近也不一樣：隱形眼鏡跟著眼球一起轉，兩片鏡片下半部稜鏡不同的問題，在它身上不會出現。適不適合戴，驗光人員要看過角膜、淚液，也問過你的作息才能判斷；依驗光人員法第十二條，十五歲以下者的隱形眼鏡驗配須在眼科醫師指導下為之，未滿六歲者不予驗配。',
  },
  {
    q: '不等像可以「治好」嗎？',
    a: '先分兩種情況。影像大小差來自眼鏡度數和鏡片條件，那是光學問題，配鏡時能做的，是把兩眼的差距拉近，讓兩眼比較好融合，談不上治好。如果懷疑背後有眼睛的疾病，例如白內障、視網膜的問題，診斷和治療屬於眼科，請先給眼科醫師檢查。',
  },
  {
    q: '新莊、板橋哪裡可以做兩眼度數差很多的配鏡評估？',
    a: '能見度兩間店都可以：新莊店是能見度視覺中心（比泱驗光所），新北市新莊區中正路 419-1 號，02-2206-6700；板橋店是能見度眼鏡行（能見度驗光所），新北市板橋區雙十路二段 47 巷 28 號，02-2253-1246。兩邊的做法相同：雙眼視覺評估每次驗光都做，頂點距離、單眼瞳距、配鏡高度也都量；有需要的話，會再量兩眼看到的影像差多大。如果是小孩兩眼度數差很多，請先帶去給眼科醫師檢查。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "兩眼度數差很多，換了眼鏡為什麼更暈？不等視和不等像",
      "dateModified": "2026-10-24",
      "description": "兩眼度數差很多，換了眼鏡反而更暈、看書字會跳？不等視是兩眼度數差，不等像是兩眼影像大小差。眼鏡放大率跟度數、基弧、中心厚度、頂點距離有關；低頭看書時兩片鏡片的稜鏡也不一樣；小孩兩眼度數差很多，先給眼科醫師看。YoYo 驗光師整理，新莊、板橋兩店。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="兩眼度數差很多？換眼鏡更暈、低頭看書字會跳｜不等視與不等像指南｜新莊板橋"
  description="兩眼度數差很多，換了眼鏡反而更暈、低頭看書字會跳？不等視是度數差，不等像是影像大小差。YoYo 驗光師整理眼鏡放大率跟哪 4 件事有關、低頭看近的稜鏡差、小孩為什麼先看眼科，以及配鏡時會一起看的 5 件事。新莊、板橋能見度視覺中心。"
  enPath="/en/guide/aniseikonia/"
  schema={schema}
>

  <!-- Hero：H1 顧客說法在前、術語在後，帶副標（#32 刪「一頁講透」） -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        兩眼度數差很多，換了眼鏡為什麼更暈？<br /><span class="text-brand-gold" style="font-size:0.6em">不等視和不等像</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto mb-8" style="font-size:17px;line-height:1.85">
        左右眼度數差了好幾百度，每一眼單獨驗都清楚，兩眼一起戴卻暈、看書字會跳。這種時候，度數不一定配錯了。
      </p>
      <a href="/booking/"
        class="font-sans inline-block bg-brand-gold text-brand-navy font-bold px-8 py-4 hover:bg-brand-gold/90 transition-colors"
        style="font-size:15px;letter-spacing:0.08em">預約視覺諮詢</a>
      <p class="text-white/50 mt-4" style="font-size:13px;letter-spacing:0.05em">諮詢不代表要消費・全程不推銷・可隨時改期</p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first，不加標題；刪「不是加分項，是必要條件」#34、「協助轉介」#34） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>左右眼度數差很多，叫不等視；左右看到的東西不一樣大，叫不等像。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>影像大小受度數、基弧、中心厚度、頂點距離影響。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>低頭看書時，兩片鏡片的稜鏡也不一樣。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>小孩兩眼度數差很多，先給眼科醫師看。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽（含起 #question、轉 #limit 錨點） -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '是不是很難配', href: '#question' },
        { label: '不等視和不等像', href: '#what' },
        { label: '常見的感覺', href: '#symptoms' },
        { label: '放大率', href: '#magnification' },
        { label: '低頭看書', href: '#reading' },
        { label: '小孩', href: '#children' },
        { label: '配鏡時看的事', href: '#fitting' },
        { label: '門市與預約', href: '#stores' },
        { label: '拉得近，拉不到一樣', href: '#limit' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
        { label: '主題文章', href: '#cluster' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 起：顧客問句開場（新增） -->
  <section id="question" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">「兩眼度數差很多，是不是很難配？」</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>會這樣問的，通常是拿著一張左右眼差很多的驗光單來，或者帶著一副戴了就暈、最後收進抽屜的眼鏡。有人一眼 100 度、一眼 400 度，也有人一眼開過白內障，兩眼的度數一下子拉開。</p>
        <p>把每一眼的度數驗出來，並不難；麻煩在兩眼一起戴上去之後。兩片度數差很多的鏡片，會讓左右眼看到的影像一大一小；視線往下看書時，兩片鏡片又會把影像往不同的方向偏一點。大腦得把這兩張對不太齊的影像疊成一張，看久了就累。</p>
      </div>
    </div>
  </section>

  <!-- 承 1：不等視和不等像（原「不等像：兩隻眼睛…」＋原 FAQ Q2 論點升上來；白內障單眼一句，第 4 步另寫專文） -->
  <section id="what" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">不等視和不等像：一個是度數差，一個是影像大小差</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>兩眼度數不一樣，叫<strong>不等視</strong>（anisometropia）；兩眼看到的影像大小不一樣，叫<strong>不等像</strong>（aniseikonia）。兩件事常常綁在一起。一眼 -1.00D、一眼 -4.00D 的人，兩眼都各自矯正清楚了，透過眼鏡看出去的東西，還是一邊大、一邊小。</p>
        <p>不過兩者不是同一件事。度數差很多的人，不一定每個都覺得影像不一樣大；影像大小差，也可能來自度數以外的原因。門市裡常碰到的一種，是白內障手術只開了一眼：術後那一眼的度數跟另一眼突然差很多，兩眼看到的大小也跟著不同。手術和術後多久可以配眼鏡，請依眼科醫師的建議。</p>
      </div>
    </div>
  </section>

  <!-- 承 2：常見的 5 種感覺（原 6 卡收成 H3 ×5；「兩眼度數差距明顯」併入；補就醫提醒 #12；刪「立體感變差」卡名） -->
  <section id="symptoms" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">兩眼度數差很多，常見的 5 種感覺</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">驗光單上兩眼的球面度或散光差很多，又同時有下面幾種感覺，就值得把兩眼一起量一次。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {[
          ['看久了頭暈、太陽穴脹', '看書、看螢幕一段時間後，眉心或太陽穴悶悶脹脹，想閉眼休息。'],
          ['看書時字會跳、容易跳行', '字像在晃，讀著讀著就跑到下一行。'],
          ['下樓梯、倒車抓不準距離', '樓梯最後一階差點踩空，倒車時跟後面的距離老是估錯，伸手拿東西也會偏一點。'],
          ['換了新眼鏡反而更不舒服', '新的度數比舊的準，戴上卻比舊眼鏡更暈、更累。'],
          ['看久了想閉一隻眼', '不自覺瞇起一眼，或乾脆閉上一隻眼，因為兩眼一起看太累。'],
        ].map(([title, desc]) => (
          <div class="border border-brand-ink/8 rounded-2xl p-6 bg-white">
            <h3 class="font-serif text-brand-navy mb-2" style="font-size:17px;font-weight:600">{title}</h3>
            <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">{desc}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">這些感覺不一定都來自兩眼度數差，度數、散光軸向、瞳距、雙眼協調都可能造成類似的不舒服。要是症狀是突然冒出來的、東西看成兩個，或者有這些狀況的是小孩，請先讓眼科醫師檢查。</p>
    </div>
  </section>

  <!-- 承 3：放大率 4 件事（原「藏在四個你看不到的細節裡」；開頭用法務 10-24 建議句〔原 FAQ Q3〕；④ 0.25D 已在第 1 步修；補 Knapp 一句） -->
  <section id="magnification" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">眼鏡放大率跟哪 4 件事有關</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>一副眼鏡的放大率主要受四個因素影響：鏡片度數、鏡片基弧、鏡片中心厚度，以及頂點距離。兩眼度數差很多時，驗光人員會先量出兩眼影像大小差多少，再決定要不要在度數正確的前提下，指定鏡片的基弧與中心厚度，把兩眼放大率的差距拉近到比較好融合的範圍。能拉近多少，要看度數差與鏡框條件，量過才知道。</p>
      </div>
      <div class="mt-8 space-y-4">
        {[
          ['① 度數', '度數是放大率的主角。近視鏡片會把影像縮小、遠視鏡片會把影像放大，度數越高縮放得越多；兩眼度數差得越多，兩邊的大小落差通常越明顯。放大率裡跟度數有關的那一項，叫度數因子，可以寫成 1 ÷（1 − hF），h 是鏡片後表面到眼睛入射瞳孔的距離，F 是度數。'],
          ['② 基弧', '基弧是鏡片前表面的彎度。同樣的度數，前表面彎一點或平一點，放大率就跟著變，這一項叫形狀因子。'],
          ['③ 中心厚度', '鏡片中間越厚，形狀因子帶來的放大越多。中心厚度也跟折射率、鏡框大小連在一起，三件事要一起算。'],
          ['④ 頂點距離', '鏡片離眼睛的距離，也是度數因子裡的那個 h。距離一變，有效度數和放大率都會跟著變，照 Fc＝F ÷（1 − dF） 算，-6.00D 的鏡片每差 1mm，有效度數約差 0.04D，度數越高差越多。兩邊鏡架如果一高一低、一前一後，兩眼的落差會再被拉開。'],
        ].map(([title, desc]) => (
          <div class="bg-brand-paper border border-brand-ink/8 rounded-2xl p-7">
            <h3 class="font-serif text-brand-navy mb-2" style="font-size:18px;font-weight:600">{title}</h3>
            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.8">{desc}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">還有一個變數：度數差是從哪裡來的。依 Knapp 定律，理論上，度數差主要來自眼球長短（眼軸型）的人，戴框架眼鏡時兩眼影像大小的差反而比較小；度數差主要來自角膜或水晶體（屈光型）的人，戴隱形眼鏡比較接近。實際的眼睛不一定剛好落在理論上，所以還是要量。</p>
    </div>
  </section>

  <!-- 承 4：低頭看書的稜鏡差（新增；開頭用法務 10-24 建議句；不寫處理方式名稱、不寫「稜鏡處方」） -->
  <section id="reading" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">低頭看書更暈：兩片鏡片下半部的稜鏡不一樣</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>兩眼度數差很多時，低頭看近會因為視線離開光學中心而產生不一樣的稜鏡效應，一眼多一眼少。這在配鏡上有處理方式，需不需要，要量過才知道。</p>
        <p>稜鏡效應的大小，等於視線離開光學中心的距離（公分）乘以度數，這是 Prentice 公式。看遠時，視線多半穿過光學中心附近，兩眼偏得差不多；看書、看手機要低頭，視線往下移到鏡片下半部，兩片鏡片的度數不同，偏的量就不同。拿兩眼差 3.00D 來算，視線往下 10mm（1 公分），兩眼之間就多出約 3△ 的上下稜鏡差。左右方向的偏差，兩眼還能轉一轉去補；上下方向能補的範圍小得多。有些人看遠還好、一低頭看書就暈，原因之一就在這裡。</p>
      </div>
    </div>
  </section>

  <!-- 承 5：小孩（新增；弱視、斜視的診斷與治療歸眼科；§12；連兒童指南） -->
  <section id="children" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">小孩兩眼度數差很多，先給眼科醫師看</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>孩子兩眼度數差很多，常常自己說不出來。好的那一眼一直在看，度數深的那一眼看不清楚，他也不覺得哪裡怪，日常生活照樣過。兩眼度數差很多跟弱視、斜視都有關係，這兩件事的診斷和治療屬於眼科，請先帶孩子給眼科醫師檢查。</p>
        <p>配眼鏡這一段也有規定：依《驗光人員法》第十二條，未滿六歲不得由驗光人員驗光；十五歲以下的驗光，應在眼科醫師指導下進行，隱形眼鏡也一樣。眼科醫師交代的戴法、回診時間，配鏡時帶來告訴驗光人員。孩子各年齡的視力怎麼顧，從<a href="/guide/children-myopia/" class="text-brand-gold underline">{GUIDE_TITLES['/guide/children-myopia/']}</a>開始讀。</p>
      </div>
    </div>
  </section>

  <!-- 承 6：配鏡時會一起看的 5 件事（原深藍 8 卡收成 H3 ×5；「生活視覺分析」「轉介眼科」併入；不列雙眼視覺檢查項目 #10；
       鏡片設計參數規劃卡用法務 10-24 建議句 #4；隱形眼鏡 Knapp 修正 #13、§12 保留；刪「配好了才算完成」#34） -->
  <section id="fitting" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">兩眼度數差很多，配鏡時會一起看的 5 件事</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">每一眼的度數驗完，還要把兩眼當成一組一起看。</p>
      <div class="space-y-8">
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">雙眼視覺評估</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">兩眼搭不搭得起來，每次驗光都會評估。也會問你平常看遠、看近、看螢幕各佔多少，鏡片怎麼取捨跟著調整。試過幾組度數，矯正視力仍差一截的，驗光人員會依《驗光人員法》第十二條第三項，請你轉給眼科醫師檢查。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">頂點距離與兩邊鏡架對稱</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">兩邊鏡片各離眼睛多遠，要分開量；鼻托、鏡腳也得調到左右一樣，免得一邊貼近、一邊離遠。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">鏡片設計參數規劃</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">先量兩眼影像大小差多少；需要時在度數正確的前提下指定基弧、中心厚度與折射率，把兩眼放大率的差距拉近。能拉近多少，依度數差與鏡框條件而定。兩片鏡片厚度會不一樣，正面看不看得出來，<a href="/blog/high-myopia-lens-brand-choice/" class="text-brand-gold underline">高度近視要選蔡司還是 HOYA？</a>有算過。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">隱形眼鏡這個選項</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">隱形眼鏡跟著眼睛轉，低頭看書時不會有兩片鏡片下半部稜鏡不一樣的問題；影像大小比框架接近還是比較差，要看度數差從哪裡來（見上面的 Knapp 定律）。能不能戴，要驗光人員當場檢查過再決定；依驗光人員法第十二條，十五歲以下者的隱形眼鏡驗配須在眼科醫師指導下為之，未滿六歲者不予驗配。</p>
        </div>
        <div class="border-t border-white/10 pt-6">
          <h3 class="font-serif text-brand-gold mb-3" style="font-size:19px;font-weight:600">取件後 2 週內主動追蹤</h3>
          <p class="text-white/70" style="font-size:15px;line-height:1.8">取件後 2 週內，門市會主動追蹤，聽你講這幾天戴下來的感覺；在能見度配的眼鏡，取件後的鏡架調整不另外收費。</p>
        </div>
      </div>
    </div>
  </section>

