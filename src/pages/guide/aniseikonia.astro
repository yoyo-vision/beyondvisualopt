              <p class="text-brand-ink-3 line-clamp-2" style="font-size:14px;line-height:1.7">{post!.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
      <a href="/topics/high-myopia/#anisometropia" class="inline-block mt-8 font-sans text-brand-gold hover:text-brand-navy transition-colors" style="font-size:15px">依主題看高度近視全部文章 →</a>
    </div>
