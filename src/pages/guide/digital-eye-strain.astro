---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/categories';

// 聚落文章：讀分類表 daily-vision 的小分類（螢幕族、職業用眼），另加分類外延伸文章
const DV = CATEGORIES.find(c => c.slug === 'daily-vision')!;
const allPosts = await getCollection('blog');
const clusterGroups = DV.subs.map(s => ({
  name: s.name,
  posts: s.posts.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean),
}));
const EXTRA_SLUGS = ['glasses-dizzy', 'contact-lens-fatigue', 'driving-lens-night-glare'];
const extraPosts = EXTRA_SLUGS.map(slug => allPosts.find(p => p.slug === slug)).filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/guide/digital-eye-strain/';

// 指南頁 FAQ（與聚落文章互補，不重複）
const faqs = [
  {
    q: '看螢幕眼睛累，配抗藍光鏡片有用嗎？',
    a: '要看你想讓它解決什麼。抗藍光鍍膜管的是光，短波長的藍光，它會攔下一部分。看螢幕會累，問題卻在眼睛自己身上：睫狀肌對著同一個距離撐了一整天，眨眼的次數也掉了，這兩件鍍膜都插不上手，所以它對「下午眼睛脹、看遠對不到焦」這類疲勞幫得上多少，研究上仍有討論空間。護眼、防病變這類說法我們不用；晚上睡不睡得好，也不拿它掛保證。整天對著螢幕的人，與其先挑鍍膜，不如先確認度數準不準、螢幕擺得多遠；真的需要，再來看數位型單光或辦公室鏡片。',
  },
  {
    q: '看螢幕看到頭暈、眼睛痛怎麼辦？',
    a: '先分兩種狀況。若是用眼幾小時後才出現、休息一下就好，多半是調節疲勞與乾眼——可先試 20-20-20 法則、有意識完整眨眼、調整螢幕到眼睛下視 10–15 度且距離 60–70 公分。若頭暈是「一戴上眼鏡就暈、靜止不動也暈、伴隨明顯頭痛或走路不穩」，那通常是配鏡參數問題（度數、散光軸向、瞳距、頂點距離），需要回店重新量測。症狀持續或加重，依《驗光人員法》我們會建議轉介眼科醫師檢查，驗光人員不做醫療診斷。',
  },
  {
    q: '工程師、上班族長時間看螢幕該配什麼眼鏡？',
    a: '先看兩件事：有沒有老花，還有你的視線一天大多落在多遠。還沒有老花的，第一步是把度數驗準，再決定要不要用數位型單光。已經有老花、一整天在螢幕和文件之間來回的，可以看辦公室（中近用）鏡片，只是它看遠的範圍窄，不適合開車。哪一種、要不要加、加多少，都等驗完光、量過你平常的工作距離再定。',
  },
  {
    q: '隱形眼鏡越戴越累是為什麼？',
    a: '跟螢幕有關的，常見是這幾個：鏡片材質的含水量、透氧度跟你的用眼環境不搭；冷氣房裡盯著螢幕，眨眼次數變少；配戴時間超過負荷，不少人一戴就是十幾個小時。配戴時數與更換週期，依驗光人員的交代與產品仿單。乾澀持續、眼白反覆充血、怕光或疼痛，請直接至眼科就醫；眼睛表面與淚液的檢查屬眼科，門市不做。想重新確認隱形眼鏡的度數與配戴狀況，可以到門市由驗光人員驗光，眼睛健康的部分仍由眼科醫師判斷。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "整天看螢幕，眼睛累了先從哪裡下手？用眼習慣、症狀對照、電腦眼鏡怎麼選",
      "description": "整天看螢幕，下午眼睛又乾又脹、看遠對不到焦？從睫狀肌、眨眼和螢幕距離講起，再到 20-20-20 用眼習慣、症狀對照，以及數位型單光、辦公室（中近用）鏡片這兩種電腦眼鏡怎麼選。YoYo 驗光師撰寫，新莊、板橋能見度視覺中心。",
      "dateModified": "2026-10-28",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="看螢幕眼睛累怎麼辦｜用眼習慣・症狀對照・電腦眼鏡怎麼選｜新莊板橋 能見度視覺中心"
  description="整天看螢幕，下午眼睛又乾又脹、看遠對不到焦？從睫狀肌、眨眼和螢幕距離講起，到 20-20-20 用眼習慣、症狀對照，以及數位型單光、辦公室鏡片這兩種電腦眼鏡怎麼選。YoYo 驗光師撰寫，新莊、板橋能見度視覺中心。"
  enPath="/en/guide/digital-eye-strain/"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        整天看螢幕，眼睛累了先從哪裡下手？<br /><span class="text-brand-gold" style="font-size:0.6em">用眼習慣、症狀對照、電腦眼鏡怎麼選</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        一天對著螢幕好幾個小時，一過中午，眼睛就又乾又脹、看遠對不太到焦？先別急著換眼鏡。弄懂眼睛在螢幕前忙些什麼，今天就能改的先改；改了還是不夠，才輪到鏡片。持續疼痛、反覆嚴重乾澀、視力明顯下降的，則要先去眼科。YoYo 驗光師撰寫。
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>看螢幕會累，多半不是單一原因：睫狀肌整天停在看近的位置不放；人一專心就少眨眼，淚膜跟著不穩；還有距離本身，看 60 公分外的螢幕，眼睛就得多出約 1.67D 的力。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>藍光不是主因。抗藍光鍍膜擋的是短波長藍光裡的一部分，對數位疲勞幫得上多少，研究上還在討論；說它護眼、防病變，我們不這樣講。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>換鏡片之前，先把用眼習慣調一調：20-20-20 法則、有意識完整眨眼、螢幕放在視線下方 10–15 度、距離 60–70 公分。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>習慣改了還是不夠，再來看鏡片：四十歲前，先確認度數準不準、要不要數位型單光；老花上來了，看辦公室（中近用）鏡片。「一戴上就暈」的，該查的是配鏡參數。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '為什麼會累', href: '#why' },
        { label: '症狀對照', href: '#checklist' },
        { label: '用眼習慣', href: '#habits' },
        { label: '電腦眼鏡怎麼選', href: '#lenses' },
        { label: '隱形眼鏡族的疲勞', href: '#contacts' },
        { label: '主題文章', href: '#cluster' },
        { label: '常見問題', href: '#faq' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 數位疲勞是什麼 -->
  <section id="why" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">看螢幕為什麼會累？眼睛在忙的三件事</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>「下班後眼睛很乾、頭很痛」「看完電腦再看遠，好像對不到焦」「午後三點一到，就開始看不清楚」，美國眼科醫學會把這一類狀況叫做電腦視覺症候群（Computer Vision Syndrome），國內也常說數位眼疲勞。背後通常是下面三件事，而且很少單獨出現。</p>
        <p><strong>① 睫狀肌被釘在看近：</strong>看近的時候睫狀肌收緊，看遠才放開。人坐在桌前，螢幕跟眼睛的距離一整天幾乎沒變，它就用同一個力道從早撐到下午，中間沒真正放開過。撐久了，收和放都變得遲鈍：盯著的那行字像隔了一層薄霧，轉頭看窗外，要過一兩秒才清楚。</p>
        <p><strong>② 一專心就忘了眨眼：</strong>眼睛盯著螢幕、腦子想著事情，眨眼的次數就掉下來。眼睛表面那層淚膜，是靠眨眼一次一次推開、補上的；兩次之間隔得一久，它撐不到下一次就先乾出缺口，接著就是乾澀、灼熱，像有沙子卡在裡面。</p>
        <p><strong>③ 距離本身就要出力：</strong>戴好眼鏡望向窗外，睫狀肌幾乎不必出力；轉回 60 公分外的螢幕，它得多撐約 1.67D。這筆帳只認距離，度數深淺改變不了。有三種人扛這份力特別辛苦：老花已經開始的、還有一點度數沒矯正到的，以及兩眼本來就要多費點勁才對得齊的（隱斜位）。</p>
      </div>
      <p class="text-brand-ink-2 mt-6" style="font-size:16px;line-height:1.8">
        下午一看不清楚，很多人第一個念頭是度數又深了，<a href="/blog/digital-eye-strain-solution/" class="text-brand-gold underline">看螢幕看到下午就看不清楚，是度數變深還是眼睛累了？</a>就從這個念頭講起。
      </p>
    </div>
  </section>

  <!-- 症狀自我檢查 -->
  <section id="checklist" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">眼睛乾、頭痛、看遠模糊，跟什麼有關？症狀對照</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">症狀常常好幾個一起冒出來，背後的原因也未必只有一個。這張表只是幫你先抓個方向，不能拿來當診斷。</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">你的症狀</th>
              <th class="text-left px-5 py-4 font-semibold">比較可能的原因</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['看遠模糊，休息後恢復', '睫狀肌還停在看近，沒轉回來'],
              ['眼睛乾、灼熱、異物感', '眨眼不夠，加上乾眼'],
              ['頭痛（太陽穴或眉弓）', '隱斜位，或看近的負擔太重'],
              ['重影、字體跳動', '看近時兩隻眼睛對不到同一點'],
              ['近看清楚，看完遠模糊', '看近看太久，調節累過頭'],
              ['午後視力下降', '調節累了一整天，乾眼也跟著加重'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        重要界線：驗光人員做的是視覺功能評估與配鏡矯正，不做醫療診斷。若你有持續的眼睛疼痛、反覆嚴重乾澀、視力明顯下降，依《驗光人員法》我們會建議並協助轉介眼科醫師檢查，先排除眼疾再談配鏡。
      </blockquote>
    </div>
  </section>

  <!-- 用眼習慣 -->
  <section id="habits" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">先從用眼習慣與工作環境下手</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">這幾件今天下午坐回位子上就能做。整天待在冷氣房、在幾個螢幕之間切來切去的人，更該先試。</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { level: '20-20-20 法則', desc: '每用眼 20 分鐘，把視線丟到 20 英尺（約 6 公尺）外，停 20 秒。窗外的招牌、走廊盡頭都可以，讓一直停在看近的睫狀肌鬆一口氣。', fit: '調節放鬆' },
          { level: '有意識完整眨眼', desc: '很多人盯著螢幕只眨一半，眼皮沒闔到底，淚膜就鋪不完整。記得把每一下都眨完整；乾澀一直不退，請給眼科醫師檢查。', fit: '淚膜更新' },
          { level: '螢幕距離與高度', desc: '螢幕放在視線往下 10–15 度的位置，離眼睛 60–70 公分。亮度跟房間差不多就好，別讓螢幕亮得像燈箱，四周卻一片暗。', fit: '環境設定' },
        ].map(item => (
          <div class="bg-white rounded-2xl p-7 border border-brand-ink/5 flex flex-col">
            <span class="font-sans text-brand-gold font-semibold tracking-widest uppercase mb-3" style="font-size:11px;letter-spacing:0.18em">{item.fit}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{item.level}</h3>
            <p class="text-brand-ink-3" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">
        另一種情況要分開看：「一戴上眼鏡就頭暈」，問題多半出在配鏡參數，<a href="/blog/glasses-dizzy/" class="text-brand-gold underline">新眼鏡戴了頭暈正常嗎？</a>從度數、散光軸向一路查到鏡架走位，原因有五個。
      </p>
    </div>
  </section>

  <!-- 鏡片方案（深藍區段） -->
  <section id="lenses" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">電腦眼鏡怎麼選：先看年紀，再看你的桌面怎麼擺</h2>
      <p class="text-white/60 mb-10" style="font-size:16px;line-height:1.8">一般講的「電腦眼鏡」，大致就是下面前兩種，其餘兩項是常跟著一起被問的鍍膜和鏡架。年紀只分得出大方向，真正要配哪一種，得看驗光結果。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
        {[
          ['數位型單光鏡片', '整片還是單光，只在下緣多放一點看近的度數。看螢幕、看手機時，鏡片先替睫狀肌分掉一部分力氣；抬頭看遠，跟一般單光沒兩樣。別把它跟老花眼鏡、漸進鏡片混在一起；要加多少、你適不適合，得看驗光結果和工作距離。本店經銷品牌中，蔡司 Digital EnergizeMe 屬此類設計。'],
          ['辦公室（中近用）鏡片', '設計重心擺在中近距離：螢幕、桌上的文件，伸手搆得到的那一圈。跟一般漸進鏡比，視野分配不一樣，看遠的範圍窄，不適合開車。比較適合已經老花、一整天在電腦、紙本和會議之間轉個不停的人。本店經銷品牌中，蔡司新世代辦公型 Officelens 屬此類設計。'],
          ['抗藍光／抗反射鍍膜', '抗藍光鍍膜會把短波長藍光擋掉一些，可是睫狀肌繃著這件事，它碰不到；對數位疲勞有多少幫助，研究上還沒有定論，要加，就當配角加。靠色準吃飯的人還要多想一步：濾鏡會讓顏色偏一點。抗反射鍍膜對付的則是鏡片表面的反光，跟藍光是兩回事。'],
          ['鏡架配適與配戴參數', '看螢幕時，視線從鏡片的哪一點穿過去，跟前傾角、頂點距離有關；高度近視的人，差一點就特別有感。鏡架戴久會鬆、會歪，「剛拿到很好，戴了幾個月才開始暈」的，常常是鏡架走位了，先回店把它調回原位。'],
        ].map(([title, desc]) => (
          <div class="border-t border-white/10 pt-5">
            <p class="font-sans text-brand-gold font-semibold mb-2" style="font-size:15px">{title}</p>
            <p class="text-white/60" style="font-size:14px;line-height:1.7">{desc}</p>
          </div>
        ))}
      </div>
      <p class="text-white/70 mt-10" style="font-size:15px;line-height:1.8">
        已經老花的人，能挑的不只辦公室鏡片，<a href="/blog/presbyopia-vs-progressive/" class="text-brand-gold underline">老花一定要配多焦點嗎？</a>一次比了四種老花方案，視野寬窄、好不好適應都有。
      </p>
    </div>
  </section>

  <!-- 隱形眼鏡族的疲勞（2026-10-26 隱形眼鏡規劃書互搶 F：三卡縮成一段，正主讓給 contact-lens-fatigue；時數不寫數字、不用「處方」） -->
  <section id="contacts" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">隱形眼鏡族：為什麼「越戴越累」？</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>盯著螢幕，眨眼次數會掉下來；冷氣房裡，淚液又蒸發得快。戴軟式隱形眼鏡的人最先有感，到了下午，眼睛又乾又累。鏡片本身會吸淚液，戴的時間一長，角膜分到的氧也不夠，這兩樣常常一起來；鏡片表面積了沉積、度數跟現在看螢幕的距離對不上，也會湊上一腳。哪一個是你的主因、可以先從哪裡調，<a href="/blog/contact-lens-fatigue/" class="text-brand-gold underline">戴隱形眼鏡一到下午就乾、就累</a>一個一個拆開講。</p>
        <p>每天戴幾小時，以驗光人員的交代和產品仿單為準。還在猶豫日拋或月拋的，可以讀<a href="/blog/daily-vs-monthly-contacts/" class="text-brand-gold underline">日拋、雙週拋、月拋怎麼選</a>；想過平常乾脆改戴眼鏡的，<a href="/blog/contact-lens-vs-glasses/" class="text-brand-gold underline">隱形眼鏡和眼鏡哪個好？</a>把兩邊的差別攤開來比。乾澀一直不好、眼白反覆發紅，請給眼科醫師檢查；出現紅、痛、畏光或視力突然下降，停戴並儘速至眼科就醫。</p>
      </div>
    </div>
  </section>

