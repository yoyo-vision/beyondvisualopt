---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 本指南的主題聚落文章（依閱讀順序排列）
const CLUSTER_SLUGS = [
  'xinzhuang-glasses-guide',
  'banqiao-glasses-guide',
  'optometry-vs-ophthalmology',
  'common-optometry-mistakes',
];
const allPosts = await getCollection('blog');
const clusterPosts = CLUSTER_SLUGS
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter(Boolean);

const canonicalUrl = 'https://beyondvisualopt.com/guide/choose-optician/';

// 指南頁 FAQ（與聚落文章互補，不重複）
const faqs = [
  {
    q: '驗光所和眼鏡行有什麼不同？',
    a: '差別在法規。台灣的「驗光所」依《驗光人員法》設立，必須由持照驗光人員執行驗光，能合法開立驗光報告、執行完整的雙眼視覺評估；眼鏡行要執行驗光，依《驗光人員法施行細則》第四條須在店內設立驗光所，同樣由登記執業的持照驗光人員執行；沒有設立驗光所的眼鏡行，依法不能執行驗光，也不能出具驗光結果報告。實務上的意義是：不管在哪裡配，先確認幫你驗光的人有沒有驗光人員證書；只要你有頭暈、眼睛疲勞、老花或多焦點需求，更要讓持照驗光人員做完整評估。',
  },
  {
    // 2026-07-27 關鍵字集中：本題原為「新莊哪裡配眼鏡比較好」，與新莊店頁 /xinzhuang/ 互搶精準詞，
    // 已改為跨區泛用問法，在地細節交由店頁承接（見本頁「新莊店 × 板橋店」區塊內鏈）
    q: '新北配眼鏡，怎麼挑一家可以信任的店？',
    a: '不是看招牌大小，而是三件事：執行驗光的是不是持照驗光人員（執照可於衛福部醫事人員查詢系統核對）、驗光流程是否完整（含雙眼視覺評估通常需要 45–60 分鐘）、配鏡後能不能回店調整、要不要另外收費——眼鏡舒不舒服，往往是取件之後才決定的。能見度在新莊與板橋各有一間門市，兩店的地址、交通與服務內容整理在本頁下方「新莊店 × 板橋店」區塊，可直接點進各店詳細介紹。',
  },
  {
    q: '板橋驗光所怎麼選？',
    a: '板橋從江子翠站到板橋車站一帶店家密集，價位與定位落差很大。挑選時看：幫你驗光的人是不是登記執業的持照驗光人員、老花與多焦點是否有完整加入度與瞳高量測、高度近視是否做頂點距離補正。能見度眼鏡行 × 能見度驗光所（板橋在地 1992 年創立至今）位於雙十路二段47巷28號、捷運江子翠站步行 5 分鐘，電話 02-2253-1246。',
  },
  {
    q: '配眼鏡要先看眼科嗎？',
    a: '單純配鏡不需要先掛眼科。除非你同時有眼部不適症狀——突然視力模糊、眼前飛蚊閃光黑影、眼睛紅痛、疑似青光眼——這些屬於醫療範疇，要先看眼科醫師。若只是想配一副舒服的眼鏡或戴了會頭暈，可以直接找驗光所。驗光人員不做醫療診斷；驗光時視力無法矯正至正常，依《驗光人員法》第十二條第三項轉介眼科醫師。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "新北配眼鏡完整指南：驗光所 vs 眼鏡行怎麼選？新莊、板橋在地建議",
      "description": "新北配眼鏡要選驗光所還是眼鏡行？法規差在哪、怎麼判斷一家好的驗光所、常見配鏡地雷、何時該看眼科——YoYo 驗光師一頁講透。新莊、板橋在地建議。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="新北配眼鏡完整指南｜驗光所 vs 眼鏡行怎麼選｜新莊 板橋 在地建議"
  description="新北配眼鏡選驗光所還是眼鏡行？從法規差異、怎麼判斷好的驗光所、常見配鏡地雷到何時該看眼科，YoYo 驗光師一頁講透。新莊、板橋能見度視覺中心在地建議。"
  enPath="/en/guide/choose-optician/"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        新北配眼鏡：<br /><span class="text-brand-gold">驗光所 vs 眼鏡行怎麼選</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        新莊配眼鏡、板橋驗光所該怎麼挑？法規差在哪、怎麼判斷一家值得信任的驗光所、常見的配鏡地雷、什麼時候該去眼科——這一頁一次講清楚。由 YoYo 驗光師撰寫，依據臨床驗配實務。
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>驗光所依《驗光人員法》設立、須由持照驗光人員執行驗光、可合法開立驗光報告；眼鏡行要驗光，須先在店內設立驗光所，一樣由持照驗光人員執行（施行細則第四條）。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>先確認店裡有登記驗光所；有頭暈、眼睛疲勞、老花或多焦點需求，再多問一句：「驗光有包含雙眼視覺評估嗎？」</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>判斷好驗光所看五件事：驗光人員有無執照、流程是否 45–60 分鐘、有無量頂點距離與雙眼視覺、鏡片來源清楚、配鏡後回店調整收不收費。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>眼睛有症狀（紅痛、飛蚊閃光、突發模糊）先看眼科；想配一副舒服的眼鏡、戴了會暈，找驗光所。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '驗光所 vs 眼鏡行', href: '#difference' },
        { label: '怎麼判斷好驗光所', href: '#howtochoose' },
        { label: '常見配鏡地雷', href: '#mistakes' },
        { label: '何時該看眼科', href: '#ophthalmology' },
        { label: '新莊店 × 板橋店', href: '#stores' },
        { label: '常見問題', href: '#faq' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 驗光所 vs 眼鏡行 -->
  <section id="difference" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">「驗光所」和「眼鏡行」，法律上就是兩回事</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">很多人以為都一樣，其實依<a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?PCode=L0020190" target="_blank" rel="noopener noreferrer" class="text-brand-gold underline">《驗光人員法》</a>，這兩者在法規上的設立條件不同。差別不在裝潢，在誰能合法幫你驗光。</p>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">比較項目</th>
              <th class="text-left px-5 py-4 font-semibold">驗光所</th>
              <th class="text-left px-5 py-4 font-semibold">一般眼鏡行</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['執行驗光者', '持照驗光人員', '須在店內設立驗光所，由登記執業的持照驗光人員執行（施行細則第四條）'],
            ].map(row => (
              <tr class="border-b border-brand-ink/8">
                {row.map((cell, i) => (
                  <td class={`px-5 py-4 align-top ${i === 0 ? 'font-semibold text-brand-navy whitespace-nowrap' : ''}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-brand-ink-3 mt-6" style="font-size:16px;line-height:1.8">怎麼查一家店有沒有登記驗光所：<a href="/blog/optometrist-license-check/" class="text-brand-gold underline">驗光師和驗光生差在哪？怎麼確認幫你驗光的人有執照</a></p>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        白話結論：先看店裡有沒有登記驗光所、由誰幫你驗光。只要你有頭暈、眼睛疲勞、老花或多焦點需求，再多確認一件事：驗光有沒有包含雙眼視覺評估，而不是只量度數。
      </blockquote>
    </div>
  </section>

  <!-- 怎麼判斷好驗光所 -->
  <section id="howtochoose" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">怎麼判斷一家好的驗光所？看這 5 件事</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">不論你在新莊配眼鏡還是在板橋驗光，走進店裡前，先用這幾個問題篩掉不合格的店家。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { n: '01', title: '驗光人員有沒有執照？', desc: '持有執照的驗光人員（驗光師／驗光生）才能合法執行驗光。走進門市先看牆上：驗光所依法應將開業執照與收費標準揭示於明顯處；再到衛福部醫事人員查詢系統，核對驗光人員的證書字號。這是最基本、也最容易被忽略的一關。' },
          { n: '02', title: '驗光流程有多長？', desc: '能見度的完整驗光約 45–60 分鐘，預約時段留 60–90 分鐘，兩店每次都做雙眼視覺評估。時間長短本身不是重點，選店時可以問一句：這段時間裡會做哪些事。' },
          { n: '03', title: '有沒有量頂點距離與雙眼視覺？', desc: '高度近視要靠頂點距離（Vertex Distance）補正才能確保有效度數正確；兩眼一起用時協調比較吃力的人，只看度數配出來，容易累、容易暈。這兩項有沒有做，決定戴起來舒不舒服。' },
          { n: '04', title: '設備與鏡片來源清楚嗎？', desc: '可以請店家說明鏡片來源，以及原廠保固怎麼走。多焦點與個人化訂製鏡片，這一題尤其值得多問。' },
          { n: '05', title: '配鏡後能不能回店調整？要不要收費？', desc: '選店前先把這兩件事問清楚。在能見度配的眼鏡，取件後的鏡架調整不另外收費。取鏡時要當場試戴、確認遠中近視野與鏡架配適，而不是「做好寄給你，有問題再回來」。' },
        ].map(item => (
          <div class="border border-brand-ink/8 rounded-2xl p-7">
            <span class="font-sans text-brand-gold font-semibold tracking-widest mb-3 block" style="font-size:13px;letter-spacing:0.18em">{item.n}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{item.title}</h3>
            <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 常見配鏡地雷 -->
  <section id="mistakes" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">常見配鏡地雷：為什麼配了眼鏡還是不舒服</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">「配了還是頭暈」，有時要回頭看驗光流程裡少了哪一步。</p>
      <div class="space-y-6">
        {[
          { title: '① 只問「幾號比較清楚」就結束', desc: '看視力表、選比較清楚的那個就結束，沒有評估兩眼一起用協不協調、看近的需求。度數看似對了，戴起來卻怪怪的、頭重、容易疲勞。' },
          { title: '② 沿用電腦驗光值，沒做主觀微調', desc: '電腦驗光機給的是「電腦度數」，最終還要用綜合驗光儀做主觀驗光，讓你試戴、回饋、細部調整。省掉這一步，等於拿機器的初步估算直接配鏡。' },
          { title: '③ 沒放鬆調節力就驗光，度數偏深', desc: '長時間盯螢幕的人睫狀肌容易緊繃，在這種狀態下驗出來的度數往往偏深。你以為近視 -4.00D，真正可能只有 -3.50D，配深了反而更累。' },
          { title: '④ 光學中心沒對準瞳孔、瞳距只除以二', desc: '應分別量左右眼各自到鼻樑中線的單側瞳距。有些人左右不對稱，若只用總瞳距除以二估算，會產生稜鏡效應，讓大腦額外費力融合影像，造成疲勞頭暈。' },
          { title: '⑤ 驗完就走，沒有當場試戴確認', desc: '配鏡最後一步應在驗光人員面前試戴、確認視覺品質——尤其多焦點鏡片要確認遠中近視野、兩眼平衡、鏡架有沒有滑落。省掉了，回家出問題就很難判斷是度數、位置還是適應期。' },
        ].map(item => (
          <div class="bg-white border border-brand-ink/8 rounded-2xl p-7">
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">{item.title}</h3>
            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.8">{item.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-brand-ink-2 mt-8" style="font-size:16px;line-height:1.8">
        完整的 5 個驗光誤區說明：<a href="/blog/common-optometry-mistakes/" class="text-brand-gold underline">配眼鏡常見的 5 個驗光誤區：少做哪一步，戴起來就不對</a>
      </p>
    </div>
  </section>

  <!-- 何時該看眼科 -->
  <section id="ophthalmology" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">有眼睛症狀，先給眼科看</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">眼睛健不健康、要不要治療，由眼科醫師判斷；度數、雙眼視覺和配鏡參數，是驗光所做的事。先分清楚，少跑一趟。</p>
      <div class="overflow-x-auto mb-10">
        <table class="w-full border-collapse" style="font-size:15px">
          <thead>
            <tr class="bg-brand-navy text-white">
              <th class="text-left px-5 py-4 font-semibold">你的需求</th>
              <th class="text-left px-5 py-4 font-semibold">建議去哪裡</th>
            </tr>
          </thead>
          <tbody class="text-brand-ink-2">
            {[
              ['眼睛突然不對勁、有症狀（紅痛、飛蚊閃光、突發模糊）', '眼科'],
              ['定期眼底、眼壓檢查（糖尿病、高血壓患者）', '眼科'],
              ['孩子未滿 6 歲（驗光人員依法不得驗光）', '眼科'],
              ['孩子 6～15 歲第一次驗光配鏡（須先經醫師確診為非假性近視，之後 15 歲以下於眼科醫師指導下驗光；超過 15 歲可直接驗光）', '先眼科，再驗光所'],
