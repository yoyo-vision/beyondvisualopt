---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, GUIDE_TITLES } from '../../data/categories';

// 本指南的主題聚落文章：讀分類表「配眼鏡」的 local＋discomfort＋buying，順序＝分類頁閱讀順序
// byo-frame 小分類有自己的指南（/guide/byo-frame-lenses/），不展開文章，只放一張指南卡
const GLASSES = CATEGORIES.find(c => c.slug === 'glasses')!;
const CLUSTER_SLUGS = GLASSES.subs.filter(s => s.slug !== 'byo-frame').flatMap(s => s.posts);
const allPosts = await getCollection('blog');
const clusterPosts = CLUSTER_SLUGS
  .map(slug => allPosts.find(p => p.slug === slug))
  .filter(Boolean);
const BYO_GUIDE = '/guide/byo-frame-lenses/';

const canonicalUrl = 'https://beyondvisualopt.com/guide/choose-optician/';

// 指南頁 FAQ（與聚落文章互補，不重複）
// 2026-10-20 Q4 原「配眼鏡要先看眼科嗎？」讓給驗光分類；規劃書建議的「驗光要另外付費嗎？」與 xinzhuang-glasses-guide FAQ 撞題；
// 一度改問「取件後鏡架調整要收費嗎」，又撞 /services/adjustment/ 與 frame-adjustment-handcraft 的 FAQ，國文編審改問卡片 04 的鏡片來源與保固（全站無同題）
const faqs = [
  {
    q: '驗光所和眼鏡行有什麼不同？',
    a: '差別在設立方式，不在招牌。依《驗光人員法》第九條，驗光人員可以在驗光所、眼鏡公司（商號）等核准登記的地方執業；依《驗光人員法施行細則》第四條，眼鏡行要執行驗光，必須在店內設立驗光所，由持照驗光人員執行。不管走進哪一種店，確認兩件事就好：店裡有登記的驗光所，幫你驗光的人有驗光人員證書。證書字號怎麼查，〈驗光師和驗光生差在哪？怎麼確認幫你驗光的人有執照〉有一步一步的查法。',
  },
  {
    // 2026-07-27 關鍵字集中：本題原為「新莊哪裡配眼鏡比較好」，與新莊店頁 /xinzhuang/ 互搶精準詞，
    // 已改為跨區泛用問法，在地細節交由店頁承接（見本頁「新莊店 × 板橋店」區塊內鏈）
    q: '新北配眼鏡，怎麼挑一家可以信任的店？',
    a: '我會看四件事：執行驗光的是不是持照驗光人員（執照可於衛福部醫事人員查詢系統核對）、驗光流程完不完整（能見度的完整驗光含雙眼視覺評估，約 45–60 分鐘）、配鏡參數是不是戴著你選的框量，還有配鏡後能不能回店調整、要不要另外收費。眼鏡戴得舒不舒服，很多時候要等取件、戴上幾天才知道。能見度在新莊、板橋各有一間門市，兩店的地址、交通和服務內容放在本頁下方「新莊店 × 板橋店」，從那裡也能點進各店頁面。',
  },
  {
    q: '板橋驗光所怎麼選？',
    a: '板橋從江子翠站到板橋車站一帶店家密集，價位與定位落差很大。挑選時看：幫你驗光的人是不是登記執業的持照驗光人員、老花與多焦點是否有完整加入度與瞳高量測、高度近視是否做頂點距離補正。能見度眼鏡行 × 能見度驗光所（板橋在地 1992 年創立至今）位於雙十路二段47巷28號、捷運江子翠站步行 5 分鐘，電話 02-2253-1246。',
  },
  {
    q: '挑店時，可以直接問鏡片從哪裡進貨、原廠保固怎麼走嗎？',
    a: '可以，也值得問。鏡片從哪裡進貨、原廠保固怎麼走，都可以直接問店家；配多焦點或個人化訂製鏡片，這題更要問清楚。以能見度來說，我們是蔡司 ZEISS 簽約認證經銷、HOYA 經銷。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": canonicalUrl,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
      "url": canonicalUrl,
      "headline": "新北配眼鏡怎麼挑店？看執照、驗光、量測、售後四件事",
      "dateModified": "2026-10-20",
      "description": "新北配眼鏡怎麼挑店？先看店裡有沒有登記驗光所、驗光留多少時間、配鏡參數怎麼量、取件後能不能回來調，YoYo 驗光師一頁講清楚。新莊、板橋能見度視覺中心。",
      "image": "https://beyondvisualopt.com/og-image.jpg",
      "inLanguage": "zh-TW",
      "articleSection": "完整指南",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="新北配眼鏡怎麼挑店｜新莊配眼鏡・板橋驗光所｜完整指南"
  description="新北配眼鏡怎麼挑店？先看店裡有沒有登記驗光所、驗光留多少時間、配鏡參數怎麼量、取件後能不能回來調，YoYo 驗光師一頁講清楚。新莊、板橋能見度視覺中心。"
  enPath="/en/guide/choose-optician/"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">完整指南</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        新北配眼鏡怎麼挑店？<br /><span class="text-brand-gold" style="font-size:0.6em">看執照、驗光、量測、售後四件事</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        新莊配眼鏡、板橋驗光所，該怎麼挑？店裡有沒有登記驗光所、驗光肯留多少時間、配鏡參數怎麼量、取件後能不能回來調，四件事照你走進一家店會碰到的先後排。這頁由 YoYo 驗光師執筆，寫的是新莊、板橋兩店平常驗配的做法。
      </p>
    </div>
  </section>

  <!-- TL;DR 3秒重點（GEO：answer-first） -->
  <section class="px-6 md:px-16 py-10" style="background:#eee8da">
    <div class="max-w-4xl mx-auto">
      <span class="font-sans text-brand-ink-3 tracking-widest uppercase block mb-4" style="font-size:12px;letter-spacing:0.2em">3 秒重點</span>
      <ul class="space-y-2.5">
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>眼鏡行要驗光，須在店內設立驗光所，由持照驗光人員執行（《驗光人員法施行細則》第四條）。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>能見度的完整驗光約 45–60 分鐘，新莊、板橋兩店每次驗光都做雙眼視覺評估。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>配鏡參數要戴著你選好的那副框量：瞳距左眼、右眼各量一次，配鏡高度和頂點距離也在同一副框上量。</span></li>
        <li class="flex items-start gap-3 text-brand-ink-2" style="font-size:16px;line-height:1.7"><span class="text-brand-gold mt-1 shrink-0">✦</span><span>在能見度配的眼鏡，取件後的鏡架調整不另外收費；取件後 2 週內門市會主動追蹤。</span></li>
      </ul>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '先看有沒有驗光所', href: '#difference' },
        { label: '挑店先問這幾件事', href: '#howtochoose' },
        { label: '戴起來不對', href: '#discomfort' },
        { label: '自帶鏡框', href: '#byo' },
        { label: '新莊店 × 板橋店', href: '#stores' },
        { label: '有症狀先看眼科', href: '#ophthalmology' },
        { label: '常見問題', href: '#faq' },
        { label: '作者與資料來源', href: '#author' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 眼鏡行還是驗光所（2026-10-20 比較表刪除，意圖讓給 optometrist-license-check，互搶 A） -->
  <section id="difference" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-6" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">眼鏡行還是驗光所：先看店裡有沒有登記的驗光所</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p><a href="https://law.moj.gov.tw/LawClass/LawAll.aspx?PCode=L0020190" target="_blank" rel="noopener noreferrer" class="text-brand-gold underline">《驗光人員法》</a>第九條列出驗光人員可以執業的地方：經核准登記的醫療機構、驗光所、眼鏡公司（商號），眼鏡行本來就在名單上。不過，依《驗光人員法施行細則》第四條，眼鏡公司要執行驗光業務，必須在店內設立驗光所。能見度兩間門市就是這樣的組合：新莊店是能見度視覺中心 × 比泱驗光所，板橋店是能見度眼鏡行 × 能見度驗光所。</p>
        <p>所以招牌上寫的是「眼鏡行」還是「驗光所」，挑店時可以先放一邊。要看的是店裡有沒有登記的驗光所，還有幫你驗光的那個人有沒有執照。兩種執照差在哪、證書字號去哪裡核對，<a href="/blog/optometrist-license-check/" class="text-brand-gold underline">驗光師和驗光生差在哪？怎麼確認幫你驗光的人有執照</a>整篇就在講這件事。</p>
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        有頭暈、眼睛疲勞、老花或多焦點需求的人，再多確認一件事：驗光有沒有包含雙眼視覺評估，而不是只量度數。
      </blockquote>
    </div>
  </section>

  <!-- 挑店先確認 5 件事 -->
  <section id="howtochoose" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">新北配眼鏡挑店，進門先問這幾件事</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">不論你在新莊配眼鏡還是在板橋驗光，走進店裡前，先用這幾個問題篩掉不合格的店家。</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { n: '01', title: '驗光人員有沒有執照？', desc: '持有執照的驗光人員（驗光師／驗光生）才能合法執行驗光。走進門市先看牆上：驗光所依法應將開業執照與收費標準揭示於明顯處；再到衛福部醫事人員查詢系統，核對驗光人員的證書字號。這是最基本、也最容易被忽略的一關。' },
          { n: '02', title: '驗光留多少時間？', desc: '能見度的完整驗光約 45–60 分鐘，預約時段留 60–90 分鐘，兩店每次都做雙眼視覺評估。時間長短倒不是重點，選店時不妨問一句：這段時間裡，你們會做哪些事？', link: { href: '/blog/eye-exam-duration-difference/', text: '驗光要多久？10 分鐘和 1 小時差在哪' } },
          { n: '03', title: '有沒有量頂點距離與雙眼視覺？', desc: '高度近視要量頂點距離（Vertex Distance），有效度數才補正得準。兩眼一起用本來就比較吃力的人，只照度數配，戴久了容易累、容易暈。單眼瞳距要左右分開量，配鏡高度要戴著你挑好的框量。這幾項做了沒，戴起來舒不舒服，差別常常就在這裡。' },
          { n: '04', title: '鏡片來源與原廠保固問得到嗎？', desc: '鏡片從哪裡進貨、原廠保固怎麼走，都可以直接問店家。配多焦點或個人化訂製鏡片，這題更要問。能見度是蔡司 ZEISS 簽約認證經銷、HOYA 經銷。' },
          { n: '05', title: '配鏡後能不能回店調整？要不要收費？', desc: '選店前先把這兩件事問清楚。在能見度配的眼鏡，取件後的鏡架調整不另外收費，取件後 2 週內門市會主動追蹤。拿到眼鏡那天，要當場試戴：遠、中、近都看過一輪，鏡架坐得穩不穩也確認過，才算交件。' },
        ].map(item => (
          <div class="border border-brand-ink/8 rounded-2xl p-7">
            <span class="font-sans text-brand-gold font-semibold tracking-widest mb-3 block" style="font-size:13px;letter-spacing:0.18em">{item.n}</span>
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:19px;font-weight:600">{item.title}</h3>
            <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">{item.desc}</p>
            {item.link && <a href={item.link.href} class="inline-block mt-3 text-brand-gold underline" style="font-size:14px">{item.link.text}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 配完戴起來不對：聚落入口（2026-10-20 取代「常見配鏡地雷」5 條，誤區內容讓給 common-optometry-mistakes，互搶 D） -->
  <section id="discomfort" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">配完戴起來不對：頭暈、不舒服先查哪裡</h2>
      <p class="text-brand-ink-3 mb-10" style="font-size:16px;line-height:1.8">眼鏡配好了，戴起來卻頭暈、看久了累，先別急著認定是自己不適應。原因可能在度數，也可能在量測位置、鏡架走位，或兩眼一起用的協調，得回店一項一項查。下面三篇照狀況分，對到哪一種，就從哪一篇讀起。</p>
      <div class="space-y-6">
        {[
          { title: '新眼鏡頭暈', desc: '剛換眼鏡會暈，有時只是還在適應，有時是配鏡參數或鏡架位置跑掉了。幾天內該好轉、拖到什麼程度該回店，文章裡列了 5 個要查的原因。', href: '/blog/glasses-dizzy/', text: '新眼鏡戴了頭暈正常嗎？幾天會好、5 個要回店查的原因' },
          { title: '度數沒錯還是不舒服', desc: '視力表看得清楚，戴久了還是累，遮一隻眼反而舒服？那可能要往度數以外找：兩眼一起用的協調，還有你平常看東西的距離。', href: '/blog/glasses-uncomfortable-3-reasons/', text: '配了眼鏡還是不舒服？度數之外的 3 個原因' },
          { title: '驗光少做的那一步', desc: '驗光時漏掉哪一步，戴起來就會出狀況？最常見的五個誤區，這篇一個一個拆開來看。', href: '/blog/common-optometry-mistakes/', text: '配眼鏡常見的 5 個驗光誤區：少做哪一步，戴起來就不對' },
        ].map(item => (
          <div class="bg-white border border-brand-ink/8 rounded-2xl p-7">
            <h3 class="font-serif text-brand-navy mb-3" style="font-size:18px;font-weight:600">{item.title}</h3>
            <p class="text-brand-ink-2 mb-3" style="font-size:16px;line-height:1.8">{item.desc}</p>
            <a href={item.href} class="text-brand-gold underline" style="font-size:15px">{item.text}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 框不是在店裡買的（2026-10-20 新增，自帶框細節歸指南 byo） -->
  <section id="byo" class="px-6 md:px-16 py-20 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-6" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">框不是在店裡買的：自帶鏡框與網購眼鏡</h2>
      <div class="space-y-5 text-brand-ink-2" style="font-size:17px;line-height:1.85">
        <p>框是自己帶來的，一樣能配鏡片，前提是驗光人員看過框況，確定做得了。哪些框能做、量測怎麼走、收費怎麼算，都在<a href={BYO_GUIDE} class="text-brand-gold underline">{GUIDE_TITLES[BYO_GUIDE]}</a>裡。</p>
        <p>如果你還在猶豫要不要整副在網路上買，先讀<a href="/blog/online-glasses-vs-store/" class="text-brand-gold underline">網購眼鏡和門市配鏡差在哪？量測參數與售後調整的實際差別</a>再決定也不遲。</p>
      </div>
    </div>
  </section>

  <!-- 新莊店 × 板橋店 -->
  <section id="stores" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-serif text-white mb-4" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">新莊店 × 板橋店</h2>
