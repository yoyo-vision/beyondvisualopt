}
/* 側面照用 B 值當基準時就不需要比例尺，把那兩個把手收起來——
   少兩個圈要拖，畫面也乾淨 */
function handlesFor(mode) {
  const noRuler = (mode === 'side' && S.sideScaleMode === 'frameB')
    || (mode === 'trial' && S.trialScaleMode === 'disc')
  return noRuler ? HANDLES[mode].filter(h => h.k !== 'ruler1' && h.k !== 'ruler2') : HANDLES[mode] }

/* 試鏡架照的 px/mm：試片直徑基準時＝試片投影長度 ÷ 直徑 */
function trialPxMm(tm) {
  return S.trialScaleMode === 'disc'
    ? (S.trialDiscMm > 0 ? dist(tm.lensTop, tm.lensBottom) / S.trialDiscMm : 0)
    : dist(tm.ruler1, tm.ruler2) / S.rulerMm }

/* 近用照：框下緣把手對齊各自瞳孔的 x，圓圈永遠在瞳孔正下方，
   一眼看得出那條線在量哪一眼的瞳高 */
function normalizeNear(m) {
  if (!m || !m.rBottom) return
  m.rBottom.x = m.rPupil.x
  m.lBottom.x = m.lPupil.x }

/* 側面照的 px/mm：B 值基準時＝鏡片投影長度 ÷ B 值 */
function sidePxMm(sm) {
  return S.sideScaleMode === 'frameB'
    ? (S.bValueMm > 0 ? dist(sm.lensTop, sm.lensBottom) / S.bValueMm : 0)
    : dist(sm.ruler1, sm.ruler2) / S.rulerMm }

/* 量測線一載入就在大致位置，使用者只要拖到位 */
function defaultMarks(mode, w, h) {
  if (mode === 'front') return {
    ruler1: { x: w * .22, y: h * .86 }, ruler2: { x: w * .45, y: h * .86 },
    rTop: { x: w * .355, y: h * .40 }, rBottom: { x: w * .355, y: h * .55 },
    rLeft: { x: w * .26, y: h * .475 }, rRight: { x: w * .45, y: h * .475 },
    lTop: { x: w * .645, y: h * .40 }, lBottom: { x: w * .645, y: h * .55 },
    lLeft: { x: w * .55, y: h * .475 }, lRight: { x: w * .74, y: h * .475 },
    rPupil: { x: w * .38, y: h * .47 }, lPupil: { x: w * .62, y: h * .47 } }
  if (mode === 'side' || mode === 'trial') return {
    ruler1: { x: w * .22, y: h * .82 }, ruler2: { x: w * .45, y: h * .82 },
    lensTop: { x: w * .64, y: h * .34 }, lensBottom: { x: w * .60, y: h * .56 },
    cornea: { x: w * .48, y: h * .45 } }
  if (mode === 'near') return {
    ruler1: { x: w * .22, y: h * .86 }, ruler2: { x: w * .45, y: h * .86 },
    rInner: { x: w * .46, y: h * .50 }, lInner: { x: w * .54, y: h * .50 },
    rBottom: { x: w * .40, y: h * .58 }, lBottom: { x: w * .60, y: h * .58 },
    rPupil: { x: w * .40, y: h * .48 }, lPupil: { x: w * .60, y: h * .48 } }
  return {
    rInner: { x: w * .45, y: h * .48 }, rOuter: { x: w * .18, y: h * .54 },
    lInner: { x: w * .55, y: h * .48 }, lOuter: { x: w * .82, y: h * .54 } }
}

/* 各模式的操作說明（純文字，重建無害） */
const SET_NOTE = {
  front: `每片鏡片有<b>上、下、外、內四條線</b>，各自拖到貼齊鏡片邊緣即可
    （上下線只能上下移、左右線只能左右移，一次只調一邊）。線會往外延伸一段，
    沿著線看就知道有沒有對齊。兩個紅點拖到<b>瞳孔正中心</b>，中線與偏心量自己算。`,
  side: `尺度預設用<b>正面照量到的鏡片高（B 值）</b>——側面照裡鏡片的投影長度就是 B，
    所以<b>側面照不用再貼一次比例尺</b>。相機要與眼睛同高、正對側面，
    另一側的眉眼要完全看不到才算正。`,
  top: `俯視照<b>不需要比例尺</b>——面彎是角度，不靠尺度基準。相機在頭頂正中央即可。`,
  near: `量<b>近用眼位</b>：橘圈拖到鏡框內緣（定中線）與鏡片下緣（算瞳高），
    紅圈拖到看近時的瞳孔中心。會自動算出<b>水平會聚</b>與<b>垂直下移</b>——
    垂直下移就是漸進片走廊長度要對上的量。這張<b>需要比例尺</b>。`,
  trial: `量的是<b>驗光當下</b>的頂距，會自動填進下方處方區的「驗光時頂點距離」。
    尺度用<b>試片直徑</b>（標準 38mm），所以這張也不用貼比例尺。
    疊了多片時，請標<b>貼近眼睛那一片</b>。`,
}

/* ════════════════════════════════════════════════════════════════
   3. 狀態
   ════════════════════════════════════════════════════════════════ */
const MAX_EDGE = 1800   /* 繪製效能上限；不影響準度：照片與 px/mm 等比縮小會互相抵消 */
const S = {
  mode: 'front',
  img: { front: null, side: null, top: null },
  marks: { front: null, side: null, top: null },
  rulerMm: 30, bValueMm: 32, lensThickness: 0, facing: 'right', noseUp: false,
  sideScaleMode: 'frameB',   /* 側面照尺度基準：frameB＝用正面照量到的鏡片高，ruler＝照片上的比例尺 */
  bAuto: true,               /* B 值是否自動沿用正面照結果（手動改過就停止） */
  trialScaleMode: 'disc',    /* 試鏡架照尺度基準：disc＝試片直徑（標準 38mm），ruler＝比例尺 */
  trialDiscMm: 38,           /* 試片直徑；多數試片組為 38mm，少數 36／40 */
  trialThickness: 0,         /* 試片中心厚度；標後表面就填 0 */
  refVertexAuto: true,       /* 驗光頂距是否自動吃試鏡架照的量測值 */
  workMm: 400,               /* 近用工作距離 mm（習慣閱讀距離） */
  zoom: 1, sel: null, drag: null, displayScale: 1,
  rx: { R: { sphere: 0, cylinder: 0, axis: 180 }, L: { sphere: 0, cylinder: 0, axis: 180 } },
}
const $ = id => document.getElementById(id)
let _chromeKey = ''   /* 外框（分頁／把手清單）的髒檢查 */
const cv = $('cv'), loupe = $('loupe')

/* 四個邊把手 → 矩形邊界。左右／上下自動取小大，拖過頭也不會翻面 */
function frontBounds(m) {
  const R = { l: Math.min(m.rLeft.x, m.rRight.x), r: Math.max(m.rLeft.x, m.rRight.x),
              t: Math.min(m.rTop.y, m.rBottom.y), b: Math.max(m.rTop.y, m.rBottom.y) }
  const L = { l: Math.min(m.lLeft.x, m.lRight.x), r: Math.max(m.lLeft.x, m.lRight.x),
              t: Math.min(m.lTop.y, m.lBottom.y), b: Math.max(m.lTop.y, m.lBottom.y) }
  return { R, L } }

/* 把手歸位到各自邊的中點，這樣圓圈永遠落在線上，看得出在調哪一條 */
function normalizeFront(m) {
  if (!m || !m.rTop) return
  const B = frontBounds(m)
  const rcx = (B.R.l + B.R.r) / 2, rcy = (B.R.t + B.R.b) / 2
  m.rTop.x = rcx; m.rBottom.x = rcx; m.rLeft.y = rcy; m.rRight.y = rcy
  const lcx = (B.L.l + B.L.r) / 2, lcy = (B.L.t + B.L.b) / 2
  m.lTop.x = lcx; m.lBottom.x = lcx; m.lLeft.y = lcy; m.lRight.y = lcy }

/* ════════════════════════════════════════════════════════════════
   4. 繪製
   ════════════════════════════════════════════════════════════════ */
function draw() {
  const src = S.img[S.mode], m = S.marks[S.mode]
  if (!src || !m) return
  if (S.mode === 'front') normalizeFront(m)
  if (S.mode === 'near') normalizeNear(m)
  cv.width = src.width; cv.height = src.height
  const c = cv.getContext('2d')
  c.drawImage(src, 0, 0)
  const s = Math.max(src.width / 700, 1)   /* 把手隨解析度縮放 */

  const seg = (a, b, col, w = 3) => {
    if (!m[a] || !m[b]) return
    c.strokeStyle = col; c.lineWidth = w * s; c.setLineDash([])
    c.beginPath(); c.moveTo(m[a].x, m[a].y); c.lineTo(m[b].x, m[b].y); c.stroke() }

  if (S.mode === 'front') {
    seg('ruler1', 'ruler2', '#c9a84c')
    const B = frontBounds(m)
    /* 四條邊各向外延伸一段，才能沿著線看出有沒有貼齊鏡片邊緣 */
    const box = (b, col) => {
      const ex = (b.r - b.l) * .16, ey = (b.b - b.t) * .16
      c.strokeStyle = col; c.setLineDash([])
      c.lineWidth = 2.6 * s
      c.strokeRect(b.l, b.t, b.r - b.l, b.b - b.t)
      c.lineWidth = 1.3 * s
      c.beginPath()
      c.moveTo(b.l - ex, b.t); c.lineTo(b.r + ex, b.t)
      c.moveTo(b.l - ex, b.b); c.lineTo(b.r + ex, b.b)
      c.moveTo(b.l, b.t - ey); c.lineTo(b.l, b.b + ey)
      c.moveTo(b.r, b.t - ey); c.lineTo(b.r, b.b + ey)
      c.stroke() }
    box(B.R, '#2563eb'); box(B.L, '#0d9488')
    const rIn = B.R.r, lIn = B.L.l
    const mid = (rIn + lIn) / 2
    c.strokeStyle = 'rgba(255,255,255,.85)'; c.lineWidth = 1.8 * s; c.setLineDash([8 * s, 6 * s])
    c.beginPath(); c.moveTo(mid, 0); c.lineTo(mid, cv.height); c.stroke()
    c.strokeStyle = '#c9a84c'; c.lineWidth = 2.2 * s; c.setLineDash([])
    c.beginPath(); c.moveTo(rIn, m.rPupil.y); c.lineTo(lIn, m.rPupil.y); c.stroke()
    c.strokeStyle = '#dc2626'; c.lineWidth = 2 * s; c.setLineDash([5 * s, 4 * s])
    ;[[m.rPupil, B.R.b], [m.lPupil, B.L.b]].forEach(([pu, bot]) => {
      c.beginPath(); c.moveTo(pu.x, pu.y); c.lineTo(pu.x, bot); c.stroke() })
    c.setLineDash([])
  } else if (S.mode === 'near') {
    seg('ruler1', 'ruler2', '#c9a84c')
    const mid = (m.rInner.x + m.lInner.x) / 2
    c.strokeStyle = 'rgba(255,255,255,.85)'; c.lineWidth = 1.8 * s; c.setLineDash([8 * s, 6 * s])
    c.beginPath(); c.moveTo(mid, 0); c.lineTo(mid, cv.height); c.stroke()
    c.setLineDash([])
    seg('rInner', 'lInner', '#ea580c', 2.4)
    /* 框下緣：畫成水平線並往外延伸，方便沿線對齊 */
    c.strokeStyle = '#ea580c'; c.lineWidth = 2.2 * s; c.setLineDash([])
    const halfw = Math.abs(m.lPupil.x - m.rPupil.x) * 0.42
    for (const b of [m.rBottom, m.lBottom]) {
      c.beginPath(); c.moveTo(b.x - halfw, b.y); c.lineTo(b.x + halfw, b.y); c.stroke()
    }
    /* 兩瞳孔連線＝近用 PD */
    c.strokeStyle = '#dc2626'; c.lineWidth = 2.6 * s
    c.beginPath(); c.moveTo(m.rPupil.x, m.rPupil.y); c.lineTo(m.lPupil.x, m.lPupil.y); c.stroke()
    /* 瞳孔 → 框下緣＝近用瞳高 */
    c.lineWidth = 2 * s; c.setLineDash([5 * s, 4 * s])
    for (const [pu, bo] of [[m.rPupil, m.rBottom], [m.lPupil, m.lBottom]]) {
      c.beginPath(); c.moveTo(pu.x, pu.y); c.lineTo(pu.x, bo.y); c.stroke()
    }
    c.setLineDash([])
  } else if (S.mode === 'side' || S.mode === 'trial') {
    const isTrial = S.mode === 'trial'
    const showRuler = isTrial ? S.trialScaleMode === 'ruler' : S.sideScaleMode === 'ruler'
    if (showRuler) seg('ruler1', 'ruler2', '#c9a84c')
    seg('lensTop', 'lensBottom', isTrial ? '#7c3aed' : '#2563eb')
    const dy = m.lensBottom.y - m.lensTop.y
    const ix = Math.abs(dy) < 1e-9 ? (m.lensTop.x + m.lensBottom.x) / 2
      : m.lensTop.x + ((m.cornea.y - m.lensTop.y) / dy) * (m.lensBottom.x - m.lensTop.x)
    c.strokeStyle = '#dc2626'; c.lineWidth = 2 * s; c.setLineDash([6 * s, 4 * s])
    c.beginPath(); c.moveTo(m.cornea.x, m.cornea.y); c.lineTo(ix, m.cornea.y); c.stroke()
    c.setLineDash([])
  } else {
    seg('rInner', 'rOuter', '#2563eb'); seg('lInner', 'lOuter', '#0d9488')
    c.strokeStyle = 'rgba(255,255,255,.75)'; c.lineWidth = 1.8 * s; c.setLineDash([7 * s, 5 * s])
    c.beginPath(); c.moveTo(m.rInner.x, m.rInner.y); c.lineTo(m.lInner.x, m.lInner.y); c.stroke()
    c.setLineDash([])
  }

  /* 把手：空心圓中心留空，才看得到底下的照片細節 */
  handlesFor(S.mode).forEach((h, i) => {
    const p = m[h.k]; if (!p) return
    const on = h.k === S.sel || h.k === S.drag
    const R = (on ? 15 : 12) * s
    c.strokeStyle = 'rgba(0,0,0,.55)'; c.lineWidth = (on ? 5 : 4) * s
    c.beginPath(); c.arc(p.x, p.y, R, 0, 6.2832); c.stroke()
    c.strokeStyle = h.c; c.lineWidth = (on ? 3.2 : 2.4) * s
    c.beginPath(); c.arc(p.x, p.y, R, 0, 6.2832); c.stroke()
    c.beginPath()
    c.moveTo(p.x - R * .55, p.y); c.lineTo(p.x + R * .55, p.y)
    c.moveTo(p.x, p.y - R * .55); c.lineTo(p.x, p.y + R * .55); c.stroke()
    c.font = `bold ${12 * s}px sans-serif`
    c.strokeStyle = 'rgba(0,0,0,.75)'; c.lineWidth = 3.5 * s
    c.strokeText(i + 1, p.x + R + 3 * s, p.y - R * .5)
    c.fillStyle = '#fff'; c.fillText(i + 1, p.x + R + 3 * s, p.y - R * .5)
  })
}

/* 放大鏡：手指會蓋住標記，沒有它在手機上等於盲點。
   取樣半徑依畫面顯示比動態調整，固定呈現「畫面的 4 倍」。 */
function drawLoupe(p) {
  const src = S.img[S.mode]
  const c = loupe.getContext('2d')
  c.clearRect(0, 0, loupe.width, loupe.height)
  if (!p || !src) { loupe.classList.remove('on'); return }
  const eff = Math.max(S.displayScale * S.zoom, .05)
  const span = Math.max(12, Math.round(loupe.width / (4 * eff) / 2))
  c.imageSmoothingEnabled = false
  c.drawImage(src, p.x - span, p.y - span, span * 2, span * 2, 0, 0, loupe.width, loupe.height)
  const m = loupe.width / 2
  c.strokeStyle = 'rgba(0,0,0,.6)'; c.lineWidth = 3
  c.beginPath(); c.moveTo(m - 14, m); c.lineTo(m + 14, m); c.moveTo(m, m - 14); c.lineTo(m, m + 14); c.stroke()
  c.strokeStyle = '#fff'; c.lineWidth = 1.4
  c.beginPath(); c.moveTo(m - 14, m); c.lineTo(m + 14, m); c.moveTo(m, m - 14); c.lineTo(m, m + 14); c.stroke()
  loupe.classList.add('on')
}

/* ════════════════════════════════════════════════════════════════
   5. 計算與渲染
   ════════════════════════════════════════════════════════════════ */
function measure() {
  const out = { panto: null, vertex: null, faceForm: null, ffDetail: null, front: null, trialVertex: null, near: null, nearTheory: null, msgs: [] }
  const fm = S.marks.front, sm = S.marks.side, tm = S.marks.top

  if (sm) {
    const mk = { lensTop: sm.lensTop, lensBottom: sm.lensBottom, corneaApex: sm.cornea, facing: S.facing }
    out.panto = pantoFromMarks(mk)
    const pxmm = sidePxMm(sm)
    if (pxmm > 0) out.vertex = vertexFromMarks(mk, pxmm, S.lensThickness)
    if (S.mode === 'side') {
      if (pxmm > 0) out.msgs.push(...checkResolution(pxmm * S.displayScale * S.zoom))
      if (S.sideScaleMode === 'ruler') {
        out.msgs.push(...checkRuler(sm.ruler1, sm.ruler2, S.rulerMm))
        /* 有比例尺才驗得出相機有沒有正對側面：鏡片投影短於 B 就是偏了 */
        out.msgs.push(...checkSide(mk, S.bValueMm, pxmm))
      } else if (!(S.bValueMm > 0)) {
        out.msgs.push({ l: 'e', m: '缺鏡框 B 值，無法換算頂點距離。先量正面照，或改用照片上的比例尺' })
      } else {
        /* 用 B 值當基準時，投影長度被定義成 B，就驗不出相機是否正對側面了——
           這個檢查得靠拍攝時自己確認（另一側的眉眼要完全看不到） */
        out.msgs.push({ l: 'w', m: `尺度用鏡框 B 值 ${S.bValueMm.toFixed(1)}mm 換算。此模式無法自動偵測「相機沒正對側面」，請確認拍攝時另一側的眉眼完全看不到` })
      }
    }
  }
  if (tm) {
    out.ffDetail = faceFormFromMarks(tm, S.noseUp)
    out.faceForm = out.ffDetail.mean
    if (S.mode === 'top') out.msgs.push(...checkTop(out.ffDetail))
  }
  if (fm) {
    const pxmm = dist(fm.ruler1, fm.ruler2) / S.rulerMm
    const B = frontBounds(fm)
    out.front = frontFromMarks({
      rBoxTL: { x: B.R.l, y: B.R.t }, rBoxBR: { x: B.R.r, y: B.R.b },
      lBoxTL: { x: B.L.l, y: B.L.t }, lBoxBR: { x: B.L.r, y: B.L.b },
      rPupil: fm.rPupil, lPupil: fm.lPupil }, pxmm)
    /* 正面照量到的鏡片高就是側面照的尺度基準——側面照因此不必再貼一次比例尺 */
    if (S.bAuto) S.bValueMm = (out.front.rB + out.front.lB) / 2
    if (S.mode === 'front') {
      out.msgs.push(...checkResolution(pxmm * S.displayScale * S.zoom))
      out.msgs.push(...checkRuler(fm.ruler1, fm.ruler2, S.rulerMm))
      out.msgs.push(...checkFront(out.front, {
        rBoxTL: { x: B.R.l, y: B.R.t }, rBoxBR: { x: B.R.r, y: B.R.b },
        lBoxTL: { x: B.L.l, y: B.L.t }, lBoxBR: { x: B.L.r, y: B.L.b } }, pxmm))
    }
  }
  const nm = S.marks.near
  if (nm) {
    const pxmm = dist(nm.ruler1, nm.ruler2) / S.rulerMm
    if (pxmm > 0) {
      out.near = nearFromMarks(nm, pxmm)
      out.nearTheory = out.front ? nearPdTheory(out.front.pd, S.workMm) : null
      if (S.mode === 'near') {
        out.msgs.push(...checkResolution(pxmm * S.displayScale * S.zoom))
        out.msgs.push(...checkRuler(nm.ruler1, nm.ruler2, S.rulerMm))
        out.msgs.push(...checkNear(out.near, out.front, S.workMm))
        if (!out.front) out.msgs.push({ l: 'w', m: '尚未量正面照，無法比對會聚量與理論值' })
      }
    }
  }

  const trm = S.marks.trial
  if (trm) {
    const pxmm = trialPxMm(trm)
    if (pxmm > 0) {
      const mk = { lensTop: trm.lensTop, lensBottom: trm.lensBottom, corneaApex: trm.cornea, facing: S.facing }
      out.trialVertex = vertexFromMarks(mk, pxmm, S.trialThickness)
      if (S.mode === 'trial') {
        out.msgs.push(...checkResolution(pxmm * S.displayScale * S.zoom))
        if (S.trialScaleMode === 'ruler') out.msgs.push(...checkRuler(trm.ruler1, trm.ruler2, S.rulerMm))
        const lx = lensXAtCornea(mk)
        const behind = S.facing === 'right' ? mk.corneaApex.x < lx : mk.corneaApex.x > lx
        if (!behind) out.msgs.push({ l: 'e', m: '角膜頂點標在試片前方，請確認標點與「臉朝」設定' })
        if (out.trialVertex < 5 || out.trialVertex > 30)
          out.msgs.push({ l: 'e', m: `試鏡架頂距算出 ${out.trialVertex.toFixed(1)}mm，超出合理範圍，請確認試片直徑與標點` })
        else if (out.trialVertex > 18)
          out.msgs.push({ l: 'w', m: `試鏡架頂距 ${out.trialVertex.toFixed(1)}mm 偏大（常見 12–16mm）。試鏡架若沒調貼近臉，補償量會被放大` })
      }
    } else if (S.mode === 'trial') {
      out.msgs.push({ l: 'e', m: '缺試片直徑，無法換算。填入試片直徑或改用照片上的比例尺' })
    }
  }

  out.msgs.push(...validateFit(out))
  return out
}

const fmtRx = rx => {
  const s = rx.sphere >= 0 ? '+' + rx.sphere.toFixed(2) : rx.sphere.toFixed(2)
  return Math.abs(rx.cylinder) < .01 ? s + ' DS' : `${s} / ${rx.cylinder.toFixed(2)} × ${Math.round(rx.axis)}` }
const fmtD = v => Math.abs(v) < .005 ? '—' : (v > 0 ? '+' : '') + v.toFixed(2)

function render() {
  const M = measure()

  /* 分頁與把手清單只在真的變動時重建（拖曳時每幀重建 DOM 會閃爍又浪費） */
  const chromeKey = [S.mode, S.sel, S.sideScaleMode, MODES.map(m => S.marks[m] ? 1 : 0).join(''), S.img[S.mode] ? 1 : 0].join('|')
  const chromeDirty = chromeKey !== _chromeKey
  if (chromeDirty) _chromeKey = chromeKey

  if (chromeDirty) $('tabs').innerHTML = MODES.map(m =>
    `<button data-m="${m}" class="${S.mode === m ? 'on' : ''}">${MODE_LABEL[m]}${S.marks[m] ? ' <span class="tick">✓</span>' : ''}</button>`
  ).join('')

  /* 照片區 */
  const hasImg = !!S.img[S.mode]
  $('dropWrap').hidden = hasImg
  $('stageWrap').hidden = !hasImg
  $('dropTitle').textContent = `拍／選一張${MODE_LABEL[S.mode]}`
  $('dropHint').textContent = DROP_HINT[S.mode]
  $('handlesCard').hidden = !hasImg
  if (hasImg) {
    if (chromeDirty) {
      $('handlesTitle').textContent = `把 ${handlesFor(S.mode).length} 個圈拖到位`
      $('handleList').innerHTML = handlesFor(S.mode).map((h, i) =>
        `<li><button data-k="${h.k}" class="${S.sel === h.k ? 'on' : ''}">
          <span class="n" style="color:${h.c}">${i + 1}</span>
          <span><b>${h.l}</b><em>${h.h}</em></span></button></li>`).join('')
      $('selHint').innerHTML = S.sel
        ? `已選<b>${handlesFor(S.mode).find(h => h.k === S.sel)?.l}</b>：方向鍵微調 1px、Shift＋方向鍵 5px`
        : ''
    }
    draw()
  }

  /* 主要數值 */
  $('mainVals').innerHTML = [
    ['前傾角', M.panto, '°'], ['頂點距離', M.vertex, ' mm'], ['面彎', M.faceForm, '°'],
    ['試鏡架頂距', M.trialVertex, ' mm'],
  ].map(([k, v, u]) => `<div class="kv"><dt>${k}</dt>
    <dd class="${v == null ? 'none' : ''}">${v == null ? '—' : v.toFixed(1) + u}</dd></div>`).join('')
  $('ffDetail').innerHTML = (M.ffDetail && M.ffDetail.asymmetry > .5)
    ? `<div class="inline3"><span>右 ${M.ffDetail.right.toFixed(1)}°</span>
       <span>左 ${M.ffDetail.left.toFixed(1)}°</span>
       <span${M.ffDetail.asymmetry > 1 ? ' style="color:var(--warn-fg)"' : ''}>差 ${M.ffDetail.asymmetry.toFixed(1)}°</span></div>`
    : ''

  /* 近用眼位 */
  $('nearCard').hidden = !M.near
  if (M.near) {
    const N = M.near, F = M.front
    const conv = F ? F.pd - N.pd : null
    const rows = [['近用單眼 PD', N.rPd, N.lPd, true], ['近用瞳高', N.rHeight, N.lHeight, true]]
    if (F) {
      rows.push(['遠用單眼 PD', F.rPd, F.lPd, false], ['遠用瞳高', F.rHeight, F.lHeight, false])
      rows.push(['水平會聚（單眼）', F.rPd - N.rPd, F.lPd - N.lPd, true])
      rows.push(['垂直下移', F.rHeight - N.rHeight, F.lHeight - N.lHeight, true])
    }
    $('nearTable').innerHTML = '<thead><tr><th></th><th>右</th><th>左</th></tr></thead><tbody>' +
      rows.map(([k, r, l, strong]) => `<tr><td>${k}</td>` +
        (strong ? `<td><b>${r.toFixed(1)}</b></td><td><b>${l.toFixed(1)}</b></td>`
                : `<td>${r.toFixed(1)}</td><td>${l.toFixed(1)}</td>`) + '</tr>').join('') +
      '</tbody>'
    $('nearInline').innerHTML =
      `<span>近用 PD <b>${N.pd.toFixed(1)}</b></span>` +
      (F ? `<span>遠用 <b>${F.pd.toFixed(1)}</b></span><span>雙眼會聚 <b>${conv.toFixed(1)}</b></span>` : '') +
      (M.nearTheory != null ? `<span style="color:var(--text-3)">理論 ${M.nearTheory.toFixed(1)}</span>` : '')
    /* 漸進走廊要裝得進遠用瞳高：走廊下方還要留近用區，抓 2mm 餘裕 */
    $('nearCorridor').innerHTML = F
      ? `遠用瞳高 ${Math.min(F.rHeight, F.lHeight).toFixed(1)}mm　→　
         可用走廊長度上限約 <b>${(Math.min(F.rHeight, F.lHeight) - 2).toFixed(0)}mm</b>
         <span class="note">（走廊下方仍需留近用區，抓 2mm 餘裕；實際可選長度依鏡片型號規格）</span>`
      : '<span class="note">量了正面照才能推算可用的走廊長度</span>'
  }

  /* 正面照數據 */
  $('frontCard').hidden = !M.front
  if (M.front) {
    const F = M.front
    $('frontTable').innerHTML = '<thead><tr><th></th><th>右</th><th>左</th></tr></thead><tbody>' +
      [['A 鏡片寬', F.rA, F.lA], ['B 鏡片高', F.rB, F.lB], ['單眼 PD', F.rPd, F.lPd],
       ['瞳高', F.rHeight, F.lHeight], ['偏心量', F.rDecentration, F.lDecentration]]
      .map(([k, r, l]) => `<tr><td>${k}</td><td><b>${r.toFixed(1)}</b></td><td><b>${l.toFixed(1)}</b></td></tr>`).join('') +
      '</tbody>'
    $('frontInline').innerHTML =
      `<span>DBL <b>${F.dbl.toFixed(1)}</b></span><span>PD <b>${F.pd.toFixed(1)}</b></span><span>FPD <b>${F.fpd.toFixed(1)}</b></span>`
    $('frameCode').textContent = `框標示寫法：${F.rA.toFixed(0)}□${F.dbl.toFixed(0)}`
  }

  /* 量測設定：只切換顯示與說明，input 保持原本的 DOM 節點——
     重建 innerHTML 會把使用者正在打字的輸入框銷毀，焦點掉了、版面重排，畫面就跳 */
  /* 側面照用 B 值當基準時就不必貼比例尺，那一列收起來 */
  $('rowRuler').hidden = S.mode === 'top'
    || (S.mode === 'side' && S.sideScaleMode === 'frameB')
    || (S.mode === 'trial' && S.trialScaleMode === 'disc')
  $('setSideOnly').hidden = S.mode !== 'side'
  $('setNearOnly').hidden = S.mode !== 'near'
  $('setTrialOnly').hidden = S.mode !== 'trial'
  $('setTopOnly').hidden = S.mode !== 'top'
  $('setNote').innerHTML = SET_NOTE[S.mode]
  /* B 值輸入框跟著正面照更新，但正在編輯它時不要打斷 */
  if (S.bAuto && document.activeElement !== $('setB')) $('setB').value = S.bValueMm.toFixed(1)
  $('bSrc').textContent = S.bAuto
    ? (S.marks.front ? '正面照自動帶入' : '尚未量正面照，用預設值')
    : '手動輸入（點此改回自動）'
  $('bSrc').style.cursor = S.bAuto ? '' : 'pointer'

  /* 提示 */
  $('msgs').innerHTML = M.msgs.map(w =>
    `<div class="msg ${w.l}"><span class="ic">${w.l === 'e' ? '✕' : '!'}</span><span>${w.m}</span></div>`).join('')

  /* 試鏡架照量到的頂距就是「驗光當下的頂距」，自動填進處方換算的基準；
     正在編輯該欄時不打斷 */
  if (M.trialVertex != null && S.refVertexAuto && document.activeElement !== $('refVertex'))
    $('refVertex').value = (Math.round(M.trialVertex * 2) / 2).toFixed(1)
  $('refVertexSrc').textContent = M.trialVertex != null && S.refVertexAuto
    ? `試鏡架照量到 ${M.trialVertex.toFixed(1)}mm`
    : (S.refVertexAuto ? '尚未拍試鏡架照，請自行填入' : '手動輸入（點此改回自動）')
  $('refVertexSrc').style.cursor = S.refVertexAuto ? '' : 'pointer'

  /* 處方補償：三個參數只要有值就算，缺的當中性值 */
  const anyFit = M.panto != null || M.vertex != null || M.faceForm != null
  $('rxCard').hidden = !anyFit
  if (anyFit) {
    const p = {
      vertex: M.vertex ?? +$('refVertex').value,
      refVertex: +$('refVertex').value,
      pantoscopic: M.panto ?? 0,
      faceForm: M.faceForm ?? 0,
      index: +$('lensIndex').value,
      applyPantoscopic: $('applyPanto').checked,
    }
    const res = { R: calcFitting(S.rx.R, p), L: calcFitting(S.rx.L, p) }
    $('rxOut').innerHTML = ['R', 'L'].map(e => {
      const r = res[e]
      return `<div class="line"><span class="eye">${e}</span>
        <span class="old">${fmtRx(r.original)}</span><span class="arrow">→</span>
        <span class="new">${fmtRx(r.finalRounded)}</span>
        <span class="pill ${r.significant ? 'hit' : 'no'}">${r.significant ? '差異達 0.25D 以上' : '差異很小'}</span></div>
        <div class="delta">S ${fmtD(r.delta.sphere)}　C ${fmtD(r.delta.cylinder)}　軸 ${r.delta.axis}°　SE ${fmtD(r.delta.se)}</div>` }).join('')
    $('ocDrop').innerHTML = `光心下移估算 <b>${res.R.drop} mm</b>
      <span class="note">（前傾角 × 0.5 的光學經驗值）</span>`
    window.__res = res
  }
  window.__M = M
}

/* ════════════════════════════════════════════════════════════════
   6. 互動
   ════════════════════════════════════════════════════════════════ */
function loadFile(f) {
  /* 官網 CSP 的 img-src 不含 blob:，改用 FileReader 轉 data: URL；照片只在瀏覽器內處理，不上傳 */
  const reader = new FileReader()
  reader.onload = () => {
    const im = new Image()
    im.onerror = () => {
      alert('這張圖讀不出來。\n\n若是 iPhone 的 HEIC 檔，請先用內建「照片」App 分享成 JPG 再選，\n或到「設定 → 相機 → 格式」改用 JPG 相容格式後重拍。')
    }
    im.onload = () => {
      const k = Math.min(1, MAX_EDGE / Math.max(im.naturalWidth, im.naturalHeight))
      const off = document.createElement('canvas')
      off.width = Math.round(im.naturalWidth * k)
      off.height = Math.round(im.naturalHeight * k)
      off.getContext('2d').drawImage(im, 0, 0, off.width, off.height)
      S.img[S.mode] = off
      S.marks[S.mode] = defaultMarks(S.mode, off.width, off.height)
      S.sel = null
      render()
      requestAnimationFrame(() => { measureDisplayScale(); scrollToMarks() })
    }
    im.src = reader.result
  }
  reader.readAsDataURL(f)
}

/* 把量測線捲進視野：直式照片在 max-height 限制下只顯示上半部，
   量測線落在中段的話使用者根本看不到，會以為工具壞了 */
function scrollToMarks() {
  const m = S.marks[S.mode]
  if (!m) return
  const box = $('frameBox')
  const r = cv.getBoundingClientRect()
  if (!r.width) return
  const k = r.width / cv.width
  const pts = Object.values(m)
  const ys = pts.map(p => p.y), xs = pts.map(p => p.x)
  const cy = (Math.min(...ys) + Math.max(...ys)) / 2
  const cx = (Math.min(...xs) + Math.max(...xs)) / 2
  box.scrollTop = Math.max(0, cy * k - box.clientHeight / 2)
  box.scrollLeft = Math.max(0, cx * k - box.clientWidth / 2)
}

/* 螢幕顯示比決定使用者實際能點多準，交給 checkResolution 判定 */
function measureDisplayScale() {
  if (!S.img[S.mode]) return
  const r = cv.getBoundingClientRect()
  if (r.width > 0) {
    const ds = r.width / cv.width
    if (Math.abs(ds - S.displayScale) > 1e-4) { S.displayScale = ds; render() }
  }
}

const toImg = e => {
  const r = cv.getBoundingClientRect()
  return { x: ((e.clientX - r.left) / r.width) * cv.width,
           y: ((e.clientY - r.top) / r.height) * cv.height } }

cv.addEventListener('pointerdown', e => {
  const m = S.marks[S.mode], src = S.img[S.mode]
  if (!m || !src) return
  const p = toImg(e)
  /* 抓取半徑取「螢幕 28px 換算」與「照片寬 3%」的較大值——
     displayScale 首次量測前為 1，否則第一下會抓不到 */
  const grab = Math.max(28 / Math.max(S.displayScale, .01), src.width * .03)
  let best = null, bd = Infinity
  for (const h of handlesFor(S.mode)) {
    const q = m[h.k]; if (!q) continue
    const d = Math.hypot(q.x - p.x, q.y - p.y)
    if (d < bd) { bd = d; best = h.k }
  }
  if (best && bd <= grab) {
    try { cv.setPointerCapture(e.pointerId) } catch (_) { /* 不支援也照樣能拖 */ }
    S.drag = best; S.sel = best
    drawLoupe(m[best]); render()
  }
})
cv.addEventListener('pointermove', e => {
  if (!S.drag) return
  const p = toImg(e)
  const h = handlesFor(S.mode).find(x => x.k === S.drag)
  const cur = S.marks[S.mode][S.drag]
  const np = h?.axis === 'x' ? { x: p.x, y: cur.y }
           : h?.axis === 'y' ? { x: cur.x, y: p.y } : p
  S.marks[S.mode][S.drag] = np
  drawLoupe(np); render()
})
const endDrag = () => { if (S.drag) { S.drag = null; drawLoupe(null); render() } }
cv.addEventListener('pointerup', endDrag)
cv.addEventListener('pointercancel', endDrag)

/* 方向鍵微調：拖到位後的精修手段 */
window.addEventListener('keydown', e => {
  if (!S.sel || !S.marks[S.mode]) return
  if (!document.getElementById('ff').contains(document.activeElement) && document.activeElement !== document.body) return
  const dir = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[e.key]
  if (!dir) return
  e.preventDefault()
  const step = e.shiftKey ? 5 : 1
  const h = handlesFor(S.mode).find(x => x.k === S.sel)
  const p = S.marks[S.mode][S.sel]
  const dx = h?.axis === 'y' ? 0 : dir[0], dy = h?.axis === 'x' ? 0 : dir[1]
  S.marks[S.mode][S.sel] = { x: p.x + dx * step, y: p.y + dy * step }
  render()
})

/* 委派事件 */
$('tabs').addEventListener('click', e => {
  const b = e.target.closest('button[data-m]'); if (!b) return
  S.mode = b.dataset.m; S.sel = null; render()
  requestAnimationFrame(() => { measureDisplayScale(); scrollToMarks() })
})
$('handleList').addEventListener('click', e => {
  const b = e.target.closest('button[data-k]'); if (!b) return
  S.sel = b.dataset.k; render()
})
$('file').addEventListener('change', e => e.target.files[0] && loadFile(e.target.files[0]))
$('file2').addEventListener('change', e => e.target.files[0] && loadFile(e.target.files[0]))
$('btnReset').addEventListener('click', () => {
  const src = S.img[S.mode]; if (!src) return
  S.marks[S.mode] = defaultMarks(S.mode, src.width, src.height); S.sel = null; render(); scrollToMarks()
})
document.querySelectorAll('.zoom').forEach(b => b.addEventListener('click', () => {
  S.zoom = +b.dataset.z
  document.querySelectorAll('.zoom').forEach(x => x.classList.toggle('on', x === b))
  cv.style.width = (100 * S.zoom) + '%'
  requestAnimationFrame(() => { measureDisplayScale(); scrollToMarks() })
}))
$('setCard').addEventListener('input', e => {
  const id = e.target.id
  if (id === 'setRuler') S.rulerMm = +e.target.value || 0
  else if (id === 'setB') { S.bValueMm = +e.target.value || 0; S.bAuto = false }
  else if (id === 'setScaleMode') S.sideScaleMode = e.target.value
  else if (id === 'setDisc') S.trialDiscMm = +e.target.value || 0
  else if (id === 'setWork') S.workMm = +e.target.value || 0
  else if (id === 'setTrialThick') S.trialThickness = +e.target.value || 0
  else if (id === 'setThick') S.lensThickness = +e.target.value || 0
  else if (id === 'setFacing') S.facing = e.target.value
  else if (id === 'setNose') S.noseUp = e.target.value === 'up'
  render()
})
$('setCard').addEventListener('change', e => {
  if (e.target.id === 'setFacing') { S.facing = e.target.value; render() }
  if (e.target.id === 'setScaleMode') { S.sideScaleMode = e.target.value; S.sel = null; render() }
  if (e.target.id === 'setTrialScale') { S.trialScaleMode = e.target.value; S.sel = null; render() }
  if (e.target.id === 'setFacing2') { S.facing = e.target.value; $('setFacing').value = e.target.value; render() }
  if (e.target.id === 'setNose') { S.noseUp = e.target.value === 'up'; render() }
})
/* 讓靜態表單的初始值與狀態一致（避免 HTML 預設值與 S 不同步） */
$('setRuler').value = S.rulerMm
$('setB').value = S.bValueMm
$('setThick').value = S.lensThickness
$('setFacing').value = S.facing
$('setNose').value = S.noseUp ? 'up' : 'down'
$('setScaleMode').value = S.sideScaleMode
/* 點「手動輸入」標示可改回沿用正面照 */
$('bSrc').addEventListener('click', () => { if (!S.bAuto) { S.bAuto = true; render() } })

/* 處方輸入 */
$('rxInputs').innerHTML = ['R', 'L'].map(e => `
  <div class="rxrow"><span class="eye">${e}</span>
    <label><span>球面 S</span><input type="number" step="0.25" data-e="${e}" data-f="sphere" value="0.00"></label>
    <label><span>散光 C</span><input type="number" step="0.25" data-e="${e}" data-f="cylinder" value="0.00"></label>
    <label><span>軸</span><input type="number" step="1" data-e="${e}" data-f="axis" value="180"></label>
  </div>`).join('')
$('rxInputs').addEventListener('input', e => {
  const t = e.target
  if (!t.dataset.e) return
  S.rx[t.dataset.e][t.dataset.f] = +t.value || 0
  render()
})
;['refVertex', 'lensIndex', 'applyPanto'].forEach(id => {
  $(id).addEventListener('input', render); $(id).addEventListener('change', render) })
/* 手動改驗光頂距就停止自動沿用試鏡架照；點標示可改回自動 */
$('refVertex').addEventListener('input', () => { S.refVertexAuto = false })
$('refVertexSrc').addEventListener('click', () => { if (!S.refVertexAuto) { S.refVertexAuto = true; render() } })
$('setTrialScale').value = S.trialScaleMode
$('setDisc').value = S.trialDiscMm
$('setTrialThick').value = S.trialThickness
$('setFacing2').value = S.facing
$('setWork').value = S.workMm

/* 複製結果 */
$('btnCopy').addEventListener('click', () => {
  const M = window.__M, res = window.__res
  const L = []
  const d = new Date()
  const pad = n => String(n).padStart(2, '0')
  L.push('※ 光學計算示意，非個人驗配結果，實際參數需由驗光人員現場量測')
  L.push(`【鏡框定位量測示意】${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`)
  L.push('')
  L.push('■ 定位參數')
  L.push(`前傾角　　${M.panto == null ? '—' : half(M.panto) + '°'}`)
  L.push(`頂點距離　${M.vertex == null ? '—' : half(M.vertex) + ' mm'}`)
  if (M.trialVertex != null) L.push(`試鏡架頂距　${half(M.trialVertex)} mm（驗光當下）`)
  if (M.ffDetail && M.ffDetail.asymmetry > 1)
    L.push(`面彎　　　右 ${half(M.ffDetail.right)}° ／ 左 ${half(M.ffDetail.left)}°（差 ${M.ffDetail.asymmetry.toFixed(1)}°）`)
  else
    L.push(`面彎　　　${M.faceForm == null ? '—' : half(M.faceForm) + '°'}`)
  if (M.near) {
    const N = M.near
    L.push('')
    L.push('■ 近用眼位（多焦用）')
    L.push(`近用 PD　　${N.pd.toFixed(1)} mm（右 ${N.rPd.toFixed(1)} ／ 左 ${N.lPd.toFixed(1)}）`)
    L.push(`近用瞳高　右 ${N.rHeight.toFixed(1)} ／ 左 ${N.lHeight.toFixed(1)} mm`)
    if (M.front) {
      L.push(`水平會聚　${(M.front.pd - N.pd).toFixed(1)} mm　工作距離 ${S.workMm} mm`)
      L.push(`垂直下移　右 ${(M.front.rHeight - N.rHeight).toFixed(1)} ／ 左 ${(M.front.lHeight - N.lHeight).toFixed(1)} mm　← 漸進走廊要對上的量`)
    }
  }
  if (M.front) {
    const F = M.front
    L.push('')
    L.push('■ 鏡框與眼位（Boxing）')
    L.push(`框標示　　${F.rA.toFixed(0)}□${F.dbl.toFixed(0)}`)
    L.push(`A 鏡片寬　右 ${F.rA.toFixed(1)} ／ 左 ${F.lA.toFixed(1)} mm`)
    L.push(`B 鏡片高　右 ${F.rB.toFixed(1)} ／ 左 ${F.lB.toFixed(1)} mm`)
    L.push(`DBL 鼻橋　${F.dbl.toFixed(1)} mm　FPD ${F.fpd.toFixed(1)} mm`)
    L.push(`PD 雙眼　　${F.pd.toFixed(1)} mm（右 ${F.rPd.toFixed(1)} ／ 左 ${F.lPd.toFixed(1)}）`)
    L.push(`瞳高　　　右 ${F.rHeight.toFixed(1)} ／ 左 ${F.lHeight.toFixed(1)} mm`)
    L.push(`偏心量　　右 ${F.rDecentration.toFixed(1)} ／ 左 ${F.lDecentration.toFixed(1)} mm`)
  }
  if (res) {
    L.push('')
    L.push('■ 有效度數示意')
    L.push(`輸入處方　R ${fmtRx(res.R.original)}　L ${fmtRx(res.L.original)}`)
    L.push(`示意值　　R ${fmtRx(res.R.finalRounded)}　L ${fmtRx(res.L.finalRounded)}`)
    L.push(`　差異　　R S${fmtD(res.R.delta.sphere)} C${fmtD(res.R.delta.cylinder)}　L S${fmtD(res.L.delta.sphere)} C${fmtD(res.L.delta.cylinder)}`)
    L.push(`光心下移估算 ${res.R.drop} mm（前傾角 × 0.5）`)
  }
  const errs = (M.msgs || []).filter(w => w.l === 'e')
  if (errs.length) {
    L.push('')
    L.push('■ 未解決的警示（數值可能不可靠）')
    errs.forEach(w => L.push('・' + w.m))
  }
  const txt = L.join('\n')
  const ta = $('copyOut')
  ta.hidden = false; ta.value = txt
  ta.select()
  navigator.clipboard?.writeText(txt).then(
    () => { $('btnCopy').textContent = '✓ 已複製到剪貼簿'; setTimeout(() => $('btnCopy').textContent = '產生可複製的量測結果', 1800) },
    () => { $('btnCopy').textContent = '請手動複製下方文字'; setTimeout(() => $('btnCopy').textContent = '產生可複製的量測結果', 2200) })
})

$('btnClearAll').addEventListener('click', () => {
  S.img = { front: null, side: null, top: null }
  S.marks = { front: null, side: null, top: null }
  S.sel = null; S.drag = null; S.zoom = 1
  cv.style.width = '100%'
  document.querySelectorAll('.zoom').forEach((x, i) => x.classList.toggle('on', i === 0))
  $('copyOut').hidden = true
  render()
})

window.addEventListener('resize', measureDisplayScale)
cv.style.width = '100%'
render()
</script>

</Layout>
