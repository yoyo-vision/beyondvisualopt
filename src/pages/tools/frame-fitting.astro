<script is:inline>
/* ════════════════════════════════════════════════════════════════
   1. 計算核心
   公式與門市內部系統相同（該處有單元測試）。官網版僅供光學計算示意。
   ════════════════════════════════════════════════════════════════ */
const D = d => d * Math.PI / 180
const RAD = r => r * 180 / Math.PI
const dist = (a, b) => Math.hypot(b.x - a.x, b.y - a.y)
const q4 = v => Math.round(v * 4) / 4          /* 0.25 檔位 */
const half = v => Math.round(v * 2) / 2        /* 0.5 檔位 */
const normAxis = a => { let x = a % 180; if (x <= 0) x += 180; return x }

/* ── 1a. 處方補償：頂點距離 ＋ Martin's Rule of Tilt ── */
const toPV = rx => { const a = D(rx.axis); return {
  M: rx.sphere + rx.cylinder / 2,
  J0: -(rx.cylinder / 2) * Math.cos(2 * a),
  J45: -(rx.cylinder / 2) * Math.sin(2 * a) } }

const fromPV = pv => {
  const cylinder = -2 * Math.hypot(pv.J0, pv.J45)
  let axis = 180
  if (Math.abs(cylinder) > 1e-9) {
    axis = RAD(Math.atan2(pv.J45, pv.J0)) / 2
    if (axis < 0) axis += 180
    if (axis === 0) axis = 180
  }
  return { sphere: pv.M - cylinder / 2, cylinder, axis } }

/* 有效度數 F' = F / (1 + Δd·F)，Δd 為往外移的距離（公尺）。
   方向（2026-08-09 修正符號，原本寫反）：往外移 → 近視加深、遠視變淺。
   自我檢查用臨床常識：-10.00D 框架(12mm) → 隱形眼鏡(0mm) 應得 -8.93D；
   +10.00D 框架 → 隱形眼鏡應得 +11.36D。 */
const vtxPower = (F, from, to) => {
  if (!F) return 0
  const den = 1 + ((to - from) / 1000) * F
  return Math.abs(den) < 1e-9 ? F : F / den }

const compVertex = (rx, from, to) => {
  if (from === to) return { ...rx }
  const s = vtxPower(rx.sphere, from, to)
  const sc = vtxPower(rx.sphere + rx.cylinder, from, to)
  return { sphere: s, cylinder: sc - s, axis: rx.axis } }

/* 傾斜：沿傾斜軸 ×(1+sin²θ/2n)，垂直方向再 ÷cos²θ。
   orient 180＝前傾（繞水平軸），90＝面彎（繞垂直軸）。
   J45（斜軸柱面成分）不受 90/180 軸傾斜影響。 */
const compTilt = (rx, theta, n, orient) => {
  if (!theta) return { ...rx }
  const pv = toPV(rx), f180 = pv.M + pv.J0, f90 = pv.M - pv.J0
  const t = D(theta), k = 1 + Math.sin(t) ** 2 / (2 * n), c2 = Math.cos(t) ** 2
  let n180, n90
  if (orient === 180) { n180 = f180 * k; n90 = f90 * k / c2 }
  else { n90 = f90 * k; n180 = f180 * k / c2 }
  return fromPV({ M: (n180 + n90) / 2, J0: (n180 - n90) / 2, J45: pv.J45 }) }

function calcFitting(rx, p) {
  const original = { ...rx, axis: normAxis(rx.axis) }
  const afterVertex = compVertex(original, p.refVertex, p.vertex)
  const afterPanto = p.applyPantoscopic ? compTilt(afterVertex, p.pantoscopic, p.index, 180) : { ...afterVertex }
  const final = compTilt(afterPanto, p.faceForm, p.index, 90)
  const fr = { sphere: q4(final.sphere), cylinder: q4(final.cylinder), axis: normAxis(Math.round(final.axis)) }
  const raw = Math.abs(fr.axis - original.axis) % 180
  const axisDiff = Math.min(raw, 180 - raw)
  const delta = {
    sphere: fr.sphere - original.sphere,
    cylinder: fr.cylinder - original.cylinder,
    axis: axisDiff,
    se: (fr.sphere + fr.cylinder / 2) - (original.sphere + original.cylinder / 2),
  }
  const cylOK = Math.abs(fr.cylinder) >= 0.25
  return { original, afterVertex, afterPanto, final, finalRounded: fr, delta,
    drop: Math.round(p.pantoscopic * 0.5 * 10) / 10,
    significant: Math.abs(delta.sphere) >= 0.25 || Math.abs(delta.cylinder) >= 0.25 || (cylOK && axisDiff >= 5) } }

/* ── 1b. 照片量測 ── */
/* 前傾角：鏡片線與垂直線夾角，下緣往臉靠近為正。角度不需尺度基準。 */
function pantoFromMarks(m) {
  const dx = m.lensBottom.x - m.lensTop.x, dy = m.lensBottom.y - m.lensTop.y
  if (Math.abs(dy) < 1e-9) return 0
  const toward = m.facing === 'right' ? -dx : dx
  return RAD(Math.atan2(toward, Math.abs(dy))) }

/* 頂點距離量在「角膜高度」上，不是鏡片線段中點 */
function lensXAtCornea(m) {
  const dy = m.lensBottom.y - m.lensTop.y
  if (Math.abs(dy) < 1e-9) return (m.lensTop.x + m.lensBottom.x) / 2
  const t = (m.corneaApex.y - m.lensTop.y) / dy
  return m.lensTop.x + t * (m.lensBottom.x - m.lensTop.x) }

const vertexFromMarks = (m, pxmm, thick = 0) =>
  Math.abs(lensXAtCornea(m) - m.corneaApex.x) / pxmm - thick

/* 面彎：兩眼共用同一條法向量，否則右眼會算出反號。
   noseUp 決定「往臉後方」是哪一側——俯視照可能鼻子朝上也可能朝下
   （眼鏡平放拍時，鏡腿往哪邊就是後方）。方向搞錯整個符號會翻。 */
function faceFormFromMarks(m, noseUp = true) {
  const bx = m.lInner.x - m.rInner.x, by = m.lInner.y - m.rInner.y
  const bLen = Math.hypot(bx, by)
  if (bLen < 1e-9) return { right: 0, left: 0, mean: 0, asymmetry: 0 }
  let nx = -by, ny = bx
  if (ny < 0) { nx = by; ny = -bx }
  if (!noseUp) { nx = -nx; ny = -ny }
  const ang = (inner, outer, dx, dy) => {
    const vx = outer.x - inner.x, vy = outer.y - inner.y
    const along = (vx * dx + vy * dy) / bLen
    const perp = (vx * nx + vy * ny) / bLen
    return RAD(Math.atan2(perp, Math.abs(along))) }
  const right = ang(m.rInner, m.rOuter, -bx, -by)
  const left = ang(m.lInner, m.lOuter, bx, by)
  return { right, left, mean: (right + left) / 2, asymmetry: Math.abs(right - left) } }

/* 正面照 boxing：A＝外接矩形寬、B＝高、DBL＝兩矩形間距。
   單眼 PD 與偏心量以「鏡框中線」為基準——訂片要的是瞳孔相對鏡框的位置。 */
function frontFromMarks(m, pxmm) {
  const mm = px => px / pxmm
  const rA = mm(Math.abs(m.rBoxBR.x - m.rBoxTL.x)), lA = mm(Math.abs(m.lBoxBR.x - m.lBoxTL.x))
  const rB = mm(Math.abs(m.rBoxBR.y - m.rBoxTL.y)), lB = mm(Math.abs(m.lBoxBR.y - m.lBoxTL.y))
  const rIn = Math.max(m.rBoxTL.x, m.rBoxBR.x), lIn = Math.min(m.lBoxTL.x, m.lBoxBR.x)
  const dbl = mm(lIn - rIn)
  const mid = (rIn + lIn) / 2
  const rPd = mm(Math.abs(mid - m.rPupil.x)), lPd = mm(Math.abs(m.lPupil.x - mid))
  const pd = mm(Math.abs(m.lPupil.x - m.rPupil.x))
  const fpd = (rA + lA) / 2 + dbl
  const rBot = Math.max(m.rBoxTL.y, m.rBoxBR.y), lBot = Math.max(m.lBoxTL.y, m.lBoxBR.y)
  return { rA, lA, rB, lB, dbl, pd, rPd, lPd, fpd,
    rHeight: mm(rBot - m.rPupil.y), lHeight: mm(lBot - m.lPupil.y),
    rDecentration: fpd / 2 - rPd, lDecentration: fpd / 2 - lPd } }

/* 近用眼位：看近時兩眼會聚，瞳距比遠用小。中線一樣取兩框內緣中點，
   與遠用同基準才能直接相減得出會聚量。 */
function nearFromMarks(m, pxmm) {
  const mm = px => px / pxmm
  const mid = (m.rInner.x + m.lInner.x) / 2
  return {
    pd: mm(Math.abs(m.lPupil.x - m.rPupil.x)),
    rPd: mm(Math.abs(mid - m.rPupil.x)),
    lPd: mm(Math.abs(m.lPupil.x - mid)),
    /* 近用瞳高：看近時瞳孔到鏡片下緣。與遠用瞳高相減即眼位的垂直下移量，
       那才是漸進片走廊長度要對上的東西 */
    rHeight: mm(m.rBottom.y - m.rPupil.y),
    lHeight: mm(m.lBottom.y - m.lPupil.y),
  } }

/* 近用瞳距的理論值：farPd × d / (d + 27)，27mm 為角膜頂點到眼球旋轉中心的
   概略距離。實測與理論差太多通常是標點或工作距離填錯，拿來對照用。 */
function nearPdTheory(farPd, workMm) {
  return workMm > 0 ? farPd * workMm / (workMm + 27) : null }

function checkNear(n, far, workMm) {
  const w = []
  if (n.pd < 40 || n.pd > 78)
    w.push({ l: 'e', m: `近用 PD 算出 ${n.pd.toFixed(1)}mm，超出人類範圍，請確認比例尺與瞳孔標點` })
  if (far) {
    const conv = far.pd - n.pd
    if (conv < -0.5)
      w.push({ l: 'e', m: `近用 PD 比遠用大 ${(-conv).toFixed(1)}mm，看近不可能比看遠寬，請確認標點` })
    else if (conv > 8)
      w.push({ l: 'w', m: `會聚量 ${conv.toFixed(1)}mm 偏大（常見 3–5mm），請確認工作距離與標點` })
    const th = nearPdTheory(far.pd, workMm)
    if (th != null && Math.abs(th - n.pd) > 3)
      w.push({ l: 'w', m: `實測近用 PD ${n.pd.toFixed(1)}mm 與理論值 ${th.toFixed(1)}mm 差 ${Math.abs(th - n.pd).toFixed(1)}mm，確認工作距離是否為 ${workMm}mm` })
  }
  const d = Math.abs(n.rPd - n.lPd)
  if (d > 3) w.push({ l: 'w', m: `近用左右單眼差 ${d.toFixed(1)}mm，若確認標點無誤代表看近時明顯偏向一側` })

  /* 垂直向：看近時眼球下轉，瞳孔在鏡片上的位置一定往下走 */
  if (far) {
    const dropR = far.rHeight - n.rHeight, dropL = far.lHeight - n.lHeight
    for (const [eye, dr] of [['右', dropR], ['左', dropL]]) {
      if (dr < -0.5)
        w.push({ l: 'e', m: `${eye}眼近用瞳高比遠用高 ${(-dr).toFixed(1)}mm，看近眼位應往下走，請確認框下緣與瞳孔標點` })
      else if (dr > 9)
        w.push({ l: 'w', m: `${eye}眼垂直下移 ${dr.toFixed(1)}mm 偏大（常見 3–6mm），確認拍攝時頭沒有過度低下` })
    }
    if (Math.abs(dropR - dropL) > 2)
      w.push({ l: 'w', m: `左右垂直下移差 ${Math.abs(dropR - dropL).toFixed(1)}mm，實際配鏡需由驗光人員分眼確認` })
  }
  return w }

/* ── 1c. 拍攝品質檢查 ──
   單目照片的誤差幾乎全來自拍攝角度與解析度，這關比演算法更決定準度。 */
const MIN_PXMM = 4, GOOD_PXMM = 7
function checkResolution(screenPxmm) {
  const err = (2.8 / screenPxmm).toFixed(2)
  if (screenPxmm < MIN_PXMM) return [{ l: 'e',
    m: `畫面上只有 ${screenPxmm.toFixed(1)} px/mm，換算誤差約 ±${err}mm。請把鏡框拍滿畫面，或按放大再拖` }]
  if (screenPxmm < GOOD_PXMM) return [{ l: 'w',
    m: `畫面 ${screenPxmm.toFixed(1)} px/mm，誤差約 ±${err}mm；拍近一點或放大可降到 ±0.2mm` }]
  return [] }

function checkRuler(p1, p2, lenMm) {
  const px = dist(p1, p2), w = []
  if (px < 60) w.push({ l: 'e', m: `比例尺在照片中只有 ${Math.round(px)}px，誤差超過 3%，請拍近一點或用更長的尺` })
  else if (px < 120) w.push({ l: 'w', m: `比例尺 ${Math.round(px)}px（誤差約 ${(200 / px).toFixed(1)}%）；拍近一點可再降一半` })
  if (lenMm < 15) w.push({ l: 'w', m: `比例尺只有 ${lenMm}mm，建議改用 20–30mm，準度直接翻倍` })
  return w }

function checkSide(m, bMm, pxmm) {
  const w = []
  const segMm = dist(m.lensTop, m.lensBottom) / pxmm
  const ratio = segMm / bMm
  if (ratio < 0.9) w.push({ l: 'e', m: `鏡片在照片中比實際短 ${Math.round((1 - ratio) * 100)}%，相機沒有正對側面，請重拍` })
  else if (ratio < 0.96) w.push({ l: 'w', m: '相機略偏離正側面，頂點距離可能高估' })
  const lx = lensXAtCornea(m)
  const behind = m.facing === 'right' ? m.corneaApex.x < lx : m.corneaApex.x > lx
  if (!behind) w.push({ l: 'e', m: '角膜頂點標在鏡片前方，請確認標點與「臉朝」設定' })
  return w }

function checkTop(r) {
  const w = []
  if (r.asymmetry > 6) w.push({ l: 'e', m: `左右面彎差 ${r.asymmetry.toFixed(1)}°，相機沒對準頭部正中或框歪了，請重拍` })
  else if (r.asymmetry > 3) w.push({ l: 'w', m: `左右面彎差 ${r.asymmetry.toFixed(1)}°，若相機確實對正，代表這副框左右不對稱` })
  if (r.mean < -3) w.push({ l: 'e', m: '面彎為負（鏡片往前張開），請確認內外緣沒標反' })
  return w }

function checkFront(r, m, pxmm) {
  const w = []
  const tilt = Math.abs(Math.max(m.rBoxTL.y, m.rBoxBR.y) - Math.max(m.lBoxTL.y, m.lBoxBR.y)) / pxmm
  if (tilt > 3) w.push({ l: 'e', m: `左右鏡片下緣高低差 ${tilt.toFixed(1)}mm，頭或框歪了，請坐正重拍` })
  else if (tilt > 1.5) w.push({ l: 'w', m: `左右下緣高低差 ${tilt.toFixed(1)}mm，若頭是正的，代表這副框可能需要調整` })
  if (Math.abs(r.rA - r.lA) > 1.5) w.push({ l: 'w', m: `左右 A 值差 ${Math.abs(r.rA - r.lA).toFixed(1)}mm，同副框應相同，請確認框線` })
  if (r.pd < 48 || r.pd > 80) w.push({ l: 'e', m: `PD 算出 ${r.pd.toFixed(1)}mm，超出人類範圍，請確認比例尺與瞳孔點` })
  if (r.rA < 38 || r.rA > 65) w.push({ l: 'w', m: `A 值 ${r.rA.toFixed(1)}mm 偏離常見的 45–58mm` })
  if (r.dbl < 10 || r.dbl > 26) w.push({ l: 'w', m: `DBL ${r.dbl.toFixed(1)}mm 偏離常見的 14–22mm` })
  if (r.rHeight < 8 || r.lHeight < 8) w.push({ l: 'w', m: '瞳高不足 8mm，漸進片可能裝不下' })
  if (Math.abs(r.rHeight - r.lHeight) > 2)
    w.push({ l: 'w', m: `左右瞳高差 ${Math.abs(r.rHeight - r.lHeight).toFixed(1)}mm，實際配鏡需由驗光人員分眼確認` })
  return w }

function validateFit(p) {
  const w = []
  if (p.vertex != null) {
    if (p.vertex < 5 || p.vertex > 25) w.push({ l: 'e', m: '頂點距離超出 5–25mm，請確認' })
    else if (p.vertex < 8 || p.vertex > 18) w.push({ l: 'w', m: '頂點距離偏離常見的 10–16mm' })
  }
  if (p.pantoscopic != null && (p.pantoscopic < 4 || p.pantoscopic > 18))
    w.push({ l: 'w', m: '前傾角偏離常見的 8–12°，鏡框可能需要調整，可請驗光人員協助' })
  if (p.faceForm != null && p.faceForm > 15)
    w.push({ l: 'w', m: '面彎偏大，運動框以外少見' })
  return w }

/* ════════════════════════════════════════════════════════════════
   2. 量測把手定義
   ════════════════════════════════════════════════════════════════ */
/* 官網版不含試鏡架模式（需門市設備） */
const MODES = ['front', 'near', 'side', 'top']
