---
// 鏡框定位示意工具（2026-10-03 從 YOYO-agent/tools/frame-fitting 內部工具改寫為對外版）
// 計算核心與門市內部版相同；官網版拿掉試鏡架模式與個人化鏡片訂片提示（屬門市作業），
// 處方區改為「有效度數示意」。照片只在瀏覽器內處理，不上傳。
// ⚠️ 工具 CSS 一律掛在 .ff 底下（is:global 但有前綴），JS 用 is:inline——
//    因為大量 DOM 由 innerHTML 產生，Astro 的 scoped style 套不到。
// ⚠️ 讀圖必須用 FileReader → data: URL：public/_headers 的 CSP img-src 沒放行 blob:。
import Layout from '../../layouts/Layout.astro';

const canonicalUrl = 'https://beyondvisualopt.com/tools/frame-fitting/';
const DISCLAIMER = '光學計算示意，非個人驗配結果，實際參數需由驗光人員現場量測';

// 頁面 FAQ（自動化為 FAQPage schema）
const faqs = [
  {
    q: '這個工具量出來的數字，可以直接拿去配眼鏡嗎？',
    a: '不行。這是光學計算示意，非個人驗配結果。照片的拍攝角度、解析度、鏡框當下有沒有戴正，都會讓數字偏掉好幾毫米或好幾度；而且鏡框在配鏡時通常還會再調整鼻墊與鏡腳，調整後的前傾角與頂點距離跟照片裡不一樣。實際配鏡參數需由驗光人員現場量測，並依你的度數、用眼習慣與鏡框條件一起判斷。',
  },
  {
    q: '前傾角多少算常見？',
    a: '一般框架眼鏡的前傾角常落在 8 到 12 度之間，也就是鏡片下緣比上緣稍微靠近臉頰。但這不是越接近某個數字越好，而是要和鏡片光學中心的高度互相配合：前傾角每 1 度，光學中心通常要往下放約 0.5mm，視線才會從光學中心附近穿過。前傾角太小或太大，都可能讓視線偏離光學中心，這也是驗光人員調整鏡框時會一併確認的項目。',
  },
  {
    q: '頂點距離是什麼？為什麼度數越高越要在意？',
    a: '頂點距離是鏡片後表面到角膜前頂點的距離，一般框架眼鏡常見在 10 到 16mm。驗光時的度數是在某個頂點距離下量出來的，眼鏡實際戴的位置如果更遠或更近，到達眼睛的有效度數就會改變。低度數時差異很小，但度數越高越敏感：以 -10.00D 為例，鏡片從 12mm 移到貼著角膜（0mm），有效度數會變成約 -8.93D。所以高度數族群配鏡時，頂點距離是需要被量、被記錄的參數。',
  },
  {
    q: '照片會被上傳到網路上嗎？',
    a: '不會。這個工具所有計算都在你自己的瀏覽器裡完成，照片不會傳送到能見度或任何第三方的伺服器。關掉或重新整理頁面，照片和數字就會一起消失。',
  },
  {
    q: '多焦點鏡片為什麼要量瞳高和看近時的眼位？',
    a: '多焦點（漸進）鏡片從上到下有遠用區、中間的過渡區與下方的近用區。瞳高決定遠用區放在哪裡，看近時眼睛往下轉、往內收的幅度，決定視線會不會剛好落進近用區。瞳高太低的鏡框，可能放不下完整的過渡區；看近的眼位沒對上，閱讀時就得刻意抬下巴或低頭找角度。這些都是驗光人員在選框與下單前，會實際量測與評估的項目。',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonicalUrl}#app`,
      "url": canonicalUrl,
      "name": "鏡框定位示意工具",
      "description": "上傳戴眼鏡的照片，拖曳標點計算前傾角、頂點距離、面彎、瞳距與瞳高，並以光學公式示意配戴位置對有效度數的影響。光學計算示意，非個人驗配結果。",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web browser",
      "inLanguage": "zh-TW",
      "author": {
        "@type": "Person",
        "@id": "https://beyondvisualopt.com/author/yoyo/#person",
        "name": "鄭家侑（YoYo）",
        "url": "https://beyondvisualopt.com/author/yoyo/"
      },
      "publisher": { "@id": "https://beyondvisualopt.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
  ],
};
---
<Layout
  title="眼鏡戴的角度與距離，會讓度數變多少？鏡框定位示意工具"
  description="上傳戴眼鏡的照片，拖曳標點就能看到前傾角、頂點距離、面彎、瞳距與瞳高，並了解配戴位置如何影響有效度數。光學計算示意，非個人驗配結果。能見度視覺中心 新莊、板橋。"
  schema={schema}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-[#0f1e33] text-white py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-gold font-sans font-semibold tracking-widest uppercase mb-5" style="font-size:13px;letter-spacing:0.2em">互動工具</p>
      <h1 class="font-serif text-white leading-tight mb-7" style="font-size:clamp(30px,4.5vw,52px);font-weight:300">
        同一張處方，戴的位置不同<br /><span class="text-brand-gold">看出去就不一樣</span>
      </h1>
      <p class="text-white/70 max-w-2xl mx-auto" style="font-size:18px;line-height:1.85">
        眼鏡在臉上往前傾幾度、離眼睛幾毫米、鏡面彎多少，都會改變視線穿過鏡片的位置與到達眼睛的有效度數。這個鏡框定位示意工具，讓你用一張照片親手量量看，理解配鏡時驗光人員在量什麼、為什麼要量。
      </p>
    </div>
  </section>

  <!-- 顯眼聲明 -->
  <section class="px-6 md:px-16 py-8" style="background:#eee8da">
    <div class="max-w-4xl mx-auto border-2 border-brand-gold bg-white rounded-2xl px-6 py-5" role="note">
      <p class="font-serif text-brand-navy" style="font-size:18px;font-weight:600;line-height:1.6">{DISCLAIMER}</p>
      <p class="text-brand-ink-2 mt-2" style="font-size:15px;line-height:1.8">本工具不是視力檢查，也不能取代配鏡前的驗光與鏡框調整。照片只在你的瀏覽器裡計算，不會上傳到任何伺服器。</p>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="px-6 py-10 border-b border-brand-ink/8" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-3 justify-center">
      {[
        { label: '怎麼用', href: '#how' },
        { label: '動手量量看', href: '#tool' },
        { label: '四個定位參數', href: '#params' },
        { label: '角度怎麼影響度數', href: '#physics' },
        { label: '常見問題', href: '#faq' },
      ].map(item => (
        <a href={item.href} class="font-sans bg-white border border-brand-ink/10 text-brand-ink-2 px-4 py-2 rounded-full hover:border-brand-gold hover:text-brand-gold transition-colors" style="font-size:13px">{item.label}</a>
      ))}
    </div>
  </section>

  <!-- 怎麼用 -->
  <section id="how" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">準備一張照片、一把尺，三步驟就能開始</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          ['① 選照片類型', '上方分頁有正面照、近用照、側面照、俯視照四種。正面照量瞳距與瞳高，側面照量前傾角與頂點距離，俯視照量鏡面彎度，近用照看看近時眼位怎麼移動。'],
          ['② 拖圓圈對位', '照片載入後，把彩色圓圈拖到鏡框邊緣、瞳孔中心或角膜頂點。手機上按住圓圈時右上角會出現放大鏡，選取後也能用方向鍵微調。'],
          ['③ 看數字變化', '右側會即時算出定位參數。輸入一組處方數值，就能看到在這個配戴位置下，有效度數大約會怎麼偏移。'],
        ].map(([t, d]) => (
          <div class="bg-white border border-brand-ink/8 rounded-2xl p-6">
            <h3 class="font-serif text-brand-navy mb-2" style="font-size:17px;font-weight:600">{t}</h3>
            <p class="text-brand-ink-2" style="font-size:15px;line-height:1.75">{d}</p>
          </div>
        ))}
      </div>
      <blockquote class="border-l-2 border-brand-gold pl-5 text-brand-ink-3 mt-8" style="font-size:16px;line-height:1.8">
        拍攝小提醒：相機要和眼睛同高、正對拍攝方向。正面照與近用照需要在鏡框旁放一把尺或已知長度的物品當比例尺；側面照可以沿用正面照量到的鏡片高度換算；俯視照量的是角度，不需要比例尺。
      </blockquote>
    </div>
  </section>

  <!-- 工具本體 -->
  <section id="tool" class="px-3 md:px-10 py-16 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-3 px-3" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">動手量量看</h2>
      <p class="text-brand-navy font-semibold mb-6 px-3" style="font-size:15px;line-height:1.7">※ {DISCLAIMER}</p>
      <div class="ff" id="ff"><div class="wrap">
<div class="cols">
  <!-- ═══ 左欄：照片與量測 ═══ -->
  <div>
    <div class="tabs" id="tabs"></div>

    <div class="card" style="padding:12px">
      <div id="dropWrap">
        <label class="drop" id="drop">
          <span class="big">📷</span>
          <span class="t" id="dropTitle">拍／選一張照片</span>
          <span class="h" id="dropHint"></span>
          <input type="file" accept="image/*" id="file" hidden>
        </label>
      </div>

      <div id="stageWrap" hidden>
        <div class="stage">
          <div class="frame" id="frameBox">
            <canvas id="cv"></canvas>
          </div>
          <canvas id="loupe" width="132" height="132"></canvas>
        </div>
        <div class="bar">
          <span class="hintline">✥ 直接拖圓圈</span>
          <button class="mini" id="btnReset">回預設位置</button>
          <div class="zoomset">
            <span>放大</span>
            <button class="mini zoom on" data-z="1">1×</button>
            <button class="mini zoom" data-z="2">2×</button>
            <button class="mini zoom" data-z="3">3×</button>
          </div>
          <label class="mini" style="margin-left:auto">換照片
            <input type="file" accept="image/*" id="file2" hidden>
          </label>
        </div>
        <p class="hintline" id="selHint" style="margin:5px 0 0"></p>
      </div>
    </div>

    <div class="card">
      <h3>處方數值（看配戴位置對度數的影響）</h3>
      <div id="rxInputs"></div>
      <div class="row" style="margin-top:9px">
        <span>驗光當下的頂點距離<span class="sub" id="refVertexSrc"></span></span>
        <span><input type="number" id="refVertex" step="0.5" value="12"> mm</span>
      </div>
      <div class="row">
        <span>鏡片折射率</span>
        <select id="lensIndex">
          <option>1.50</option><option>1.56</option><option selected>1.60</option>
          <option>1.67</option><option>1.74</option>
        </select>
      </div>
      <label class="chk" style="margin-top:7px">
        <input type="checkbox" id="applyPanto" checked>
        <span>套用前傾補償
          <span class="sub">光心已依「前傾角 × 0.5mm」下移時請取消勾選，視線通過光心就不需補償</span>
        </span>
      </label>
    </div>
  </div>

  <!-- ═══ 右欄：數值 ═══ -->
  <div>
    <div class="headline">
      <div class="lab">量出來的定位參數</div>
      <dl style="margin:0" id="mainVals"></dl>
      <div id="ffDetail"></div>
    </div>

    <div class="card" id="frontCard" hidden>
      <h3>正面照數據（Boxing）</h3>
      <table class="num" id="frontTable"></table>
      <div class="inline3" id="frontInline"></div>
      <div class="framecode" id="frameCode"></div>
    </div>

    <div class="card" id="nearCard" hidden>
      <h3>近用眼位（多焦點相關）</h3>
      <table class="num" id="nearTable"></table>
      <div class="inline3" id="nearInline"></div>
      <div class="framecode" id="nearCorridor" style="margin-top:7px;line-height:1.6"></div>
    </div>

    <div class="card" id="handlesCard" hidden>
      <h3 id="handlesTitle">把圈拖到位</h3>
      <ol class="handles" id="handleList"></ol>
    </div>

    <div class="card" id="setCard">
      <h3>量測設定</h3>
      <div class="row" id="rowRuler">
        <span>比例尺長度</span>
        <span><input type="number" id="setRuler" step="1" value="30"> mm</span>
      </div>
      <div id="setSideOnly" hidden>
        <div class="row"><span>尺度基準</span>
          <select id="setScaleMode">
            <option value="frameB">鏡框 B 值（正面照帶入）</option>
            <option value="ruler">照片上的比例尺</option>
          </select>
        </div>
        <div class="row"><span>臉朝</span>
          <select id="setFacing"><option value="right">朝右</option><option value="left">朝左</option></select>
        </div>
        <div class="row"><span>鏡框 B 值<span class="sub" id="bSrc"></span></span>
          <span><input type="number" id="setB" step="0.5" value="32"> mm</span></div>
        <div class="row"><span>鏡片中心厚度<span class="sub">標後表面就填 0</span></span>
          <span><input type="number" id="setThick" step="0.1" value="0"> mm</span></div>
      </div>
      <div id="setNearOnly" hidden>
        <div class="row"><span>工作距離<span class="sub">平常習慣的閱讀距離</span></span>
          <span><input type="number" id="setWork" step="10" value="400"> mm</span></div>
      </div>
      <div id="setTrialOnly" hidden>
        <div class="row"><span>尺度基準</span>
          <select id="setTrialScale">
            <option value="disc">試片直徑（標準 38mm）</option>
            <option value="ruler">照片上的比例尺</option>
          </select>
        </div>
        <div class="row"><span>試片直徑<span class="sub">多數試片組 38mm</span></span>
          <span><input type="number" id="setDisc" step="1" value="38"> mm</span></div>
        <div class="row"><span>臉朝</span>
          <select id="setFacing2"><option value="right">朝右</option><option value="left">朝左</option></select>
        </div>
        <div class="row"><span>試片中心厚度<span class="sub">標後表面就填 0</span></span>
          <span><input type="number" id="setTrialThick" step="0.1" value="0"> mm</span></div>
      </div>
      <div id="setTopOnly" hidden>
        <div class="row"><span>鼻子朝<span class="sub">鏡腿往哪邊就是臉的後方</span></span>
          <select id="setNose"><option value="down">畫面下方</option><option value="up">畫面上方</option></select>
        </div>
      </div>
      <p class="note" id="setNote"></p>
    </div>

    <div id="msgs"></div>

    <div class="card" id="rxCard" hidden>
      <h3>考慮配戴位置後的有效度數（示意）</h3>
      <div class="rxout" id="rxOut"></div>
      <div class="oc" id="ocDrop"></div>
          </div>

    <button class="primary" id="btnCopy">產生可複製的量測結果</button>
    <button class="ghost" id="btnClearAll">全部清空重來</button>
    <textarea id="copyOut" hidden readonly></textarea>
  </div>
</div>
<div class="ff-foot">
  {DISCLAIMER}。<br>
  以上數值為光學公式的示意計算，準度取決於拍攝角度與影像解析度，非視力檢查或醫療診斷結果，也不能作為訂製鏡片的依據。
</div>
      </div></div>
    </div>
  </section>

  <!-- 四個定位參數 -->
  <section id="params" class="px-6 md:px-16 py-20" style="background:#f7f3ec">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-brand-ink mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:400">眼鏡戴在臉上，有四組數字在決定視線怎麼穿過鏡片</h2>
      <div class="space-y-5 text-brand-ink-2 mb-8" style="font-size:17px;line-height:1.85">
        <p>驗光量出來的是「眼睛需要多少度數」，但鏡片做好之後，它戴在臉上的位置，才決定這組度數能不能準確地送到眼睛。我在門市常遇到的情況是：處方明明沒變，換了一副鏡框卻覺得怪怪的。追下去，往往不是度數錯，而是下面這幾個數字變了。</p>
      </div>
      <div class="space-y-4">
        {[
          ['前傾角（Pantoscopic Tilt）', '從側面看，鏡片下緣往臉頰方向傾斜的角度，常見 8–12 度。前傾讓往下看的視線也能大致垂直穿過鏡片，但光學中心的高度要跟著配合，前傾角每 1 度約下移 0.5mm。'],
          ['頂點距離（Vertex Distance）', '鏡片後表面到角膜頂點的距離，常見 10–16mm。驗光的度數是在某個距離下量的，眼鏡戴得更遠或更近，有效度數就會偏移，度數越高越明顯。'],
          ['面彎（Face Form / Wrap）', '從頭頂往下看，鏡片沿著臉型往後包的角度。一般光學框多在 0–7 度，運動框可能更大。面彎和前傾一樣會讓鏡片傾斜，產生額外的度數變化。'],
          ['瞳距與瞳高（PD / Fitting Height）', '瞳距是兩眼瞳孔中心的水平距離，單眼瞳距以鏡框中線為基準；瞳高是瞳孔中心到鏡片下緣的垂直距離。兩者決定光學中心放在哪裡，多焦點鏡片還要靠瞳高安排遠、中、近的區域。'],
        ].map(([t, d]) => (
          <div class="bg-white border border-brand-ink/8 rounded-2xl p-7">
            <h3 class="font-serif text-brand-navy mb-2" style="font-size:18px;font-weight:600">{t}</h3>
            <p class="text-brand-ink-2" style="font-size:16px;line-height:1.8">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 角度怎麼影響度數 -->
  <section id="physics" class="px-6 md:px-16 py-20" style="background:#1a2f4e">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-serif text-white mb-8" style="font-size:clamp(24px,3.5vw,36px);font-weight:300">為什麼鏡片斜了幾度，度數就會跑掉</h2>
      <div class="space-y-5 text-white/75" style="font-size:17px;line-height:1.85">
        <p>鏡片是照「視線垂直穿過」的條件設計的。當鏡片傾斜，視線就斜斜地穿過它，光學上會出現兩件事：整體度數稍微變強，同時多出一點原本處方裡沒有的散光。這個關係在光學上稱為 Martin 傾斜法則，工具裡的有效度數示意就是用它計算。</p>
        <p>以一般近視 -4.00D 的鏡片為例，前傾 10 度時，垂直方向的有效度數約多出 0.1～0.2D，多數人感覺不太出來；但到了 -8.00D、前傾 15 度，差異就可能超過 0.5D，戴起來會覺得某個方向不夠清楚或不太舒服。頂點距離也是同樣的道理：-10.00D 的框架眼鏡在 12mm 的位置，換算到貼著角膜時只剩約 -8.93D。</p>
